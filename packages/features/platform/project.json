{
  "name": "features-platform",
  "root": "packages/features/platform",
  "sourceRoot": "packages/features/platform/src",
  "projectType": "library",
  "tags": [
    "scope:frontend",
    "type:feature",
    "feature:platform"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run build",
        "cwd": "packages/features/platform"
      },
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"],
      "outputs": ["{projectRoot}/dist"],
      "cache": true
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run typecheck",
        "cwd": "packages/features/platform"
      },
      "inputs": ["default", "^production"],
      "cache": true
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run test",
        "cwd": "packages/features/platform"
      },
      "inputs": ["default", "^production"],
      "cache": true
    }
  }
}

