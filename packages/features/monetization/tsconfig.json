{
  "extends": [
    "../../../tsconfig.base.json",
    "../tsconfig.build-paths.json"
  ],
  "compilerOptions": {
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "noEmit": true,
    "incremental": true,
    "tsBuildInfoFile": "./node_modules/.cache/.tsbuildinfo"
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "tests"
  ]
}
