{
  "name": "features-reporting",
  "root": "packages/features/reporting",
  "sourceRoot": "packages/features/reporting/src",
  "projectType": "library",
  "tags": [
    "scope:frontend",
    "type:lib",
    "type:feature",
    "feature:reporting"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run build",
        "cwd": "packages/features/reporting"
      },
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "production",
        "^production"
      ],
      "outputs": [
        "{projectRoot}/dist"
      ],
      "cache": true
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run typecheck",
        "cwd": "packages/features/reporting"
      },
      "inputs": [
        "default",
        "^production"
      ],
      "cache": true
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run test",
        "cwd": "packages/features/reporting"
      },
      "inputs": [
        "default",
        "^production"
      ],
      "cache": true
    }
  }
}

