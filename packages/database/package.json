{
  "name": "@ovds/database",
  "version": "0.1.0",
  "private": true,
  "description": "OVDS Prisma database client — backend only",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "source": "./src/index.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "node ../../scripts/bin-run.mjs typescript/bin/tsc",
    "build:clean": "node ../../scripts/bin-run.mjs typescript/bin/tsc --build --clean && node ../../scripts/bin-run.mjs typescript/bin/tsc",
    "typecheck": "node ../../scripts/bin-run.mjs typescript/bin/tsc --noEmit",
    "generate": "node scripts/run-generate.mjs ../../.env",
    "generate:plesk": "node scripts/run-generate.mjs ../../.env.production",
    "generate:zod": "npm run generate",
    "db:generate:plesk": "npm run generate:plesk",
    "db:push": "echo 'WARNING: db push is for local dev only. Use db:migrate:prod for production.' && node scripts/fix-fk-collisions.mjs ../../.env && node scripts/prisma-run.mjs ../../.env db push --config=./prisma.config.js",
    "db:push:prod": "echo 'ERROR: db:push:prod is disabled. Use db:migrate:prod for production schema changes.' && exit 1",
    "migrate:dev": "node scripts/prisma-run.mjs ../../.env migrate dev --config=./prisma.config.js",
    "migrate:local": "node scripts/prisma-run.mjs ../../.env migrate deploy --config=./prisma.config.js",
    "migrate:deploy": "node scripts/prisma-run.mjs ../../.env.production migrate deploy --config=./prisma.config.js",
    "migrate:prod": "node scripts/prisma-run.mjs ../../.env.production migrate deploy --config=./prisma.config.js",
    "studio": "node scripts/prisma-run.mjs ../../.env studio --config=./prisma.config.js",
    "seed": "node scripts/tsx-run.mjs --env-file=../../.env prisma/seed.ts",
    "seed:prod": "node scripts/tsx-run.mjs --env-file=../../.env.production prisma/seed.ts -- --environment=production",
    "seed:demo": "node scripts/tsx-run.mjs --env-file=../../.env.production prisma/seed-demo.ts"
  },
  "dependencies": {
    "@ovds/shared": "*",
    "@prisma/client": "7.10.0",
    "bcryptjs": "3.0.3",
    "mariadb": "3.5.3",
    "uuid": "13.0.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@faker-js/faker": "10.6.0",
    "@prisma/adapter-mariadb": "7.10.0",
    "@types/bcryptjs": "2.4.6",
    "@types/uuid": "10.0.0",
    "prisma": "7.10.0",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "zod-prisma-types": "3.3.11"
  }
}
