// ── IAS 19 — Employee Benefits (Gratuity & End-of-Service Provisions) ─────────
// Ethiopian Labour Proclamation 1156/2019 mandates end-of-service gratuity.
// IAS 19 requires recognition as a provision (present obligation, probable outflow).

model EmployeeBenefitObligation {
  id             String   @id @default(uuid())
  employeeId     String   @db.VarChar(36)
  companyId      String?  @db.VarChar(36)
  /// GRATUITY | END_OF_SERVICE | ANNUAL_LEAVE | PENSION_TOP_UP
  type           String   @default("GRATUITY") @db.VarChar(30)
  /// Years of continuous service at valuation date
  yearsService   Decimal  @default(0) @db.Decimal(6, 2)
  monthlySalary  Decimal  @default(0) @db.Decimal(18, 2)
  /// Obligation per Ethiopian Labour Proclamation 1156/2019
  obligationAmt  Decimal  @default(0) @db.Decimal(18, 2)
  /// Amount funded / set aside
  fundedAmt      Decimal  @default(0) @db.Decimal(18, 2)
  /// obligationAmt − fundedAmt (unfunded = balance sheet liability)
  deficitAmt     Decimal  @default(0) @db.Decimal(18, 2)
  /// Discount rate for present value (IAS 19.83) — Ethiopian govt bond yield
  actuarialRate  Decimal  @default(10) @db.Decimal(5, 2)
  valuationDate  DateTime @default(now())
  journalEntryId String?  @db.VarChar(36)
  notes          String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt

  @@index([employeeId])
  @@index([companyId])
  @@map("employeebenefitobligation")
}

// ── IAS 37 — Provisions, Contingent Liabilities & Contingent Assets ───────────
// Recognised when: present obligation + probable outflow + reliable estimate.
// IAS 37.36 measurement: best estimate of expenditure required to settle.

model Provision {
  id             String    @id @default(uuid())
  companyId      String?   @db.VarChar(36)
  /// LEGAL | WARRANTY | RESTRUCTURING | ONEROUS_CONTRACT | ENVIRONMENTAL | GRATUITY | OTHER
  type           String    @default("OTHER") @db.VarChar(30)
  description    String    @db.VarChar(500)
  /// PROBABLE | POSSIBLE | REMOTE
  probability    String    @default("PROBABLE") @db.VarChar(20)
  /// Best estimate (point amount or range midpoint)
  amount         Decimal   @default(0) @db.Decimal(18, 2)
  /// Range low estimate
  amountLow      Decimal   @default(0) @db.Decimal(18, 2)
  /// Range high estimate
  amountHigh     Decimal   @default(0) @db.Decimal(18, 2)
  expectedSettle DateTime?
  discountRate   Decimal   @default(0) @db.Decimal(5, 2)
  /// OPEN | UTILISED | REVERSED | SETTLED
  status         String    @default("OPEN") @db.VarChar(20)
  journalEntryId String?   @db.VarChar(36)
  utilisedAmount Decimal   @default(0) @db.Decimal(18, 2)
  reversedAmount Decimal   @default(0) @db.Decimal(18, 2)
  notes          String?   @db.Text
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now()) @updatedAt

  @@index([companyId])
  @@index([status])
  @@index([type])
  @@map("provision")
}

