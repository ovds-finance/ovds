  paymentReference    String?         @db.VarChar(200)
  municipality        String?         @db.VarChar(100)
  notes               String?         @db.Text
  createdBy           String?
  createdAt           DateTime        @default(now())

  @@index([companyId])
  @@index([status])
  @@map("stamp_duty_record")
}

enum StampDutyStatus {
  DRAFT
  PAID
  EXEMPT
  PENDING
}

// ── Gratuity / Severance ──────────────────────────────────────────────────────
/// Gratuity — Labour Proclamation No. 1156/2019
model GratuityRecord {
  id                String          @id @default(uuid())
  companyId         String?
  employeeId        String?
  employeeName      String          @db.VarChar(200)
  monthlySalary     Decimal         @db.Decimal(18, 2)
  startDate         DateTime
  endDate           DateTime
  terminationType   TerminationType
  contractType      ContractType    @default(INDEFINITE)
  unusedLeaveDays   Int             @default(0)
  noticePeriodGiven Boolean         @default(false)
  yearsOfService    Int             @default(0)
  dailyRate         Decimal         @db.Decimal(18, 2)
  basicSeverancePay Decimal         @default(0) @db.Decimal(18, 2)
  noticePay         Decimal         @default(0) @db.Decimal(18, 2)
  unusedLeavePay    Decimal         @default(0) @db.Decimal(18, 2)
  totalGratuity     Decimal         @default(0) @db.Decimal(18, 2)
  paid              Boolean         @default(false)
  paidAt            DateTime?
  paymentReference  String?         @db.VarChar(200)
  notes             String?         @db.Text
  createdBy         String?
  createdAt         DateTime        @default(now())
  employee          Employee?       @relation(fields: [employeeId], references: [id])

  @@index([companyId])
  @@index([employeeId])
  @@index([paid])
  @@map("gratuity_record")
}

enum TerminationType {
  EMPLOYER_WITHOUT_CAUSE
  FIXED_TERM_EXPIRY
  MUTUAL_AGREEMENT
  EMPLOYEE_FAULT
  EMPLOYER_FAULT
  RETIREMENT
  INCAPACITY
  DEATH
}

enum ContractType {
  INDEFINITE
  FIXED_TERM
  PIECE_RATE
}

// ═══════════════════════════════════════════════════════════════════════════════
// GAP-FIX MODELS — Added to close identified accounting completeness gaps
// ═══════════════════════════════════════════════════════════════════════════════

// ── WHT Certificate (Withholding Tax Certificate) ─────────────────────────────
// Ethiopian ERCA WHT certificates must be issued to suppliers when WHT is deducted.
// Proclamation No. 1395/2025: WHT certificates required for all deductions.

model WhtCertificate {
  id            String    @id @default(uuid())
  certNo        String    @unique @db.VarChar(50)
  companyId     String?
  /// GOODS | SERVICES | SERVICES_NR | RENT | DIVIDEND | INTEREST
  whtType       String    @default("GOODS") @db.VarChar(20)
  issueDate     DateTime  @default(now())
  period        String    @db.VarChar(7) // YYYY-MM
  /// Withholding agent (payer) details
  agentName     String    @db.VarChar(200)
  agentTin      String?   @db.VarChar(15)
  /// Supplier (recipient) details
  supplierName  String    @db.VarChar(200)
  supplierTin   String?   @db.VarChar(15)
  /// Amount details
  grossAmount   Decimal   @default(0) @db.Decimal(18, 2)
   whtRate       Decimal   @default(0.02) @db.Decimal(8, 6)
  whtAmount     Decimal   @default(0) @db.Decimal(18, 2)
  netPayable    Decimal   @default(0) @db.Decimal(18, 2)
  /// Linked bill (if deducted on a bill)
  billId        String?   @db.VarChar(36)
  billReference String?   @db.VarChar(100)
  /// Remittance to ERCA
  remitted      Boolean   @default(false)
  remittedAt    DateTime?
  ercaReference String?   @db.VarChar(100)
  /// DRAFT | ISSUED | REMITTED | CANCELLED
  status        String    @default("DRAFT") @db.VarChar(20)
  notes         String?   @db.Text
  createdBy     String?   @db.VarChar(100)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt

  @@index([companyId])
  @@index([period])
  @@index([status])
  @@index([supplierTin])
  @@map("wht_certificate")
}

// ── PAYE Monthly Declaration ──────────────────────────────────────────────────
// Ethiopian employers must submit monthly PAYE (payroll tax) to ERCA by the
// last day of the following month. Proclamation No. 1395/2025.

model PayeDeclaration {
  id               String    @id @default(uuid())
  companyId        String?
  /// YYYY-MM — the payroll period being declared
  period           String    @db.VarChar(7)
  /// Total number of employees in the period
  employeeCount    Int       @default(0)
  /// Total gross salaries for the period
  totalGrossSalary Decimal   @default(0) @db.Decimal(18, 2)
  /// Total PIT deducted from employees
  totalPit         Decimal   @default(0) @db.Decimal(18, 2)
  /// Total employee pension (7%)
  totalEmpPension  Decimal   @default(0) @db.Decimal(18, 2)
  /// Total employer pension (11%)
  totalEmpRPension Decimal   @default(0) @db.Decimal(18, 2)
  /// Total DRRF levy (1%)
  totalDrrf        Decimal   @default(0) @db.Decimal(18, 2)
  /// Net payable to ERCA (PIT + DRRF only — pension goes to PFSA)
  netPayableErca   Decimal   @default(0) @db.Decimal(18, 2)
  /// Pension payable to PFSA (employee + employer)
  netPayablePfsa   Decimal   @default(0) @db.Decimal(18, 2)
  /// DRAFT | SUBMITTED | PAID | OVERDUE
  status           String    @default("DRAFT") @db.VarChar(20)
  dueDate          DateTime?
  submittedAt      DateTime?
  ercaReference    String?   @db.VarChar(100)
  paidAt           DateTime?
  paymentReference String?   @db.VarChar(200)
  notes            String?   @db.Text
  createdBy        String?   @db.VarChar(100)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @default(now()) @updatedAt

  @@unique([companyId, period])
  @@index([companyId])
  @@index([period])
  @@index([status])
  @@map("paye_declaration")
}

// ── Pension Remittance (PFSA) ─────────────────────────────────────────────────
// Private Organizations Employees Social Security Agency (PFSA) requires
// monthly pension contributions. Employee 7% + Employer 11% = 18% total.

model PensionRemittance {
  id                     String    @id @default(uuid())
  companyId              String?
  /// YYYY-MM — payroll period
  period                 String    @db.VarChar(7)
  employeeCount          Int       @default(0)
  totalInsurableEarnings Decimal   @default(0) @db.Decimal(18, 2)
  employeeContrib        Decimal   @default(0) @db.Decimal(18, 2) // 7%
  employerContrib        Decimal   @default(0) @db.Decimal(18, 2) // 11%
  totalContrib           Decimal   @default(0) @db.Decimal(18, 2) // 18%
  /// DRAFT | SUBMITTED | PAID | OVERDUE
  status                 String    @default("DRAFT") @db.VarChar(20)
  dueDate                DateTime?
  submittedAt            DateTime?
  pfsaReference          String?   @db.VarChar(100)
  paidAt                 DateTime?
  paymentReference       String?   @db.VarChar(200)
  bankName               String?   @db.VarChar(100)
  notes                  String?   @db.Text
  createdBy              String?   @db.VarChar(100)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @default(now()) @updatedAt

  @@unique([companyId, period])
  @@index([companyId])
  @@index([period])
  @@index([status])
  @@map("pension_remittance")
}

// ── Depreciation Schedule (persistent per asset per period) ───────────────────
// IAS 16 requires depreciation to be charged each period.
// Persistent schedule enables audit trail and prevents double-posting.

model DepreciationSchedule {
  id              String   @id @default(uuid())
  assetId         String   @db.VarChar(36)
  companyId       String?
  period          String   @db.VarChar(7) // YYYY-MM
  openingCarrying Decimal  @default(0) @db.Decimal(18, 2)
  depreciationAmt Decimal  @default(0) @db.Decimal(18, 2)
  closingCarrying Decimal  @default(0) @db.Decimal(18, 2)
  accumulatedDepr Decimal  @default(0) @db.Decimal(18, 2)
  method          String   @default("STRAIGHT_LINE") @db.VarChar(30)
  journalEntryId  String?  @db.VarChar(36)
  /// SCHEDULED | POSTED | SKIPPED
  status          String   @default("SCHEDULED") @db.VarChar(20)
  notes           String?  @db.VarChar(300)
  createdAt       DateTime @default(now())

  @@unique([assetId, period])
  @@index([companyId])
  @@index([assetId])
  @@index([period])
  @@index([status])
  @@map("depreciation_schedule")
}

// ── Accrual / Prepayment ──────────────────────────────────────────────────────
// IAS 37 / IAS 1 require accruals (expenses incurred not yet invoiced) and
// prepayments (payments made for future periods) to be recognised correctly.

model AccrualPrepayment {
  id               String           @id @default(uuid())
  companyId        String?
  /// ACCRUAL | PREPAYMENT
  type             String           @default("ACCRUAL") @db.VarChar(20)
  description      String           @db.VarChar(500)
  accountId        String?          @db.VarChar(36)
  counterAccountId String?          @db.VarChar(36)
  amount           Decimal          @default(0) @db.Decimal(18, 2)
  startDate        DateTime
  endDate          DateTime
  totalMonths      Int              @default(1)
  amortisedMonths  Int              @default(0)
  monthlyAmount    Decimal          @default(0) @db.Decimal(18, 2)
  remainingAmount  Decimal          @default(0) @db.Decimal(18, 2)
  /// ACTIVE | FULLY_AMORTISED | CANCELLED
  status           String           @default("ACTIVE") @db.VarChar(20)
  notes            String?          @db.Text
  createdBy        String?          @db.VarChar(100)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @default(now()) @updatedAt
  postings         AccrualPosting[]

  @@index([companyId])
  @@index([status])
  @@map("accrual_prepayment")
}

model AccrualPosting {
  id             String            @id @default(uuid())
  accrualId      String
  companyId      String?
  period         String            @db.VarChar(7)
  amount         Decimal           @db.Decimal(18, 2)
  journalEntryId String?           @db.VarChar(36)
  status         String            @default("POSTED") @db.VarChar(20)
  createdAt      DateTime          @default(now())
  company        Company?          @relation(fields: [companyId], references: [id], map: "AccrualPosting_companyId_fkey")
  accrual        AccrualPrepayment @relation(fields: [accrualId], references: [id], onDelete: Cascade)

  @@index([companyId], map: "AccrualPosting_companyId_idx")
  @@index([accrualId])
  @@index([period])
  @@map("accrual_posting")
}

// ── Stock Valuation Ledger (FIFO / AVCO) ──────────────────────────────────────
// IAS 2 requires FIFO or Weighted Average Cost — LIFO is prohibited.
// This model stores the cost layer ledger for FIFO and the running AVCO.

model StockValuationLayer {
  id              String   @id @default(uuid())
  itemId          String   @db.VarChar(36)
  companyId       String?
  warehouseId     String?  @db.VarChar(36)
  /// RECEIPT | ISSUE | ADJUSTMENT | OPENING
  transactionType String   @default("RECEIPT") @db.VarChar(20)
  /// FIFO | AVCO
  valuationMethod String   @default("AVCO") @db.VarChar(10)
  date            DateTime @default(now())
  quantity        Decimal  @db.Decimal(18, 4)
  unitCost        Decimal  @db.Decimal(18, 4)
  totalCost       Decimal  @db.Decimal(18, 4)
  /// For FIFO: remaining quantity in this layer not yet consumed
  remainingQty    Decimal  @default(0) @db.Decimal(18, 4)
  /// Running AVCO after this transaction
  runningAvco     Decimal? @db.Decimal(18, 4)
  /// Running total quantity after this transaction
  runningQty      Decimal? @db.Decimal(18, 4)
  /// Running total value after this transaction
  runningValue    Decimal? @db.Decimal(18, 4)
  reference       String?  @db.VarChar(100)
  journalEntryId  String?  @db.VarChar(36)
  createdAt       DateTime @default(now())

  @@index([itemId])
  @@index([companyId])
  @@index([date])
  @@map("stock_valuation_layer")
}

// ── Intercompany Elimination Entry ────────────────────────────────────────────
// IFRS 10.B86 requires elimination of intercompany balances and transactions
// on consolidation. Each elimination entry links to the intercompany transaction.

model IntercompanyElimination {
  id               String   @id @default(uuid())
  fromCompanyId    String   @db.VarChar(36)
  toCompanyId      String   @db.VarChar(36)
  intercompanyTxId String?  @db.VarChar(36)
  period           String   @db.VarChar(7)
  /// RECEIVABLE | PAYABLE | REVENUE | EXPENSE | DIVIDEND | INVESTMENT
  eliminationType  String   @default("RECEIVABLE") @db.VarChar(20)
  amount           Decimal  @db.Decimal(18, 2)
  journalEntryId   String?  @db.VarChar(36)
  /// PENDING | POSTED | REVERSED
  status           String   @default("PENDING") @db.VarChar(20)
  notes            String?  @db.Text
  createdBy        String?  @db.VarChar(100)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @default(now()) @updatedAt

  @@index([fromCompanyId])
  @@index([toCompanyId])
  @@index([period])
  @@index([status])
  @@map("intercompany_elimination")
}

// ── Bank Transfer File Export ──────────────────────────────────────────────────
// Track bulk payroll bank file exports for CBE, Awash, Dashen formats.

model BankPayrollExport {
  id            String    @id @default(uuid())
  companyId     String?
  period        String    @db.VarChar(7)
  /// CBE | AWASH | DASHEN | ABYSSINIA | BERHAN | GENERIC
  bankFormat    String    @default("GENERIC") @db.VarChar(20)
  employeeCount Int       @default(0)
  totalAmount   Decimal   @default(0) @db.Decimal(18, 2)
  fileName      String?   @db.VarChar(255)
  fileData      String?   @db.LongText
  /// GENERATED | SENT | CONFIRMED | FAILED
  status        String    @default("GENERATED") @db.VarChar(20)
  generatedBy   String?   @db.VarChar(100)
  sentAt        DateTime?
  confirmedAt   DateTime?
  notes         String?   @db.Text
  createdAt     DateTime  @default(now())

  @@index([companyId])
  @@index([period])
  @@index([status])
  @@map("bank_payroll_export")
}

// ═══════════════════════════════════════════════════════════════════════════════
// MISSING TAX COMPLIANCE MODELS — Ethiopian Tax Compliance Guide (2020)
// ═══════════════════════════════════════════════════════════════════════════════

// ── Higher Education Cost Sharing (Graduate Tax) ──────────────────────────────
/// Section 3.3.13 — Proclamation No. 110/1998 + Reg. 154/2008
/// Employers must withhold ≥10% of graduate's monthly income and remit
/// alongside monthly employment income tax. Deduction starts within 6 months
/// of graduation or at most 1 year after graduation.

model GraduateTaxEmployee {
  id                  String                @id @default(uuid())
  companyId           String?
  employeeId          String?
  employeeName        String                @db.VarChar(200)
  employeeTin         String?               @db.VarChar(20)
  /// Name of the public higher-learning institution
  institution         String                @db.VarChar(300)
  /// Reference document issued by the institution
  institutionRef      String?               @db.VarChar(200)
  /// Total cost-sharing amount owed (from institution document)
  totalOwed           Decimal               @default(0) @db.Decimal(18, 2)
  /// Amount deducted each month (≥10% of monthly income)
  monthlyDeduction    Decimal               @default(0) @db.Decimal(18, 2)
  /// Running total already deducted
  totalDeducted       Decimal               @default(0) @db.Decimal(18, 2)
  /// Remaining balance to deduct
  balanceRemaining    Decimal               @default(0) @db.Decimal(18, 2)
  /// Date deduction started (within 6 months of graduation / 1 year max)
  deductionStartDate  DateTime?
  /// Date employment ended (for final statement)
  employmentEndDate   DateTime?
  /// ACTIVE | COMPLETED | TERMINATED
  status              String                @default("ACTIVE") @db.VarChar(20)
  notes               String?               @db.Text
  createdBy           String?               @db.VarChar(100)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @default(now()) @updatedAt
  employee            Employee?             @relation(fields: [employeeId], references: [id])
  deductions          GraduateTaxDeduction[]

  @@index([companyId])
  @@index([employeeId])
  @@index([status])
  @@map("graduate_tax_employee")
}

model GraduateTaxDeduction {
  id                 String              @id @default(uuid())
  graduateTaxId      String
  companyId          String?
  /// YYYY-MM — payroll period this deduction was applied
  period             String              @db.VarChar(7)
  monthlySalary      Decimal             @default(0) @db.Decimal(18, 2)
  deductionAmount    Decimal             @default(0) @db.Decimal(18, 2)
  /// Reference to ERCA/MoR remittance
  ercaReference      String?             @db.VarChar(100)
  remitted           Boolean             @default(false)
  remittedAt         DateTime?
  payrollRecordId    String?
  createdAt          DateTime            @default(now())
  graduateTax        GraduateTaxEmployee @relation(fields: [graduateTaxId], references: [id], onDelete: Cascade)

  @@index([graduateTaxId])
  @@index([companyId])
  @@index([period])
  @@map("graduate_tax_deduction")
}

// ── Schedule D Tax Records ─────────────────────────────────────────────────────
/// Section 3.3.4 — Federal Income Tax Proclamation No. 979/2016 / 1395/2025
/// Other income: dividends, interest, capital gains, royalties, casual rentals,
/// games of chance, undistributed profit, repatriated profit, windfall profit.
/// Tax imposed is a FINAL TAX on the income.

model ScheduleDFiling {
  id               String    @id @default(uuid())
  companyId        String?
  /// DIVIDEND | INTEREST_STANDARD | INTEREST_SAVINGS | CAPITAL_GAINS_CLASS_A
  /// | CAPITAL_GAINS_CLASS_B | ROYALTY_ARTISTIC | ROYALTY_TECHNICAL
  /// | DIGITAL_CONTENT | GAMES_OF_CHANCE | CASUAL_RENTAL | REPATRIATED_PROFIT
  /// | UNDISTRIBUTED_PROFIT | MANAGEMENT_FEES | TECHNICAL_FEES | WINDFALL_PROFIT
  taxType          String    @db.VarChar(50)
  /// YYYY-MM for monthly; YYYY for annual
  period           String    @db.VarChar(7)
  recipientName    String?   @db.VarChar(255)
  recipientTin     String?   @db.VarChar(20)
  grossAmount      Decimal   @default(0) @db.Decimal(18, 2)
  taxRate          Decimal   @default(0) @db.Decimal(8, 6)
  taxAmount        Decimal   @default(0) @db.Decimal(18, 2)
  netAmount        Decimal   @default(0) @db.Decimal(18, 2)
  /// For capital gains: original acquisition cost
  acquisitionCost  Decimal?  @db.Decimal(18, 2)
  disposalProceeds Decimal?  @db.Decimal(18, 2)
  capitalGain      Decimal?  @db.Decimal(18, 2)
  /// CLASS_A (immovable) | CLASS_B (shares/bonds) — for capital gains
  assetClass       String?   @db.VarChar(20)
  /// Whether WHT agent has already withheld this tax at source
  withheldAtSource Boolean   @default(false)
  ercaReference    String?   @db.VarChar(100)
  dueDate          DateTime?
  filedAt          DateTime?
  paidAt           DateTime?
  paymentReference String?   @db.VarChar(200)
  /// DRAFT | FILED | PAID | EXEMPT | OVERDUE
  status           String    @default("DRAFT") @db.VarChar(20)
  notes            String?   @db.Text
  createdBy        String?   @db.VarChar(100)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @default(now()) @updatedAt

  @@index([companyId])
  @@index([taxType])
  @@index([period])
  @@index([status])
  @@map("schedule_d_filing")
}

// ── Tax Loss Carry Forward ────────────────────────────────────────────────────
/// Section 25 — Federal Income Tax Proclamation No. 979/2016
/// - Losses can be carried forward for up to 5 tax years.
/// - If two consecutive years of losses have been carried forward, no further carry forward.
/// - Earliest carried-forward loss must be deducted first.
/// - Books must be audited and acceptable to the authority.

model TaxLossCarryforward {
  id                String              @id @default(uuid())
  companyId         String?
  /// The tax year in which the loss was incurred (EFY fiscal year number)
  lossYear          Int
  /// Original loss amount
  lossAmount        Decimal             @default(0) @db.Decimal(18, 2)
  /// Amount utilized so far across subsequent years
  utilizedAmount    Decimal             @default(0) @db.Decimal(18, 2)
  /// Remaining loss available to carry forward
  remainingAmount   Decimal             @default(0) @db.Decimal(18, 2)
  /// Year in which this loss expires (lossYear + 5)
  expiryYear        Int
  /// Whether the books were audited and accepted (required for carry forward)
  booksAudited      Boolean             @default(false)
  externalAuditor   String?             @db.VarChar(200)
  /// AVAILABLE | PARTIALLY_USED | FULLY_USED | EXPIRED | DISALLOWED
  status            String              @default("AVAILABLE") @db.VarChar(20)
  notes             String?             @db.Text
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @default(now()) @updatedAt
  utilizations      LossUtilization[]

  @@unique([companyId, lossYear])
  @@index([companyId])
  @@index([status])
  @@map("tax_loss_carryforward")
}

model LossUtilization {
  id               String             @id @default(uuid())
  lossId           String
  companyId        String?
  /// The BIT filing year in which this loss was utilized as a deduction
  utilizationYear  Int
  amountUtilized   Decimal            @db.Decimal(18, 2)
  incomeTaxFilingId String?
  notes            String?            @db.Text
  createdAt        DateTime           @default(now())
  loss             TaxLossCarryforward @relation(fields: [lossId], references: [id], onDelete: Cascade)

  @@index([lossId])
  @@index([companyId])
  @@map("loss_utilization")
}

// ── BIT Provisional Tax Payments ──────────────────────────────────────────────
/// Section 3.3.3 — Category A/B/C payment periods
/// Schedule C taxpayer may pay 50% of prior year BIT as installment by last day
/// of month following end of the 6th month of the year.
/// Installment paid is CREDITED against final BIT liability.

model ProvisionalTaxPayment {
  id                  String    @id @default(uuid())
  companyId           String?
  /// Ethiopian fiscal year (e.g. 2024 = EFY 2016/17)
  fiscalYear          Int
  /// HALF_YEAR (50% by end of month following month 6) | Q1 | Q2 | Q3 | Q4
  installmentType     String    @default("HALF_YEAR") @db.VarChar(20)
  /// Based on 50% of prior year final BIT
  expectedAmount      Decimal   @default(0) @db.Decimal(18, 2)
  /// Actual amount paid
  paidAmount          Decimal   @default(0) @db.Decimal(18, 2)
  paymentDate         DateTime?
  paymentReference    String?   @db.VarChar(200)
  dueDate             DateTime?
  ercaReference       String?   @db.VarChar(100)
  creditApplied       Boolean   @default(false)
  /// PENDING | PAID | CREDITED | OVERDUE
  status              String    @default("PENDING") @db.VarChar(20)
  notes               String?   @db.Text
  createdBy           String?   @db.VarChar(100)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @default(now()) @updatedAt

  @@unique([companyId, fiscalYear, installmentType])
  @@index([companyId])
  @@index([status])
  @@map("provisional_tax_payment")
}

// ── Import Advance Tax (3% CIF) ───────────────────────────────────────────────
/// Section 3.3.3 — Schedule C importers advance BIT at 3% of CIF value.
/// Any excess over final BIT liability is refunded via standard refund procedures.

model ImportAdvanceTax {
  id                  String    @id @default(uuid())
  companyId           String?
  /// YYYY-MM period of the import
  period              String    @db.VarChar(7)
  importDeclarationNo String?   @db.VarChar(100)
  cifValue            Decimal   @default(0) @db.Decimal(18, 2)
  advanceTaxRate      Decimal   @default(0.03) @db.Decimal(8, 6)
  advanceTaxPaid      Decimal   @default(0) @db.Decimal(18, 2)
  paymentDate         DateTime?
  paymentReference    String?   @db.VarChar(200)
  /// Amount credited against final BIT
  creditedAgainstBit  Decimal   @default(0) @db.Decimal(18, 2)
  /// Amount pending refund after crediting against BIT
  refundPending       Decimal   @default(0) @db.Decimal(18, 2)
  customsDeclaration  String?   @db.VarChar(200)
  /// PAID | CREDITED | REFUND_PENDING | REFUNDED
  status              String    @default("PAID") @db.VarChar(20)
  notes               String?   @db.Text
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @default(now()) @updatedAt

  @@index([companyId])
  @@index([period])
  @@index([status])
  @@map("import_advance_tax")
}

// ── Foreign Tax Credit ────────────────────────────────────────────────────────
/// Section 20.1 — Ethiopia adopts credit system for foreign income tax.
/// Credit allowed = lesser of (foreign tax paid) and (Ethiopian Schedule C BIT on that income).
/// Must be paid within 2 years of the tax year in which the foreign income was derived.

model ForeignTaxCredit {
  id                   String    @id @default(uuid())
  companyId            String?
  /// Tax year in which the foreign income was derived
  taxYear              Int
  foreignCountry       String    @db.VarChar(100)
  foreignIncome        Decimal   @default(0) @db.Decimal(18, 2)
  /// Foreign income tax paid in the foreign country
  foreignTaxPaid       Decimal   @default(0) @db.Decimal(18, 2)
  /// Ethiopian Schedule C BIT on this specific foreign income (30% rate applied)
  ethiopianTaxOnForeignIncome Decimal @default(0) @db.Decimal(18, 2)
  /// Credit allowed = min(foreignTaxPaid, ethiopianTaxOnForeignIncome)
  creditAllowed        Decimal   @default(0) @db.Decimal(18, 2)
  /// Receipt/certificate from foreign tax authority (required)
  foreignTaxReceiptRef String?   @db.VarChar(200)
  receiptDate          DateTime?
  /// Must pay within 2 years of year-end in which foreign income was derived
  creditDeadline       DateTime?
  /// Whether credit was applied in the final BIT filing for the year
  applied              Boolean   @default(false)
  appliedInFilingId    String?
  /// PENDING | APPLIED | EXPIRED | DISALLOWED
  status               String    @default("PENDING") @db.VarChar(20)
  notes                String?   @db.Text
  createdBy            String?   @db.VarChar(100)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @default(now()) @updatedAt

  @@index([companyId])
  @@index([taxYear])
  @@index([status])
  @@map("foreign_tax_credit")
}

// ── Thin Capitalization Monitor ───────────────────────────────────────────────
/// Section 20.3 — Interest deduction proportionately disallowed when average
/// debt:equity ratio exceeds 2:1 for foreign-controlled entities.

model ThinCapMonitor {
  id                      String    @id @default(uuid())
  companyId               String?
  taxYear                 Int
  /// Average total debt for the year
  averageDebt             Decimal   @default(0) @db.Decimal(18, 2)
  /// Average total equity for the year
  averageEquity           Decimal   @default(0) @db.Decimal(18, 2)
  debtToEquityRatio       Decimal   @default(0) @db.Decimal(10, 4)
  /// 2:1 threshold
  thresholdRatio          Decimal   @default(2.00) @db.Decimal(10, 4)
  exceedsThreshold        Boolean   @default(false)
  /// Total interest expense for the year
  totalInterestExpense    Decimal   @default(0) @db.Decimal(18, 2)
  /// Arm's length debt amount (if exceeds 2:1 but within arm's length, still allowed)
  armsLengthDebt          Decimal?  @db.Decimal(18, 2)
  /// Interest disallowed (proportionate to excess debt over threshold or arm's length)
  disallowedInterest      Decimal   @default(0) @db.Decimal(18, 2)
  /// Interest allowed as deduction
  allowedInterest         Decimal   @default(0) @db.Decimal(18, 2)
  /// Whether >50% of membership interest is held by non-residents
  foreignControlled       Boolean   @default(false)
  assessedBy              String?   @db.VarChar(100)
  notes                   String?   @db.Text
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @default(now()) @updatedAt

  @@unique([companyId, taxYear])
  @@index([companyId])
  @@map("thin_cap_monitor")
}

// ── Transfer Pricing Register ─────────────────────────────────────────────────
/// Section 20.5 — Related-party transactions ≥ ETB 500,000/year require
/// contemporaneous arm's-length documentation (OECD TP Guidelines apply as
/// secondary source; Ethiopian Proclamation and directive take precedence).

model TransferPricingRecord {
  id                   String    @id @default(uuid())
  companyId            String?
  taxYear              Int
  relatedPartyName     String    @db.VarChar(255)
  relatedPartyCountry  String?   @db.VarChar(100)
  relatedPartyTin      String?   @db.VarChar(30)
  /// SALE_OF_GOODS | PURCHASE_OF_GOODS | SERVICES_RENDERED | SERVICES_RECEIVED
  /// | ROYALTY | MANAGEMENT_FEE | LOAN_ADVANCE | GUARANTEE | OTHER
  transactionType      String    @db.VarChar(50)
  transactionAmount    Decimal   @default(0) @db.Decimal(18, 2)
  transferPrice        Decimal   @default(0) @db.Decimal(18, 2)
  /// CUP | RESALE_PRICE | COST_PLUS | TNMM | PROFIT_SPLIT | OTHER
  pricingMethod        String?   @db.VarChar(30)
  armsLengthPrice      Decimal?  @db.Decimal(18, 2)
  adjustmentRequired   Boolean   @default(false)
  adjustmentAmount     Decimal   @default(0) @db.Decimal(18, 2)
  documentationRef     String?   @db.VarChar(500)
  /// DOCUMENTED | PARTIAL | MISSING
  documentationStatus  String    @default("MISSING") @db.VarChar(20)
  notes                String?   @db.Text
  createdBy            String?   @db.VarChar(100)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @default(now()) @updatedAt

  @@index([companyId])
  @@index([taxYear])
  @@index([transactionType])
  @@map("transfer_pricing_record")
}

// ── Tax Dispute / Objection Tracker ──────────────────────────────────────────
/// Section 27 — Disputes go: Tax Authority Review → Tax Appeal Commission
///             → Federal High Court → Federal Supreme Court.
/// - Objection must be filed within 21 days of assessment notice.
/// - Appeal to TAC requires paying 50% of disputed tax (without penalty/interest).
/// - Appeal to Federal High Court requires paying 75% (law question only).

model TaxDisputeCase {
  id                      String    @id @default(uuid())
  companyId               String?
  /// Reference to the original tax assessment (VatFiling, IncomeTaxFiling, etc.)
  assessmentRef           String?   @db.VarChar(200)
  assessmentType          String    @db.VarChar(50)  // VAT | BIT | WHT | PAYE | etc.
  assessmentAmount        Decimal   @default(0) @db.Decimal(18, 2)
  disputedAmount          Decimal   @default(0) @db.Decimal(18, 2)
  undisputedPaid          Decimal   @default(0) @db.Decimal(18, 2)
  /// REVIEW | TAC | HIGH_COURT | SUPREME_COURT | CLOSED
  currentStage            String    @default("REVIEW") @db.VarChar(30)
  objectionFiledDate      DateTime?
  /// Deadline: 21 days after notice of assessment
  objectionDeadline       DateTime?
  reviewDecisionDate      DateTime?
  reviewDecisionOutcome   String?   @db.VarChar(200)
  tacFiledDate            DateTime?
  /// 50% of disputed tax must be paid before TAC appeal
  tacDepositPaid          Decimal   @default(0) @db.Decimal(18, 2)
  tacDecisionDate         DateTime?
  tacDecisionOutcome      String?   @db.VarChar(200)
  highCourtFiledDate      DateTime?
  /// 75% of disputed tax must be paid before High Court
  highCourtDepositPaid    Decimal   @default(0) @db.Decimal(18, 2)
  highCourtDecisionDate   DateTime?
  highCourtDecisionOutcome String?  @db.VarChar(200)
  supremeCourtFiledDate   DateTime?
  supremeCourtDecision    String?   @db.VarChar(200)
  finalOutcome            String?   @db.VarChar(200)
  /// OPEN | WON | PARTIALLY_WON | LOST | WITHDRAWN
  status                  String    @default("OPEN") @db.VarChar(20)
  notes                   String?   @db.Text
  createdBy               String?   @db.VarChar(100)
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @default(now()) @updatedAt

  @@index([companyId])
  @@index([status])
  @@index([currentStage])
  @@map("tax_dispute_case")
}

// ── Tax Clearance Request ─────────────────────────────────────────────────────
/// Section 23 — Written evidence from ERCA that taxpayer has discharged obligations.
/// Required for: licence renewal, public tender, vehicle registration, bank loans,
/// asset transfers, business closure, share transfers, etc.

model TaxClearanceRequest {
  id                  String    @id @default(uuid())
  companyId           String?
  /// LICENCE_RENEWAL | PUBLIC_TENDER | BANK_LOAN | VEHICLE_REGISTRATION
  /// | ASSET_TRANSFER | BUSINESS_CLOSURE | SHARE_TRANSFER | OTHER
  purpose             String    @db.VarChar(50)
  purposeDescription  String?   @db.VarChar(500)
  requestDate         DateTime  @default(now())
  submittedToERCA     Boolean   @default(false)
  submittedDate       DateTime?
  /// Reference number from ERCA when clearance is issued
  clearanceRef        String?   @db.VarChar(100)
  issueDate           DateTime?
  /// For public tender or bank loan: 6 months validity
  /// For asset/business transfers: 3 months validity
  validUntil          DateTime?
  /// REQUESTED | UNDER_REVIEW | AUDIT_IN_PROGRESS | ISSUED | REJECTED | EXPIRED
  status              String    @default("REQUESTED") @db.VarChar(30)
  rejectionReason     String?   @db.VarChar(500)
  notes               String?   @db.Text
  createdBy           String?   @db.VarChar(100)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @default(now()) @updatedAt

  @@index([companyId])
  @@index([status])
  @@index([purpose])
  @@map("tax_clearance_request")
}

// ── Net Tax Payable Report ─────────────────────────────────────────────────────
/// Consolidated monthly/annual snapshot of all tax obligations for MoR reporting.
/// Combines VAT, WHT, PAYE, Pension, Excise, Stamp Duty, Schedule D, Graduate Tax,
/// TOT, BIT provisional, and DRRF into a single net payable position.

model NetTaxPayableReport {
  id                      String    @id @default(uuid())
  companyId               String?
  /// YYYY-MM for monthly reports; YYYY for annual
  period                  String    @db.VarChar(7)
  reportType              String    @default("MONTHLY") @db.VarChar(10)  // MONTHLY | ANNUAL

  // ── VAT (Proclamation 1341/2024) ──
  vatOutputCollected      Decimal   @default(0) @db.Decimal(18, 2)
  vatInputClaimable       Decimal   @default(0) @db.Decimal(18, 2)
  vatNetPayable           Decimal   @default(0) @db.Decimal(18, 2)

  // ── TOT — mutually exclusive with VAT ──
  totGoodsPayable         Decimal   @default(0) @db.Decimal(18, 2)
  totServicesPayable      Decimal   @default(0) @db.Decimal(18, 2)
  totNetPayable           Decimal   @default(0) @db.Decimal(18, 2)

  // ── WHT (Proclamation 1395/2025) ──
  whtOnGoods              Decimal   @default(0) @db.Decimal(18, 2)
  whtOnServices           Decimal   @default(0) @db.Decimal(18, 2)
  whtOnDividends          Decimal   @default(0) @db.Decimal(18, 2)
  whtOnInterest           Decimal   @default(0) @db.Decimal(18, 2)
  whtOnNonResident        Decimal   @default(0) @db.Decimal(18, 2)
  whtTotalToRemit         Decimal   @default(0) @db.Decimal(18, 2)

  // ── PAYE → ERCA (PIT + DRRF) ──
  payePitWithheld         Decimal   @default(0) @db.Decimal(18, 2)
  payeDrrf                Decimal   @default(0) @db.Decimal(18, 2)
  payeNetPayableErca      Decimal   @default(0) @db.Decimal(18, 2)

  // ── Pension → PFSA ──
  pensionEmployee         Decimal   @default(0) @db.Decimal(18, 2)
  pensionEmployer         Decimal   @default(0) @db.Decimal(18, 2)
  pensionTotalPfsa        Decimal   @default(0) @db.Decimal(18, 2)

  // ── Graduate Tax (Section 3.3.13) ──
  graduateTaxDeducted     Decimal   @default(0) @db.Decimal(18, 2)
  graduateTaxToRemit      Decimal   @default(0) @db.Decimal(18, 2)

  // ── Excise Tax (Proclamation 1186/2020) ──
  exciseTaxDue            Decimal   @default(0) @db.Decimal(18, 2)

  // ── Stamp Duty (Proclamation 110/1998) ──
  stampDutyDue            Decimal   @default(0) @db.Decimal(18, 2)

  // ── Schedule D (final withholding taxes) ──
  scheduleDDividend       Decimal   @default(0) @db.Decimal(18, 2)
  scheduleDInterest       Decimal   @default(0) @db.Decimal(18, 2)
  scheduleDCapitalGains   Decimal   @default(0) @db.Decimal(18, 2)
  scheduleDRoyalties      Decimal   @default(0) @db.Decimal(18, 2)
  scheduleDOther          Decimal   @default(0) @db.Decimal(18, 2)
  scheduleDTotal          Decimal   @default(0) @db.Decimal(18, 2)

  // ── DRRF Quarterly (Regulation 570/2025) ──
  drrfLevyDue             Decimal   @default(0) @db.Decimal(18, 2)

  // ── BIT Provisional (if applicable for the period) ──
  bitProvisionalDue       Decimal   @default(0) @db.Decimal(18, 2)
  bitProvisionalPaid      Decimal   @default(0) @db.Decimal(18, 2)

  // ── Grand Total ──
  grandTotalPayable       Decimal   @default(0) @db.Decimal(18, 2)
  grandTotalPaid          Decimal   @default(0) @db.Decimal(18, 2)
  grandTotalOutstanding   Decimal   @default(0) @db.Decimal(18, 2)

  /// DRAFT | FINALISED | SUBMITTED_TO_MOR
  status                  String    @default("DRAFT") @db.VarChar(20)
  generatedAt             DateTime  @default(now())
  finalisedAt             DateTime?
  submittedAt             DateTime?
  ercaReferenceNo         String?   @db.VarChar(100)
  notes                   String?   @db.Text
  generatedBy             String?   @db.VarChar(100)
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @default(now()) @updatedAt

  @@unique([companyId, period, reportType])
  @@index([companyId])
  @@index([period])
  @@index([status])
  @@map("net_tax_payable_report")
}

// ═══════════════════════════════════════════════════════════════════════════════
// TASS / SRM / CUSTOMS / PORTAL MODELS
// Ministry of Revenues (MoR) — formerly ERCA
// ═══════════════════════════════════════════════════════════════════════════════

// ── Sales Register Machine (SRM / EFD) ───────────────────────────────────────
/// MoR TASS portal: https://tass.mor.gov.et
/// Every VAT-registered business must register each SRM with TASS.
/// Penalty for unregistered device: ETB 50,000 (Tax Admin. Proc. s.26.1).

model SrmDevice {
  id                String    @id @default(uuid())
  companyId         String?
  /// Manufacturer serial number embossed on device
  deviceSerialNo    String    @unique @db.VarChar(100)
  /// ERCA-accredited model (e.g. "Sunmi T2", "EPSON TM-T88VI")
  deviceModel       String    @db.VarChar(100)
  /// TASS-assigned device ID — affixed as visible sticker on device
  tassDeviceId      String?   @db.VarChar(100)
  /// Machine registration code from TASS accreditation sticker
  registrationCode  String?   @db.VarChar(100)
  /// TIN of the registered business
  tin               String    @db.VarChar(20)
  businessAddress   String    @db.VarChar(500)
  /// ACTIVE | SUSPENDED | DECOMMISSIONED
  status            String    @default("ACTIVE") @db.VarChar(20)
  /// Last Z-report date (daily fiscal closure)
  lastZReportDate   DateTime?
  /// Last X-report date (intraday totals)
  lastXReportDate   DateTime?
  fiscalMemoryUsedPct Decimal? @db.Decimal(5, 2)
  serviceContractRef  String?  @db.VarChar(200)
  serviceContractExpiry DateTime?
  notes             String?   @db.Text
  registeredAt      DateTime  @default(now())
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @default(now()) @updatedAt

  @@index([companyId])
  @@index([status])
  @@map("srm_device")
}

// ── Customs Declaration (e-SAD) ───────────────────────────────────────────────
/// Ethiopia Customs Trade Portal: https://trade.gov.et
/// e-SAD = electronic Single Administrative Document (replaces paper SAD)
/// Filed with Ethiopian Customs Commission (ECC) via ASYCUDA World.
/// Covers import/export declarations, customs duty, excise, surtax, VAT on imports.

model CustomsDeclaration {
  id                   String    @id @default(uuid())
  companyId            String?
  /// Assigned by ASYCUDA World on submission
  sadNumber            String?   @db.VarChar(50)
  /// IMPORT | EXPORT | TRANSIT | WAREHOUSE
  declarationType      String    @default("IMPORT") @db.VarChar(20)
  /// e-SAD submission reference from Customs Trade Portal
  eSadReference        String?   @db.VarChar(100)
  /// Related trade shipment ID
  shipmentId           String?   @db.VarChar(36)
  importerExporterName String    @db.VarChar(255)
  importerTin          String?   @db.VarChar(20)
  /// Country of origin (ISO 3166-1 alpha-2)
  originCountry        String?   @db.VarChar(3)
  destinationCountry   String?   @db.VarChar(3)
  portOfEntry          String?   @db.VarChar(100)
  declarationDate      DateTime  @default(now())
  /// HS commodity code (6 or 8 digit WCO standard)
  hsCode               String?   @db.VarChar(10)
  hsDescription        String?   @db.VarChar(500)
  goodsDescription     String?   @db.VarChar(500)
  /// Quantity and unit
  quantity             Decimal   @default(0) @db.Decimal(18, 4)
  unit                 String?   @db.VarChar(30)
  /// CIF value (Cost, Insurance, Freight) — base for all customs calculations
  cifValueUsd          Decimal   @default(0) @db.Decimal(18, 2)
  cifValueEtb          Decimal   @default(0) @db.Decimal(18, 2)
  exchangeRate         Decimal   @default(1) @db.Decimal(10, 4)
  /// Customs duty (0–35% of CIF)
  customsDutyRate      Decimal   @default(0) @db.Decimal(8, 6)
  customsDutyAmount    Decimal   @default(0) @db.Decimal(18, 2)
  /// Excise duty (5–500% depending on goods — Proc. 1186/2020)
  exciseDutyAmount     Decimal   @default(0) @db.Decimal(18, 2)
  /// Import surtax (10% of CIF + customs + excise, exempt for capital goods)
  surtaxAmount         Decimal   @default(0) @db.Decimal(18, 2)
  /// VAT on imports (15% of CIF + customs + excise + surtax)
  vatOnImportAmount    Decimal   @default(0) @db.Decimal(18, 2)
  /// Total tax burden on import
  totalTaxBurden       Decimal   @default(0) @db.Decimal(18, 2)
  /// Advance BIT payment (3% of CIF — Schedule C importers)
  advanceBitAmount     Decimal   @default(0) @db.Decimal(18, 2)
  /// COMESA preferential rate applied? (10% lower than standard rate)
  comesaPreferential   Boolean   @default(false)
  /// Capital goods (exempt from surtax)
  isCapitalGoods       Boolean   @default(false)
  /// Payment reference after customs duties paid
  paymentReference     String?   @db.VarChar(200)
  /// DRAFT | SUBMITTED | ASSESSED | PAID | CLEARED | REJECTED
  status               String    @default("DRAFT") @db.VarChar(20)
  assessedAt           DateTime?
  paidAt               DateTime?
  clearedAt            DateTime?
  notes                String?   @db.Text
  createdBy            String?   @db.VarChar(100)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @default(now()) @updatedAt

  @@index([companyId])
  @@index([declarationType])
  @@index([status])
  @@index([hsCode])
  @@map("customs_declaration")
}

// ── e-Manifest ────────────────────────────────────────────────────────────────
/// Electronic cargo manifest filed by shipping agents with ECC.
/// Linked to e-SAD declarations for each consignment.

model CargoManifest {
  id                 String    @id @default(uuid())
  companyId          String?
  /// Vessel/flight/truck number
  vehicleRef         String    @db.VarChar(100)
  /// SEA | AIR | LAND
  transportMode      String    @default("SEA") @db.VarChar(10)
  portOfArrival      String?   @db.VarChar(100)
  arrivalDate        DateTime?
  /// e-Manifest reference from ECC
  eManifestRef       String?   @db.VarChar(100)
  totalBillsOfLading Int       @default(0)
  totalWeight        Decimal   @default(0) @db.Decimal(18, 2)
  totalVolume        Decimal   @default(0) @db.Decimal(18, 2)
  /// DRAFT | SUBMITTED | ACCEPTED | REJECTED
  status             String    @default("DRAFT") @db.VarChar(20)
  submittedAt        DateTime?
  notes              String?   @db.Text
  createdBy          String?   @db.VarChar(100)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @default(now()) @updatedAt

  @@index([companyId])
  @@index([status])
  @@map("cargo_manifest")
}

// ── HS Tariff Lookup Cache ────────────────────────────────────────────────────
/// Locally cached entries from the ECC Customs Tariff Engine.
/// Refreshed on demand from https://trade.gov.et/tariff
/// Avoids repeated portal lookups for the same HS codes.

model HsTariffEntry {
  id               String    @id @default(uuid())
  /// WCO 6-digit HS code
  hsCode           String    @unique @db.VarChar(10)
  hsDescription    String    @db.VarChar(500)
  /// Chapter (2-digit) and heading (4-digit) for grouping
  chapter          String    @db.VarChar(2)
  heading          String    @db.VarChar(4)
  /// Standard customs duty rate (10–35%)
  standardRate     Decimal   @default(0) @db.Decimal(8, 6)
  /// COMESA preferential rate (standard − 10%)
  comesaRate       Decimal   @default(0) @db.Decimal(8, 6)
  /// Excise tax rate if applicable
  exciseRate       Decimal?  @db.Decimal(8, 6)
  /// Whether surtax (10%) applies
  surtaxApplies    Boolean   @default(true)
  /// Whether goods qualify as capital goods (surtax exempt)
  isCapitalGoods   Boolean   @default(false)
  /// Whether goods are prohibited or restricted
  restricted       Boolean   @default(false)
  restrictionNote  String?   @db.VarChar(500)
  /// Last sync from ECC portal
  lastSyncedAt     DateTime  @default(now())
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @default(now()) @updatedAt

  @@index([chapter])
  @@index([heading])
  @@map("hs_tariff_entry")
}

// ── MoR Portal Submission Log ─────────────────────────────────────────────────
/// Unified outbox for all government portal submissions with retry state.
/// Covers: MoR e-Tax, TASS, ECC Customs Trade Portal, ESLSE, NBE.

model PortalSubmissionLog {
  id               String    @id @default(uuid())
  companyId        String?
  /// ETAX | TASS | CUSTOMS | ESLSE | NBE
  portalCode       String    @db.VarChar(20)
  /// e.g. VAT_RETURN, PAYE, WHT, BIT, SRM_REGISTER, CUSTOMS_DECLARATION
  submissionType   String    @db.VarChar(50)
  period           String?   @db.VarChar(10)
  /// JSON payload sent (stored for audit & retry)
  payload          String?   @db.LongText
  /// Raw response from portal
  response         String?   @db.LongText
  /// Portal-assigned reference number (ERCA ref, SAD number, TASS ID, etc.)
  portalReference  String?   @db.VarChar(200)
  /// PENDING | SUCCESS | FAILED | RETRYING | ABANDONED
  status           String    @default("PENDING") @db.VarChar(20)
  /// live | sandbox | stub
  submissionMode   String    @default("sandbox") @db.VarChar(10)
  attemptCount     Int       @default(0)
  lastAttemptAt    DateTime?
  nextRetryAt      DateTime?
  errorMessage     String?   @db.VarChar(1000)
  submittedBy      String?   @db.VarChar(100)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @default(now()) @updatedAt

  @@index([companyId])
  @@index([portalCode])
  @@index([status])
  @@index([submissionType])
  @@map("portal_submission_log")
}

// ── Offline Resilience Queue (MoR Regulation No. 570/2025) ────────────────────────
/// Queue for offline invoice/bill creation in regulated sectors.
/// Enables businesses to continue sales during internet interruptions.

model OfflineInvoiceQueue {
  id              String    @id @default(uuid())
  companyId       String?
  invoiceData     String    @db.LongText
  status          String    @default("PENDING") @db.VarChar(20)
  deviceId        String?   @db.VarChar(100)
  fiscalYear      String?   @db.VarChar(10)
  sequenceNumber  Int?
  syncAttempts    Int       @default(0)
  lastSyncAttempt DateTime?
  syncError       String?   @db.VarChar(1000)
  syncedAt        DateTime?
  invoiceId       String?   @db.VarChar(36)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @default(now()) @updatedAt
  company         Company?  @relation(fields: [companyId], references: [id])

  // ── SyncQueueEntry fields (required by SyncEngine.persistEntry) ──────────
  /// SyncOperationType enum value (e.g. INVOICE_CREATE, TAX_FILING_SYNC)
  operationType     String?   @db.VarChar(50)
  /// Canonical document reference used for idempotency (e.g. invoice ID or IRN)
  documentReference String?   @db.VarChar(255)
  /// SHA-256 checksum of the operation payload for tamper-detection
  checksum          String?   @db.VarChar(100)
  /// Idempotency key — prevents double-processing on replay
  idempotencyKey    String?   @unique @db.VarChar(255)
  /// Source reconciliation engine (LEGACY | OVDS | UNIFIED)
  engineSource      String?   @db.VarChar(20)
  /// ISO-8601 expiry timestamp — entries past this are pruned
  expiresAt         DateTime?
  /// Retry attempt counter for the SyncEngine retry loop
  retryCount        Int       @default(0)
  /// Last error message from the push transport
  lastError         String?   @db.VarChar(1000)

  @@index([companyId])
  @@index([status])
  @@index([deviceId])
  @@index([fiscalYear])
  @@index([syncedAt])
  @@index([operationType])
  @@index([checksum])
  @@map("offline_invoice_queue")
}

/// Registered offline devices for regulated sectors.
/// Tracks which devices are enrolled for offline resilience per company.
model OfflineDeviceRegistry {
  id           String   @id @default(uuid())
  deviceId     String   @unique @db.VarChar(100)
  deviceName   String   @db.VarChar(200)
  deviceType   String   @default("DESKTOP") @db.VarChar(30)
  companyId    String?
  lastSyncAt   DateTime?
  pendingCount Int      @default(0)
  isOnline     Boolean  @default(true)
  registeredAt DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt
  company      Company? @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@index([deviceId])
  @@map("offline_device_registry")
}


// ═══════════════════════════════════════════════════════════════════════════════
// IoT / SMART MANAGEMENT MODELS
// Covers: device registry, real-time telemetry, OTA updates, smart billing triggers
// ═══════════════════════════════════════════════════════════════════════════════

/// IoT Device Registry — the authoritative record for every managed device
model IotDevice {
  id                String          @id @default(uuid())
  companyId         String?
  /// Human-readable name: "Smart Meter #14", "Router: Branch A"
  name              String          @db.VarChar(200)
  /// Internal device serial / hardware identifier
  serialNumber      String          @db.VarChar(100)
  /// External IMEI / MAC / vendor ref
  externalRef       String?         @db.VarChar(100)
  /// SMART_METER | ROUTER | SENSOR | CONTROLLER | CAMERA | POS_TERMINAL | OTHER
  deviceType        String          @default("SENSOR") @db.VarChar(30)
  /// Physical or logical location (e.g. "Warehouse B – Shelf 3")
  location          String?         @db.VarChar(300)
  firmwareVersion   String?         @db.VarChar(50)
  hardwareVersion   String?         @db.VarChar(50)
  manufacturer      String?         @db.VarChar(100)
  model             String?         @db.VarChar(100)
  /// ACTIVE | INACTIVE | MAINTENANCE | DECOMMISSIONED | OFFLINE
  status            String          @default("ACTIVE") @db.VarChar(20)
  /// ISO 8601 last seen heartbeat
  lastSeenAt        DateTime?
  /// Battery percentage 0–100; null for wired devices
  batteryLevel      Int?
  /// Uptime hours since last reboot
  uptimeHours       Decimal?        @db.Decimal(12, 2)
  /// MQTT topic, API endpoint, or webhook URL
  connectionString  String?         @db.VarChar(500)
  /// MQTT | HTTP | COAP | MODBUS | ZIGBEE | ZWAVE | BLE | OTHER
  protocol          String?         @db.VarChar(20)
  /// Arbitrary config JSON (thresholds, calibration, tags)
  configJson        String?         @db.LongText
  /// Customer ID this device is installed at (for billable events)
  customerId        String?         @db.VarChar(36)
  /// Linked fixed asset (for depreciation)
  fixedAssetId      String?         @db.VarChar(36)
  notes             String?         @db.Text
  createdBy         String?         @db.VarChar(100)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  telemetry         IotTelemetry[]
  alerts            IotAlert[]
  otaJobs           OtaUpdateJob[]
  billingTriggers   IotBillingTrigger[]

  @@index([companyId])
  @@index([status])
  @@index([deviceType])
  @@index([customerId])
  @@map("iot_device")
}

/// Telemetry time-series — one row per reading per device
/// Keep rows short; archive older than 90 days to a cold store (future)
model IotTelemetry {
  id            String    @id @default(uuid())
  deviceId      String
  companyId     String?
  /// Sensor reading type: ENERGY_KWH | TEMPERATURE | HUMIDITY | PRESSURE
  /// | FLOW_RATE | CURRENT_A | VOLTAGE_V | BANDWIDTH_MBPS | PACKET_LOSS_PCT | CUSTOM
  metricKey     String    @db.VarChar(50)
  /// Numeric sensor value
  value         Decimal   @db.Decimal(18, 6)
  unit          String?   @db.VarChar(20)
  /// UTC timestamp of the reading (device clock)
  recordedAt    DateTime
  /// NORMAL | WARNING | CRITICAL | FAULT
  quality       String    @default("NORMAL") @db.VarChar(10)
  rawPayload    String?   @db.LongText
  createdAt     DateTime  @default(now())
  device        IotDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId])
  @@index([metricKey])
  @@index([recordedAt])
  @@index([companyId])
  @@map("iot_telemetry")
}

/// IoT Alerts — triggered when a telemetry value crosses a threshold
model IotAlert {
  id              String    @id @default(uuid())
  deviceId        String
  companyId       String?
  /// THRESHOLD | OFFLINE | BATTERY_LOW | FIRMWARE_OUTDATED | BILLING_TRIGGER | ANOMALY | CUSTOM
  alertType       String    @db.VarChar(30)
  severity        String    @default("WARNING") @db.VarChar(10)
  title           String    @db.VarChar(300)
  message         String    @db.Text
  metricKey       String?   @db.VarChar(50)
  thresholdValue  Decimal?  @db.Decimal(18, 6)
  actualValue     Decimal?  @db.Decimal(18, 6)
  /// OPEN | ACKNOWLEDGED | RESOLVED | SUPPRESSED
  status          String    @default("OPEN") @db.VarChar(20)
  acknowledgedBy  String?   @db.VarChar(100)
  acknowledgedAt  DateTime?
  resolvedAt      DateTime?
  /// If this alert triggered a billing event, link the invoice
  linkedInvoiceId String?   @db.VarChar(36)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  device          IotDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId])
  @@index([status])
  @@index([alertType])
  @@index([companyId])
  @@map("iot_alert")
}

/// OTA (Over-The-Air) firmware update jobs
model OtaUpdateJob {
  id               String    @id @default(uuid())
  deviceId         String
  companyId        String?
  targetVersion    String    @db.VarChar(50)
  fromVersion      String?   @db.VarChar(50)
  /// Package download URL or MQTT topic payload
  packageUrl       String?   @db.VarChar(500)
  /// PENDING | IN_PROGRESS | SUCCESS | FAILED | ROLLED_BACK | CANCELLED
  status           String    @default("PENDING") @db.VarChar(20)
  /// Progress percentage 0–100
  progress         Int       @default(0)
  scheduledAt      DateTime?
  startedAt        DateTime?
  completedAt      DateTime?
  errorMessage     String?   @db.VarChar(1000)
  rollbackReason   String?   @db.VarChar(500)
  initiatedBy      String?   @db.VarChar(100)
  releaseNotes     String?   @db.Text
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  device           IotDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId])
  @@index([status])
  @@index([companyId])
  @@map("ota_update_job")
}

/// Smart Billable Triggers — IoT events that auto-generate invoice line items
/// e.g. "Energy usage > 100 kWh threshold crossed → create billable line item"
model IotBillingTrigger {
  id                  String    @id @default(uuid())
  deviceId            String
  companyId           String?
  customerId          String?   @db.VarChar(36)
  /// THRESHOLD_EXCEEDED | USAGE_MILESTONE | ALERT_FIRED | SCHEDULED_READ | MANUAL
  triggerType         String    @db.VarChar(30)
  /// Which metric caused the trigger
  metricKey           String?   @db.VarChar(50)
  /// The threshold value that was crossed
  thresholdValue      Decimal?  @db.Decimal(18, 6)
  /// The actual value that triggered the billing event
  actualValue         Decimal?  @db.Decimal(18, 6)
  /// Billing line item description to appear on invoice
  lineItemDescription String    @db.VarChar(500)
  /// Billable amount (ETB or configured currency)
  billableAmount      Decimal   @default(0) @db.Decimal(18, 2)
  currencyCode        String    @default("ETB") @db.VarChar(3)
  /// Whether a line item has been added to an invoice
  invoiced            Boolean   @default(false)
  linkedInvoiceId     String?   @db.VarChar(36)
  linkedInvoiceNo     String?   @db.VarChar(100)
  invoicedAt          DateTime?
  /// Telemetry snapshot at trigger time (JSON)
  snapshotJson        String?   @db.LongText
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  device              IotDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId])
  @@index([companyId])
  @@index([customerId])
  @@index([invoiced])
  @@map("iot_billing_trigger")
}

/// IoT Dashboard Widget Config — persists per user/company widget layouts
model IotDashboardWidget {
  id          String   @id @default(uuid())
  companyId   String?
  userId      String?  @db.VarChar(36)
  widgetType  String   @db.VarChar(50)
  title       String   @db.VarChar(200)
  /// Device IDs or metric keys the widget monitors (JSON array)
  configJson  String   @db.LongText
  /// Grid position: row, col, width, height
  posX        Int      @default(0)
  posY        Int      @default(0)
  width       Int      @default(2)
  height      Int      @default(2)
  isVisible   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([companyId])
  @@index([userId])
  @@map("iot_dashboard_widget")
}

/// e-Tax Online Submission — tracks VAT declaration submissions to ERCA portal
/// Extends VatFiling with e-service submission metadata
model ETaxSubmissionRecord {
  id               String    @id @default(uuid())
  companyId        String?
  vatFilingId      String?   @db.VarChar(36)
  /// VAT_RETURN | TOT_RETURN | PAYE | WHT | BIT_PROVISIONAL
  submissionType   String    @default("VAT_RETURN") @db.VarChar(30)
  period           String    @db.VarChar(7)
  /// Payload sent to ERCA e-Tax portal (JSON)
  payloadJson      String?   @db.LongText
  /// Raw response from ERCA portal
  responseJson     String?   @db.LongText
  /// ERCA-issued reference number on acceptance
  ercaReferenceNo  String?   @db.VarChar(100)
  ercaAckXml       String?   @db.LongText
  totalPayable     Decimal   @default(0) @db.Decimal(18, 2)
  /// DRAFT | PENDING | SUBMITTED | ACCEPTED | REJECTED | FAILED
  status           String    @default("DRAFT") @db.VarChar(20)
  /// live | sandbox | stub
  mode             String    @default("sandbox") @db.VarChar(10)
  submittedAt      DateTime?
  acceptedAt       DateTime?
  rejectedAt       DateTime?
  rejectionReason  String?   @db.VarChar(1000)
  submittedBy      String?   @db.VarChar(100)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([companyId])
  @@index([period])
  @@index([status])
  @@index([submissionType])
  @@map("etax_submission_record")
}

/// MoR Acknowledgement Receipt Vault — stores official ERCA acknowledgement receipts
/// Provides immutable audit trail and legal proof of tax submission
model MorAcknowledgementReceipt {
  id                 String    @id @default(uuid())
  companyId          String?
  submissionRecordId String?   @db.VarChar(36)
  /// VAT_RETURN | TOT_RETURN | PAYE | WHT | BIT_PROVISIONAL | CUSTOMS_DECLARATION
  submissionType     String    @default("VAT_RETURN") @db.VarChar(30)
  /// Official ERCA receipt number
  receiptNumber      String?   @db.VarChar(100)
  receiptDate        DateTime?
  /// Tax period in YYYY-MM format
  period             String?   @db.VarChar(7)
  /// Raw ERCA acknowledgement XML
  ackXml             String?   @db.LongText
  /// Base64 encoded PDF receipt
  ackPdf             String?   @db.LongText
  /// Canonical JSON payload used as the SHA-256 `documentHash` input (tamper-evident)
  ackPayload         String?   @db.LongText
  /// PENDING | VERIFIED | FAILED
  verificationStatus String    @default("PENDING") @db.VarChar(20)
  /// XML_SIGNATURE | QR_CODE | MANUAL
  verificationMethod String?   @db.VarChar(30)
  /// SHA-256 hash of receipt for integrity verification
  documentHash       String?   @db.VarChar(64)
  /// Download URL for the receipt PDF
  downloadUrl        String?   @db.VarChar(500)
  submittedBy        String?   @db.VarChar(100)
  verifiedAt         DateTime?
  verifiedBy         String?   @db.VarChar(100)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([companyId])
  @@index([submissionRecordId])
  @@index([receiptNumber])
  @@index([period])
  @@index([verificationStatus])
  @@map("mor_acknowledgement_receipt")
}

enum IotDeviceStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
  DECOMMISSIONED
  OFFLINE
}

enum OtaJobStatus {
  PENDING
  IN_PROGRESS
  SUCCESS
  FAILED
  ROLLED_BACK
  CANCELLED
}

/// ─── Documentation Portal ────────────────────────────────────────────────────
/// Stores categorized knowledge-base articles for the public /docs portal.
/// Populated by the categorization seed script (scripts/seed-docs.mjs).
/// All fields are read-only from public-facing endpoints — no user data stored here.
model DocArticle {
  id          String   @id @default(uuid())
  /// Slug used in URL: /docs/<slug>
  slug        String   @unique @db.VarChar(200)
  title       String   @db.VarChar(300)
  /// One of: feature | tutorial | faq | api_reference
  category    String   @db.VarChar(50)
  /// Sub-group within a category (e.g. "HR & Payroll", "VAT")
  subcategory String?  @db.VarChar(100)
  /// Short summary shown in search results / cards
  summary     String?  @db.Text
  /// Full article body in Markdown
  content     String   @db.LongText
  /// Tags for search/filtering (JSON array of strings)
  tags        String?  @db.Text
  /// Optional display order within the category
  sortOrder   Int      @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([subcategory])
  @@index([isPublished])
  @@map("doc_article")
}

// ═══════════════════════════════════════════════════════════════════════════════
// CLIENT — HYBRID DEPLOYMENT
// Tracks workstation nodes that connect the local Client to the
// cloud account.  Each row represents one registered workstation.
// ═══════════════════════════════════════════════════════════════════════════════

/// Registered workstation nodes for the hybrid Client.
/// Each Enterprise plan company can register unlimited nodes.
/// The node token is stored as a SHA-256 hash — the raw value is
/// returned once at registration time and never stored in plaintext.
model ClientNode {
  id           String    @id @db.VarChar(64)
  companyId    String
  /// Human-readable label set by the admin (e.g. "Office Workstation 1")
  friendlyName String    @db.VarChar(80)
  /// REMOTE_TERMINAL | PRIVATE_NODE
  role         String    @default("REMOTE_TERMINAL") @db.VarChar(20)
  /// SHA-256 hash of the one-time node token
  tokenHash    String    @db.VarChar(64)
  /// UTC timestamp of last successful sync contact
  lastSeenAt   DateTime?
  registeredAt DateTime  @default(now())
  company      Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  revoked      Boolean   @default(false)

  @@index([companyId])
  @@index([tokenHash])
  @@map("client_node")
}

// ═══════════════════════════════════════════════════════════════════════════════
// UNIVERSAL TAX CONFIGURATION
// Stores per-tenant tax profiles and sector override flags.
// Matches CompanyTaxProfile interface in universal-tax-config.ts.
// Applied via: packages/database/migrations/universal_tax_config.sql
// ═══════════════════════════════════════════════════════════════════════════════

/// Per-tenant tax configuration profile.
/// One row per company. Replaces ad-hoc systemsetting keys for tax config.
/// All tax calculators, schedulers, and filing services read from this model.
model CompanyTaxProfile {
  id                     String   @id @default(uuid())
  companyId              String   @unique
  tin                    String   @db.VarChar(20)
  vatNumber              String?  @db.VarChar(30)
  srmDeviceSerial        String?  @db.VarChar(50)

  /// FULL_IFRS | IFRS_FOR_SMES | EFRS_SMALL | EFRS_MICRO
  aabeFramework          String   @default("EFRS_SMALL") @db.VarChar(20)
  isPie                  Boolean  @default(false)
  annualTurnoverEtb      Decimal  @default(0)

  /// EthiopianSector enum value (stored as string)
  sector                 String   @default("OTHER") @db.VarChar(50)
  /// SOLE_PROPRIETORSHIP | PLC | ONE_MEMBER_PLC | SHARE_COMPANY
  entityType             String   @default("PLC") @db.VarChar(25)

  /// A=VAT registered, B=TOT 500K-2M, C=<500K
  vatTotBand             String   @default("C") @db.VarChar(1)
  /// A>1M, B=500K-1M, C<500K annual turnover
  incomeTaxSchedule      String   @default("C") @db.VarChar(1)
  isVatRegistered        Boolean  @default(false)
  isTotApplicable        Boolean  @default(true)

  /// JSON map: { vat: bool, tot: bool, bit: bool, pit: bool, ... }
  activeTaxes            String   @db.LongText
  /// JSON map: { VAT: 0.15, WHT_GOODS: 0.03, ... } — only when MoR grants special rate
  rateOverrides          String?  @db.Text

  /// Filing calendar
  fiscalYearStartMonth   Int      @default(7)
  vatFilingDay           Int      @default(30)
  pitFilingDay           Int      @default(30)
  drrfFilingDay          Int      @default(15)
  bitDeadlineMonth       Int      @default(11)
  bitDeadlineDay         Int      @default(7)

  /// IAS 12 deferred tax settings
  enableDeferredTax      Boolean  @default(false)
  deferredTaxRate        Decimal  @default(0.3000)
  /// Ethiopian pool depreciation rates — Proc. 979/2016 Art. 25
  poolCat1               Decimal  @default(0.2500)
  poolCat2               Decimal  @default(0.2000)
  poolCat3               Decimal  @default(0.1500)
  poolCat4               Decimal  @default(0.1000)

  materialityThresholdEtb Decimal @default(5000)
  /// HALF_UP | HALF_EVEN
  roundingMethod         String   @default("HALF_UP") @db.VarChar(10)

  /// Integration flags
  etaxAutoSubmit         Boolean  @default(false)
  srmIntegrated          Boolean  @default(false)
  cbeReconciliation      Boolean  @default(false)

  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([vatTotBand, incomeTaxSchedule])
  @@index([sector])
  @@map("company_tax_profile")
}

/// Canonical tax rule — one row per TaxTypeCode.
/// Seeded by universal_tax_config.sql. Read-only in production.
/// All rate/threshold changes must go through a migration + audit log.
model TaxRule {
  id                           String   @id @default(uuid())
  /// TaxTypeCode enum value — unique business key
  code                         String   @unique @db.VarChar(30)
  name                         String   @db.VarChar(120)
  label                        String   @db.VarChar(60)
  rate                         Decimal  @default(0)
  specificRateEtb              Decimal? @db.Decimal(12, 4)
  thresholdEtb                 Decimal  @default(0)
  annualTurnoverThresholdEtb   Decimal?
  /// OUTPUT | INPUT | BOTH
  direction                    String   @default("BOTH") @db.VarChar(6)
  /// CURRENT_TAX | DEFERRED_TAX | NOT_INCOME_TAX
  ias12Treatment               String   @db.VarChar(20)
  /// OPERATING | INVESTING | FINANCING | INCOME_TAX | DISCONTINUED
  ifrs18Category               String   @default("OPERATING") @db.VarChar(15)
  glDebitCode                  String   @db.VarChar(10)
  glCreditCode                 String   @db.VarChar(10)
  glDebitName                  String   @db.VarChar(120)
  glCreditName                 String   @db.VarChar(120)
  /// MONTHLY | QUARTERLY | ANNUAL | AT_TRANSACTION | AT_CLEARANCE
  frequency                    String   @db.VarChar(20)
  deadline                     String   @db.VarChar(200)
  /// ETAX | TASS | CUSTOMS | PFSA | MUNICIPALITY
  portal                       String   @default("ETAX") @db.VarChar(15)
  /// FULL | PARTIAL | MANUAL
  automation                   String   @default("MANUAL") @db.VarChar(10)
  proclamation                 String   @db.VarChar(300)
  enabledDefault               Boolean  @default(true)
  overridable                  Boolean  @default(true)
  notes                        String?  @db.Text
  isActive                     Boolean  @default(true)
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt

  @@index([isActive])
  @@map("tax_rule")
}

/// Sector-level tax exemptions or rate overrides.
/// Applied on top of TaxRule when building CompanyTaxProfile for a sector.
model SectorTaxOverride {
  id            String   @id @default(uuid())
  sector        String   @db.VarChar(50)
  taxCode       String   @db.VarChar(30)
  /// NULL = use universal rate; set when MoR grants sector-specific rate
  rateOverride  Decimal?
  exempt        Boolean  @default(false)
  conditionText String   @db.VarChar(500)
  authority     String   @db.VarChar(300)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  @@index([sector, taxCode])
  @@map("sector_tax_override")
}

/// Canonical GL account codes used exclusively for tax journal entries.
/// Seeded by universal_tax_config.sql.
/// Must be cross-referenced with Account.code on first-use provisioning.
model TaxGlAccount {
  id             String   @id @default(uuid())
  code           String   @unique @db.VarChar(10)
  name           String   @db.VarChar(120)
  /// ASSET | LIABILITY | EQUITY | REVENUE | EXPENSE
  type           String   @db.VarChar(10)
  /// DEBIT | CREDIT
  normalBalance  String   @db.VarChar(6)
  /// OPERATING | INVESTING | FINANCING | INCOME_TAX | DISCONTINUED
  ifrs18Category String?  @db.VarChar(15)
  /// CURRENT_TAX | DEFERRED_TAX | NOT_INCOME_TAX
  ias12Treatment String?  @db.VarChar(20)
  description    String?  @db.Text
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  @@map("tax_gl_account")
}

// ═══════════════════════════════════════════════════════════════════════════════
// ORDERS & DISPATCH (Trade module)
// SalesOrder → SalesOrderLine → DispatchDocket → DispatchDocketLine
// Tracks order-to-delivery lifecycle with DIFOT delivery performance.
// ═══════════════════════════════════════════════════════════════════════════════

/// Sales Order header — created when a customer places an order
model SalesOrder {
  id                      String    @id @default(uuid())
  companyId               String?
  OrderNumber             String    @db.VarChar(50)
  CustomerId              String?   @db.VarChar(36)
  CustomerName            String?   @db.VarChar(200)
  /// STANDARD | DIRECT | CONSIGNMENT | TRANSFER
  SalesType               String?   @db.VarChar(30)
  OrderDate               DateTime  @default(now())
  RequestedDeliveryDate   DateTime?
  CurrencyCode            String?   @db.VarChar(3)
  CurrencyRate            Decimal?  @db.Decimal(18, 6)
  ShipToAddressText       String?   @db.VarChar(500)
  ShipToWarehouseId       String?   @db.VarChar(36)
  notes                   String?   @db.Text
  CreatedBy               String?   @db.VarChar(36)
  /// DRAFT | CONFIRMED | PARTIALLY_SHIPPED | SHIPPED | DELIVERED | CANCELLED
  status                  String    @default("DRAFT") @db.VarChar(30)
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @default(now()) @updatedAt

  OrderLines              SalesOrderLine[]
  ShipToAddresses         SalesOrderShipToAddress[]
  dispatches              DispatchDocket[]
  DeliveryPerformance     DeliveryPerformance[]
  StockDemand             StockDemandByOrder[]
  CreditNotes             SalesOrderCreditNote[]

  @@index([companyId])
  @@index([OrderNumber])
  @@index([status])
  @@index([CustomerId])
  @@map("sales_order")
}

/// Sales Order line items
model SalesOrderLine {
  id                  String      @id @default(uuid())
  SalesOrderId        String
  companyId           String?
  LineNo              Int
  ItemId              String?     @db.VarChar(36)
  /// GOODS | SERVICES | DIGITAL
  ItemType            String?     @db.VarChar(20)
  description         String?     @db.VarChar(500)
  OrderedQty          Decimal     @default(0) @db.Decimal(18, 4)
  InvoicedQty         Decimal     @default(0) @db.Decimal(18, 4)
  UnitOfMeasure       String?     @db.VarChar(20)
  SalePriceSnapshot   Decimal?    @db.Decimal(18, 4)
  /// PERCENTAGE | FIXED
  DiscountType        String?     @db.VarChar(15)
  DiscountValue       Decimal?    @db.Decimal(18, 4)
  OrderedWeight       Decimal?    @db.Decimal(18, 4)
  taxRate             Decimal?    @db.Decimal(5, 2)
  taxAmount           Decimal?    @db.Decimal(18, 4)
  lineTotal           Decimal?    @db.Decimal(18, 4)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @default(now()) @updatedAt
  SalesOrder          SalesOrder  @relation(fields: [SalesOrderId], references: [id], onDelete: Cascade, map: "SalesOrderLine_SalesOrderId_fkey")
  dispatchLines       DispatchDocketLine[]
  creditNoteItems     SalesOrderCreditNoteItem[]

  @@index([companyId], map: "SalesOrderLine_companyId_idx")
  @@index([SalesOrderId], map: "SalesOrderLine_SalesOrderId_idx")
  @@map("sales_order_line")
}

/// Ship-to addresses associated with a sales order
model SalesOrderShipToAddress {
  id              String     @id @default(uuid())
  SalesOrderId    String
  label           String?    @db.VarChar(100)
  addressLine1    String?    @db.VarChar(200)
  addressLine2    String?    @db.VarChar(200)
  city            String?    @db.VarChar(100)
  region          String?    @db.VarChar(100)
  country         String?    @db.VarChar(50)
  postalCode      String?    @db.VarChar(20)
  contactName     String?    @db.VarChar(100)
  contactPhone    String?    @db.VarChar(30)
  isDefault       Boolean    @default(false)
  createdAt       DateTime   @default(now())

  SalesOrder      SalesOrder @relation(fields: [SalesOrderId], references: [id], onDelete: Cascade)

  @@index([SalesOrderId])
  @@map("sales_order_ship_to_address")
}

/// Dispatch Docket — one docket per shipment against a sales order
model DispatchDocket {
  id                        String    @id @default(uuid())
  SalesOrderId              String
  companyId                 String?
  DispatchNumber            String    @db.VarChar(50)
  DispatchDate              DateTime  @default(now())
  DispatchFromWarehouseId   String?   @db.VarChar(36)
  ShipToAddressId           String?   @db.VarChar(36)
  notes                     String?   @db.Text
  CreatedBy                 String?   @db.VarChar(36)
  /// DRAFT | CONFIRMED | POSTED | DELIVERED | CANCELLED
  status                    String    @default("DRAFT") @db.VarChar(30)
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @default(now()) @updatedAt

  SalesOrder                SalesOrder           @relation(fields: [SalesOrderId], references: [id], onDelete: Cascade)
  DispatchLines             DispatchDocketLine[]
  DeliveryPerformance       DeliveryPerformance[]
  StockDemand               StockDemandByOrder[]
  invoices                  Invoice[]

  @@index([SalesOrderId])
  @@index([companyId])
  @@index([status])
  @@index([DispatchNumber])
  @@map("dispatch_docket")
}

/// Dispatch Docket line items — what was actually shipped
model DispatchDocketLine {
  id                      String          @id @default(uuid())
  DispatchDocketId        String
  SalesOrderLineId        String?
  LineNo                  Int
  ItemId                  String?         @db.VarChar(36)
  description             String?         @db.VarChar(500)
  DispatchedQty           Decimal         @default(0) @db.Decimal(18, 4)
  OrderedQtyAtDispatch    Decimal?        @db.Decimal(18, 4)
  VarianceQty             Decimal         @default(0) @db.Decimal(18, 4)
  VarianceReason          String?         @db.VarChar(200)
  UnitWeight              Decimal?        @db.Decimal(18, 4)
  UnitCubic               Decimal?        @db.Decimal(18, 4)
  companyId               String?         @db.VarChar(36)
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @default(now()) @updatedAt

  DispatchDocket          DispatchDocket  @relation(fields: [DispatchDocketId], references: [id], onDelete: Cascade)
  SalesOrderLine          SalesOrderLine? @relation(fields: [SalesOrderLineId], references: [id])

  @@index([DispatchDocketId])
  @@index([SalesOrderLineId])
  @@index([ItemId])
  @@map("dispatch_docket_line")
}

/// DIFOT delivery performance — one row per sales order
model DeliveryPerformance {
  id                    String          @id @default(uuid())
  companyId             String?
  SalesOrderId          String
  DispatchDocketId      String?
  PromisedDeliveryDate  DateTime?
  ActualDeliveryDate    DateTime?
  IsDeliveredInFull     Boolean         @default(false)
  IsDeliveredOnTime     Boolean         @default(false)
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @default(now()) @updatedAt

  SalesOrder            SalesOrder      @relation(fields: [SalesOrderId], references: [id], onDelete: Cascade)
  DispatchDocket        DispatchDocket? @relation(fields: [DispatchDocketId], references: [id])

  @@index([SalesOrderId])
  @@index([companyId])
  @@map("delivery_performance")
}

/// Stock demand by order — tracks reserved/demanded stock per order and dispatch
model StockDemandByOrder {
  id                    String          @id @default(uuid())
  companyId             String?
  warehouseId           String?         @db.VarChar(36)
  itemId                String?         @db.VarChar(36)
  /// ORDER | TRANSFER | PURCHASE_RETURN
  sourceType            String          @default("ORDER") @db.VarChar(20)
  sourceOrderId         String?         @db.VarChar(36)
  sourceDispatchId      String?         @db.VarChar(36)
  salesOrderId          String?
  dispatchDocketId      String?
  demandedQty           Decimal         @default(0) @db.Decimal(18, 4)
  remainingQtyToInvoice Decimal         @default(0) @db.Decimal(18, 4)
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @default(now()) @updatedAt

  SalesOrder            SalesOrder?     @relation(fields: [salesOrderId], references: [id])
  DispatchDocket        DispatchDocket? @relation(fields: [dispatchDocketId], references: [id])

  @@index([companyId])
  @@index([salesOrderId])
  @@index([dispatchDocketId])
  @@index([itemId])
  @@map("stock_demand_by_order")
}

/// Credit notes raised against a sales order (not against an invoice)
model SalesOrderCreditNote {
  id              String    @id @default(uuid())
  SalesOrderId    String
  companyId       String?
  CreditNoteNo    String    @db.VarChar(50)
  reason          String?   @db.VarChar(500)
  totalAmount     Decimal   @default(0) @db.Decimal(18, 2)
  currencyCode    String    @default("ETB") @db.VarChar(3)
  /// DRAFT | APPROVED | APPLIED | CANCELLED
  status          String    @default("DRAFT") @db.VarChar(20)
  issuedAt        DateTime  @default(now())
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @default(now()) @updatedAt

  SalesOrder      SalesOrder               @relation(fields: [SalesOrderId], references: [id], onDelete: Cascade)
  items           SalesOrderCreditNoteItem[]

  @@index([SalesOrderId])
  @@index([companyId])
  @@map("sales_order_credit_note")
}

/// Line items for a sales order credit note
model SalesOrderCreditNoteItem {
  id                  String               @id @default(uuid())
  CreditNoteId        String
  companyId           String?
  SalesOrderLineId    String?
  description         String?              @db.VarChar(500)
  qty                 Decimal              @default(0) @db.Decimal(18, 4)
  unitPrice           Decimal              @default(0) @db.Decimal(18, 4)
  amount              Decimal              @default(0) @db.Decimal(18, 2)
  createdAt           DateTime             @default(now())
  company             Company?             @relation(fields: [companyId], references: [id], map: "SalesOrderCreditNoteItem_companyId_fkey")
  CreditNote          SalesOrderCreditNote @relation(fields: [CreditNoteId], references: [id], onDelete: Cascade)
  SalesOrderLine      SalesOrderLine?      @relation(fields: [SalesOrderLineId], references: [id])

  @@index([companyId], map: "SalesOrderCreditNoteItem_companyId_idx")
  @@index([CreditNoteId])
  @@map("sales_order_credit_note_item")
}

// ─────────────────────────────────────────────────────────────────────────────
// IFRS 15 / 16 / IAS 38 — Compliance Engine (additive, go-live blockers #52–#59)
// ─────────────────────────────────────────────────────────────────────────────

enum ObligationBasis {
  POINT_IN_TIME
  OVER_TIME_COST
  OVER_TIME_OUTPUT
}

enum ObligationStatus {
  UNSATISFIED
  PARTIALLY_SATISFIED
  SATISFIED
}

enum ScheduleRowStatus {
  PENDING
  RECOGNISED
  DEFERRED
  REVERSED
}

enum IfrsStandardCode {
  IFRS15
  IFRS16
  IAS38
}

enum LeaseModificationType {
  SCOPE_INCREASE
  SCOPE_DECREASE
  RATE_CHANGE
  TERM_CHANGE
  SEPARATE_NEW_LEASE
}

enum ModificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SoftwarePhase {
  RESEARCH
  DEVELOPMENT
  POST_IMPLEMENTATION
}

enum SoftwareWorkPhase {
  RESEARCH
  DEVELOPMENT
  CONFIGURATION
  CUSTOMIZATION
}

enum SoftwareAssetStatus {
  ACTIVE
  FULLY_AMORTIZED
  IMPAIRED
}

enum ClassificationStatus {
  PENDING
  CAPITALIZE
  EXPENSE
}

enum CapDecisionStatus {
  APPROVED
  REJECTED
}

enum AmortRowStatus {
  SCHEDULED
  POSTED
}

model ContractSnapshot {
  id               String                @id @default(uuid())
  contractRef      String
  version          Int                   @default(1)
  companyId        String
  invoiceId        String?
  transactionPrice Decimal               @db.Decimal(15, 2)
  snapshotJson     Json
  createdAt        DateTime              @default(now())

  obligations      PerformanceObligation[]
  allocations      RevenueAllocation[]
  scheduleRows     RecognitionScheduleRow[]
  ifrsGlJournals   IfrsGlJournal[]

  @@index([contractRef, companyId])
  @@index([invoiceId])
  @@map("contract_snapshot")
}

model PerformanceObligation {
  id                String               @id @default(uuid())
  snapshotId        String
  description       String
  sspAmount         Decimal              @db.Decimal(15, 2)
  allocatedAmount   Decimal              @db.Decimal(15, 2)
  satisfactionBasis ObligationBasis
  isDistinct        Boolean              @default(true)
  status            ObligationStatus     @default(UNSATISFIED)
  createdAt         DateTime             @default(now())

  snapshot          ContractSnapshot      @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  allocations       RevenueAllocation[]
  scheduleRows      RecognitionScheduleRow[]

  @@index([snapshotId])
  @@map("performance_obligation")
}

model RevenueAllocation {
  id               String                @id @default(uuid())
  snapshotId       String
  obligationId     String
  sspBasis         String
  totalSsp         Decimal               @db.Decimal(15, 2)
  allocatedAmount  Decimal               @db.Decimal(15, 2)
  allocationMethod String                @default("PROPORTIONAL_SSP")
  createdAt        DateTime              @default(now())

  snapshot         ContractSnapshot       @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  obligation       PerformanceObligation @relation(fields: [obligationId], references: [id], onDelete: Cascade)
  scheduleRows     RecognitionScheduleRow[]
  ifrsGlJournals   IfrsGlJournal[]

  @@index([snapshotId])
  @@index([obligationId])
  @@map("revenue_allocation")
}

model RecognitionScheduleRow {
  id               String             @id @default(uuid())
  snapshotId       String
  obligationId     String
  allocationId     String
  period           String             // YYYY-MM
  scheduledAmount  Decimal            @db.Decimal(15, 2)
  recognisedAmount Decimal            @db.Decimal(15, 2) @default(0)
  deferredAmount   Decimal            @db.Decimal(15, 2)
  status           ScheduleRowStatus  @default(PENDING)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  snapshot         ContractSnapshot       @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  obligation       PerformanceObligation  @relation(fields: [obligationId], references: [id], onDelete: Cascade)
  allocation       RevenueAllocation      @relation(fields: [allocationId], references: [id], onDelete: Cascade)
  ifrsGlJournals   IfrsGlJournal[]

  @@unique([snapshotId, obligationId, period])
  @@index([period, status])
  @@map("recognition_schedule_row")
}

model IfrsGlJournal {
  id                       String            @id @default(uuid())
  standard                 IfrsStandardCode
  journalEntryId           String
  contractVersionSnapshotId String?
  allocationTableId        String?
  scheduleRowId            String?
  sourceEventId            String?
  sourceEventType          String?
  leaseId                  String?
  softwareAssetId          String?
  companyId                String
  createdAt                DateTime          @default(now())

  snapshot     ContractSnapshot?       @relation(fields: [contractVersionSnapshotId], references: [id])
  allocation   RevenueAllocation?      @relation(fields: [allocationTableId], references: [id])
  scheduleRow  RecognitionScheduleRow? @relation(fields: [scheduleRowId], references: [id])

  @@index([journalEntryId])
  @@index([leaseId])
  @@index([softwareAssetId])
  @@index([companyId])
  @@map("ifrs_gl_journal")
}

model LeaseModification {
  id                     String                @id @default(uuid())
  leaseId                String
  effectiveDate          DateTime
  modificationType       LeaseModificationType
  classificationRationale String
  oldLiability           Decimal               @db.Decimal(15, 2)
  newLiability           Decimal               @db.Decimal(15, 2)
  oldRouAsset            Decimal               @db.Decimal(15, 2)
  newRouAsset            Decimal               @db.Decimal(15, 2)
  approverId             String?
  status                 ModificationStatus    @default(PENDING)
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  remeasurementJournals  RemeasurementJournal[]

  @@index([leaseId])
  @@map("lease_modification")
}

model RemeasurementJournal {
  id               String            @id @default(uuid())
  modificationId   String
  journalEntryId   String
  liabilityDelta   Decimal           @db.Decimal(15, 2)
  rouAssetDelta    Decimal           @db.Decimal(15, 2)
  createdAt        DateTime          @default(now())

  modification     LeaseModification @relation(fields: [modificationId], references: [id], onDelete: Cascade)

  @@index([modificationId])
  @@index([journalEntryId])
  @@map("remeasurement_journal")
}

model SoftwareAsset {
  id                    String                @id @default(uuid())
  code                  String
  name                  String
  phase                 SoftwarePhase
  cost                  Decimal               @db.Decimal(15, 2)
  usefulLifeMonths      Int
  amortizationStartDate DateTime
  carryingAmount        Decimal               @db.Decimal(15, 2)
  status                SoftwareAssetStatus   @default(ACTIVE)
  companyId             String
  createdBy             String
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  workItems             SoftwareWorkItem[]
  amortizationRows      SoftwareAmortizationRow[]

  @@unique([code, companyId])
  @@index([companyId, status])
  @@map("software_asset")
}

model SoftwareWorkItem {
  id                   String                   @id @default(uuid())
  assetId              String?
  description          String
  phase                SoftwareWorkPhase
  cost                 Decimal                  @db.Decimal(15, 2)
  classificationStatus ClassificationStatus     @default(PENDING)
  evidenceRefs         Json
  companyId            String
  createdAt            DateTime                 @default(now())

  asset                SoftwareAsset?           @relation(fields: [assetId], references: [id])
  capitalizationDecision CapitalizationDecision?

  @@index([companyId, classificationStatus])
  @@map("software_work_item")
}

model CapitalizationDecision {
  id           String               @id @default(uuid())
  workItemId   String               @unique
  approverId   String
  reasonCode   String
  evidenceRefs Json
  status       CapDecisionStatus    @default(APPROVED)
  decidedAt    DateTime             @default(now())

  workItem     SoftwareWorkItem     @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  @@map("capitalization_decision")
}

model SoftwareAmortizationRow {
  id                String          @id @default(uuid())
  softwareAssetId   String
  period            String          // YYYY-MM
  openingCarrying   Decimal         @db.Decimal(15, 2)
  amortizationCharge Decimal        @db.Decimal(15, 2)
  closingCarrying   Decimal         @db.Decimal(15, 2)
  journalEntryId    String?
  status            AmortRowStatus  @default(SCHEDULED)
  createdAt         DateTime        @default(now())

  softwareAsset     SoftwareAsset   @relation(fields: [softwareAssetId], references: [id], onDelete: Cascade)

  @@unique([softwareAssetId, period])
  @@index([period, status])
  @@map("software_amortization_row")
}

enum ProjectionEngine {
  PEACHTREE
  SIGTAX
  IFRS
}

enum ReconciliationAdjustmentCode {
  NON_DEDUCTIBLE_EXPENSE
  LEASE_ROU
  IFRS15_ADJ
  IFRS16_ADJ
  IAS38_ADJ
  INTERCO_ELIMINATION
  TAX_TIMING_DIFF
  DEFERRED_TAX
  NCI_ALLOCATION
  DEFAULT
}

enum ReconciliationPeriodStatus {
  OPEN
  IN_PROGRESS
  PENDING_APPROVAL
  COMPLETED
  LOCKED
}

enum ReconciliationReportStatus {
  DRAFT
  FINAL
  APPROVED
}

enum BankFeedStatus {
  CONNECTED
  DISCONNECTED
  ERROR
  PENDING_AUTH
}

enum BankFeedProvider {
  PLAID
  GOCARDLESS
  MANUAL
}

model PeachtreeProjectionJournal {
  id                       String                     @id @default(uuid())
  canonicalJournalEntryId  String
  companyId                String
  projectionEngine         ProjectionEngine           @default(PEACHTREE)
  adjustedDebit            Decimal                    @db.Decimal(15, 2)
  adjustedCredit           Decimal                    @db.Decimal(15, 2)
  reconciliationAdjustmentCode ReconciliationAdjustmentCode @default(DEFAULT)
  reconciledAt             DateTime                   @default(now())

  @@index([canonicalJournalEntryId])
  @@index([companyId])
  @@index([reconciledAt])
  @@map("peachtree_projection_journal")
}

model SigtaxProjectionJournal {
  id                       String                     @id @default(uuid())
  canonicalJournalEntryId  String
  companyId                String
  projectionEngine         ProjectionEngine           @default(SIGTAX)
  adjustedDebit            Decimal                    @db.Decimal(15, 2)
  adjustedCredit           Decimal                    @db.Decimal(15, 2)
  reconciliationAdjustmentCode ReconciliationAdjustmentCode @default(DEFAULT)
  reconciledAt             DateTime                   @default(now())

  @@index([canonicalJournalEntryId])
  @@index([companyId])
  @@index([reconciledAt])
  @@map("sigtax_projection_journal")
}

model IfrsReportingBalance {
  id                  String    @id @default(uuid())
  companyId           String
  accountCode         String
  accountName         String
  accountType         String
  period              String    // YYYY-MM
  openingBalance      Decimal   @db.Decimal(15, 2)
  periodDebit         Decimal   @db.Decimal(15, 2)
  periodCredit        Decimal   @db.Decimal(15, 2)
  closingBalance      Decimal   @db.Decimal(15, 2)
  projectionEngine    ProjectionEngine @default(IFRS)
  reconciledAt        DateTime  @default(now())

  @@unique([companyId, accountCode, period])
  @@index([companyId, period])
  @@map("ifrs_reporting_balance")
}

/// ─── Device Control Governance (org-wide maker-checker) ─────────────────────
/// Enforced org-wide device control policy per company + category. A company
/// has at most one enforced policy per category; it is replaced (and broadcast
/// to every device) only after a maker-checker change request is approved.
model DeviceControlPolicy {
  id              String                @id @default(uuid())
  companyId       String
  category        DeviceControlCategory
  /// Monotonic version per company+category, incremented on each enforced change.
  version         Int                   @default(1)
  /// Enforced settings (JSON string). Shape depends on category — see @ovds/shared.
  settings        String                @db.LongText
  /// Change request that produced this enforced version.
  changeRequestId String?
  enforcedAt      DateTime              @default(now())
  enforcedById    String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@unique([companyId, category])
  @@index([companyId])
  @@map("device_control_policy")
}

/// Maker-checker change request for an org-wide device control policy.
model DeviceControlChangeRequest {
  id                String                    @id @default(uuid())
  companyId         String
  category          DeviceControlCategory
  /// Proposed settings (JSON string) enforced on approval.
  settings          String                    @db.LongText
  /// Human-readable business justification (required for audit).
  reason            String?                   @db.Text
  status            DeviceControlChangeStatus @default(DRAFT)
  /// Maker (submitter). Cannot be the checker (segregation of duties).
  makerId           String?
  makerName         String?
  submittedAt       DateTime?
  /// Checker (approver/rejecter).
  checkerId         String?
  checkerName       String?
  reviewedAt        DateTime?
  reviewNote        String?                   @db.Text
  /// Set when approved+applied: id of the resulting DeviceControlPolicy.
  resultingPolicyId String?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  @@index([companyId, status])
  @@index([companyId, category])
  @@map("device_control_change_request")
}

enum DeviceControlCategory {
  ENCRYPTION
  APP_PERMISSION
  NETWORK_POLICY
  ENFORCEMENT_RULE
}

enum DeviceControlChangeStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  APPLIED
  CANCELLED
}

// ═══════════════════════════════════════════════════════════════════════════════
// PROCUREMENT & ACCOUNTS PAYABLE GAP-FIX MODELS
// Vendor Ledger, L/C, Landed Cost Allocation, Import Logistics
// ═══════════════════════════════════════════════════════════════════════════════

// ── Vendor Ledger ──────────────────────────────────────────────────────────────
/// Transaction-level ledger per vendor. Every AP-affecting event creates a ledger
/// entry so vendors can be issued a full statement (like a bank statement).

model VendorLedger {
  id           String    @id @default(uuid())
  companyId    String?
  vendorId     String
  vendorName   String    @db.VarChar(200)
  /// BILL | PAYMENT | DEBIT_NOTE | CREDIT_NOTE | WHT | ADJUSTMENT | OPENING_BALANCE
  entryType    String    @default("BILL") @db.VarChar(30)
  reference    String?   @db.VarChar(100)
  description  String?   @db.VarChar(500)
  /// Debit = amount the vendor owes us (or we owe the vendor)
  debit        Decimal   @default(0) @db.Decimal(18, 2)
  /// Credit = amount we paid the vendor (or they paid us)
  credit       Decimal   @default(0) @db.Decimal(18, 2)
  /// Running balance after this entry
  balance      Decimal   @default(0) @db.Decimal(18, 2)
  currencyCode String    @default("ETB") @db.VarChar(3)
  currencyRate Decimal   @default(1.0) @db.Decimal(10, 4)
  linkedBillId String?
  linkedPaymentId String?
  linkedJournalEntryId String? @db.VarChar(36)
  entryDate    DateTime  @default(now())
  createdBy    String?   @db.VarChar(100)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now()) @updatedAt

  @@index([companyId])
  @@index([vendorId])
  @@index([entryDate])
  @@index([companyId, vendorId])
  @@map("vendor_ledger")
}

// ── Letter of Credit (L/C) ─────────────────────────────────────────────────────
/// Import financing instrument issued by the importer's bank in favour of the
/// supplier/exporter. Tracks issuance, amendments, utilisation, and expiry.

model LetterOfCredit {
  id                  String    @id @default(uuid())
  companyId           String?
  /// Unique L/C reference number assigned by issuing bank
  lcNumber            String    @unique @db.VarChar(100)
  /// DRAFT | ISSUED | AMENDED | UTILISED | EXPIRED | CANCELLED
  status              String    @default("DRAFT") @db.VarChar(20)
  vendorId            String?
  vendorName          String?   @db.VarChar(200)
  purchaseOrderId     String?
  purchaseOrderNumber String?   @db.VarChar(100)
  /// Issuing bank (importer's bank)
  issuingBank         String    @db.VarChar(200)
  issuingBankBranch   String?   @db.VarChar(200)
  issuingBankCountry  String?   @db.VarChar(3)
  /// Advising bank (supplier's bank)
  advisingBank        String?   @db.VarChar(200)
  advisingBankBranch  String?   @db.VarChar(200)
  advisingBankCountry String?   @db.VarChar(3)
  /// Amount and currency
  amount              Decimal   @default(0) @db.Decimal(18, 2)
  currencyCode        String    @default("USD") @db.VarChar(3)
  /// Dates
  issueDate           DateTime?
  expiryDate          DateTime?
  latestShipmentDate  DateTime?
  /// Shipment details
  partialShipments    String?   @db.VarChar(50)
  transshipmentAllowed Boolean @default(false)
  portOfLoading       String?   @db.VarChar(100)
  portOfDischarge     String?   @db.VarChar(100)
  incoterm            String?   @db.VarChar(20)
  /// Commodity / HS code
  goodsDescription    String?   @db.VarChar(500)
  hsCode              String?   @db.VarChar(20)
  /// Amendment tracking
  amendmentCount      Int       @default(0)
  amendmentHistory    String?   @db.LongText
  /// Linked customs declarations
  customsDeclarationIds String? @db.LongText
  /// Linked shipments
  shipmentIds         String?   @db.LongText
  notes               String?   @db.Text
  createdBy           String?   @db.VarChar(100)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @default(now()) @updatedAt

  @@index([companyId])
  @@index([vendorId])
  @@index([status])
  @@index([expiryDate])
  @@map("letter_of_credit")
}

// ── Landed Cost Allocation ─────────────────────────────────────────────────────
/// Allocates import-related costs (customs duty, freight, insurance, etc.) to
/// specific inventory items or purchase orders for accurate IAS 2 costing.

model LandedCostAllocation {
  id                  String    @id @default(uuid())
  companyId           String?
  purchaseOrderId     String?
  purchaseOrderNumber String?   @db.VarChar(100)
  billId              String?
  customsDeclarationId String?
  /// Total landed cost for this allocation
  totalLandedCost     Decimal   @default(0) @db.Decimal(18, 2)
  /// Component breakdown
  cifValue            Decimal   @default(0) @db.Decimal(18, 2)
  freightCost         Decimal   @default(0) @db.Decimal(18, 2)
  insuranceCost       Decimal   @default(0) @db.Decimal(18, 2)
  customsDuty         Decimal   @default(0) @db.Decimal(18, 2)
  exciseDuty          Decimal   @default(0) @db.Decimal(18, 2)
  importSurtax        Decimal   @default(0) @db.Decimal(18, 2)
  vatOnImport         Decimal   @default(0) @db.Decimal(18, 2)
  advanceBit          Decimal   @default(0) @db.Decimal(18, 2)
  otherCosts          Decimal   @default(0) @db.Decimal(18, 2)
  /// Allocation method: WEIGHT | VOLUME | VALUE | QUANTITY
  allocationMethod    String    @default("QUANTITY") @db.VarChar(20)
  /// Number of items/line items this was allocated across
  allocatedAcross     Int       @default(0)
  /// Cost per unit after allocation
  costPerUnit         Decimal   @default(0) @db.Decimal(18, 4)
  /// Exchange rate used for CIF conversion
  exchangeRate        Decimal   @default(1.0) @db.Decimal(10, 4)
  currencyCode        String    @default("USD") @db.VarChar(3)
  notes               String?   @db.Text
  createdBy           String?   @db.VarChar(100)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @default(now()) @updatedAt

  @@index([companyId])
  @@index([purchaseOrderId])
  @@index([billId])
  @@index([customsDeclarationId])
  @@map("landed_cost_allocation")
}

// ── Import Shipment ────────────────────────────────────────────────────────────
/// Tracks inbound import shipments from supplier to port/warehouse.
/// Links to L/C, CustomsDeclaration, PurchaseOrder, and Bill.

model ImportShipment {
  id                  String    @id @default(uuid())
  companyId           String?
  /// Shipment reference (e.g. HBL, AWB, tracking number)
  shipmentReference   String    @db.VarChar(100)
  /// FREIGHT_FORWARDER | SUPPLIER | BANK | OTHER
  shipmentType        String    @default("FREIGHT_FORWARDER") @db.VarChar(30)
  /// Linked documents
  lcId                String?
  poId                String?
  customsDeclarationId String?
  billId              String?
  /// Logistics parties
  freightForwarder    String?   @db.VarChar(200)
  shippingLine        String?   @db.VarChar(200)
  /// Route
  portOfLoading       String?   @db.VarChar(100)
  portOfDischarge     String?   @db.VarChar(100)
  finalDestination    String?   @db.VarChar(100)
  /// Vessel / flight / truck
  vesselFlight        String?   @db.VarChar(100)
  /// Dates
  etd                 DateTime?
  eta                 DateTime?
  actualArrival       DateTime?
  clearedAt           DateTime?
  /// Weight and volume
  grossWeight         Decimal?  @db.Decimal(18, 2)
  netWeight           Decimal?  @db.Decimal(18, 2)
  volume              Decimal?  @db.Decimal(18, 2)
  /// Container info
  containerNumber     String?   @db.VarChar(100)
  containerType       String?   @db.VarChar(50)
  sealNumber          String?   @db.VarChar(100)
  /// Status tracking
  status              String    @default("BOOKED") @db.VarChar(30)
  /// DRAFT | BOOKED | IN_TRANSIT | ARRIVED | CLEARED | DELIVERED | CANCELLED
  trackingEvents      String?   @db.LongText
  notes               String?   @db.Text
  createdBy           String?   @db.VarChar(100)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @default(now()) @updatedAt

  @@index([companyId])
  @@index([status])
  @@index([eta])
  @@index([lcId])
  @@index([poId])
  @@map("import_shipment")
}

