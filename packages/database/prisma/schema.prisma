/// ═══════════════════════════════════════════════════════════════════════════════════
/// SETTINGS MODULE — Ovds-style modular configuration system
/// Categories, groups, and typed key/value settings stored per-company or globally.
/// Replaces ad-hoc systemsetting rows for structured application settings.
/// ═══════════════════════════════════════════════════════════════════════════════════

model SettingCategory {
  id          String   @id @default(uuid())
  key         String   @unique @db.VarChar(50)
  name        String   @db.VarChar(100)
  description String?  @db.VarChar(200)
  icon        String?  @db.VarChar(50)
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  groups      SettingGroup[]
  settings    Setting[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([sortOrder])
  @@map("setting_category")
}

model SettingGroup {
  id          String   @id @default(uuid())
  categoryId  String
  key         String   @db.VarChar(50)
  name        String   @db.VarChar(100)
  description String?  @db.VarChar(200)
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  category    SettingCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  settings    Setting[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([categoryId, key])
  @@index([categoryId])
  @@map("setting_group")
}

model Setting {
  id             String   @id @default(uuid())
  key            String   @unique @db.VarChar(100)
  value          String   @db.LongText
  type           String   @default("text") @db.VarChar(20)
  categoryId     String
  groupId        String?
  companyId      String?
  defaultValue   String?  @db.LongText
  options        String?  @db.LongText
  isRequired     Boolean  @default(false)
  isGlobal       Boolean  @default(false)
  isEncrypted    Boolean  @default(false)
  sortOrder      Int      @default(0)
  placeholder    String?  @db.VarChar(200)
  hint           String?  @db.VarChar(500)
  module         String?  @db.VarChar(50)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  category       SettingCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  group          SettingGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  company        Company? @relation("CompanySettings", fields: [companyId], references: [id], onDelete: Cascade)

  @@index([categoryId])
  @@index([groupId])
  @@index([companyId])
  @@index([module])
  @@map("setting")
}

model systemsetting {
  id        String   @id
  key       String   @unique(map: "SystemSetting_key_key")
  value     String   @db.LongText
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("systemsetting")
}

/// Legacy key-value settings table.
/// Deprecated in favor of Setting + SettingValue modular system.
/// Retained for backward compatibility during migration period.
/// New code should use Setting (definitions) and SettingValue (KV store) instead.

/// Canonical application modules (composable business capabilities).
/// Each module represents a functional area that can be enabled per-company.
model Module {
  id          String   @id @default(uuid())
  key         String   @unique @db.VarChar(50)
  name        String   @db.VarChar(100)
  description String?  @db.VarChar(200)
  icon        String?  @db.VarChar(50)
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  isCore      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  companyModules CompanyModule[]

  @@index([sortOrder])
  @@map("module")
}

/// Per-company module enablement + module-specific settings.
/// Replaces ad-hoc module toggles scattered in systemsetting.
model CompanyModule {
  id          String    @id @default(uuid())
  companyId   String
  moduleKey   String    @db.VarChar(50)
  isEnabled   Boolean   @default(false)
  settings    String?   @db.LongText
  /// Set when isEnabled transitions to true; cleared on disable.
  activatedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  module   Module   @relation(fields: [moduleKey], references: [key], onDelete: Cascade)
  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, moduleKey])
  @@index([companyId])
  @@index([moduleKey])
  @@map("company_module")
}

