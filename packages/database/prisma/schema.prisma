  pfEmployeeRate       Decimal               @default(0.000000000000000000000000000000)
  pfEmployerRate       Decimal               @default(0.000000000000000000000000000000)
  pfSubscriptionType   String?
  pfmsNumber           String?
  businessType         EmployeeBusinessType?
  companyId            String?
  lastTransferDate     DateTime?
  subsidiary           String?
  transferReason       String?
  phone                String?               @db.VarChar(50)
  userId               String?               @unique
  arrearConfig         ArrearConfig[]
  attendance           Attendance[]
  biometricData        BiometricData[]
  deduction            Deduction[]
  company              Company?              @relation(fields: [companyId], references: [id], map: "Employee_companyId_fkey")
  department           Department?           @relation(fields: [departmentId], references: [id], map: "Employee_departmentId_fkey")
  shift                Shift?                @relation(fields: [shiftId], references: [id], map: "Employee_shiftId_fkey")
  leave                Leave[]
  loanRequest          LoanRequest[]
