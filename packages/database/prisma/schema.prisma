generator client {
  // Prisma 7 uses the WASM client engine — binaryTargets are not needed.
  provider = "prisma-client-js"
}

/// zod-prisma-types — generates Zod schemas for every Prisma model and enum.
/// Output goes to packages/contracts/src/prisma-zod/ (browser-safe, no Node deps).
/// Run: npm run db:generate:zod
generator zod {
  provider                         = "zod-prisma-types"
  output                           = "../../contracts/src/prisma-zod"
  createInputTypes                 = true
  createModelTypes                 = true
  addInputTypeValidation           = true
  addIncludeType                   = false
  addSelectType                    = false
  useMultipleFiles                 = false
  writeBarrelFiles                 = true
  createRelationValuesTypes        = false
  createPartialTypes               = true
  useDefaultValidators             = false
  coerceDate                       = false
  writeNullishInModelTypes         = false
}

// ─────────────────────────────────────────────────────────────────────────────┐
// FINANCIAL CORE — Normalized Double-Entry Accounting Engine                  │
// Ovds SaaS double-entry ledger architecture. Balanced by design.            │
//                                                                              │
// Core models: Company → Account (Chart of Accounts) → JournalEntry           │
//              → LedgerEntry (immutable double-entry posts).                   │
//                                                                              │
// Existing OVDS models already implement this pattern:                        │
//   • Company (tenant root, currencyCode, settings)                           │
//   • Account (code, type, parentId, isLeaf, allowPosting)                    │
//   • JournalEntry (date, description, status=POSTED, period)                 │
//   • JournalLine (debit, credit, accountId, costCenterId, taxType)           │
//   • LedgerEntry (debit, credit, accountId, journalEntryId)                  │
//   • Invoice (invoiceNumber, status: PAID/PARTIAL/OVERDUE/CANCELLED)         │
//                                                                              │
// Enforce double-entry: every financial event creates matching debit/credit    │
// journal lines so that sum(debit) == sum(credit) always.                     │
// ─────────────────────────────────────────────────────────────────────────────┘

datasource db {
  provider = "mysql"
}

model FinancialStatementTemplate {
  id           String   @id @default(uuid())
  companyId    String?
  /// BALANCE_SHEET, INCOME_STATEMENT, CASH_FLOW, NOTES
  type         String
  name         String
  /// e.g., "2024-Q1", "FY2024"
  period       String?
  isIfrs       Boolean  @default(true)
  /// Line items, formulas, IFRS refs
  templateJson String   @db.LongText
  previewHtml  String?  @db.LongText
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  company      Company? @relation(fields: [companyId], references: [id])

  @@unique([companyId, type, period])
  @@index([companyId])
  @@map("financial_statement_template")
}

model FundTransfer {
  id             String        @id @default(uuid())
  fromAccountId  String
  toAccountId    String
  amount         Decimal
  currencyCode   String        @default("ETB") @db.VarChar(3)
  /// INTERNAL | ACH | WIRE
  type           String        @default("INTERNAL")
  /// PENDING | COMPLETED | FAILED
  status         String        @default("PENDING")
  reference      String?       @db.VarChar(200)
  note           String?       @db.Text
  companyId      String?
  journalEntryId String?       @db.VarChar(36)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  company        Company?      @relation(fields: [companyId], references: [id])
  fromBankAcc    BankAccount   @relation("FromBankAcc", fields: [fromAccountId], references: [id])
  toBankAcc      BankAccount   @relation("ToBankAcc", fields: [toAccountId], references: [id])
  journalEntry   JournalEntry? @relation(fields: [journalEntryId], references: [id])

  @@index([status])
  @@index([companyId])
  @@map("fund_transfer")
}

model ExpenseClaim {
  id           String    @id @default(uuid())
  title        String    @db.VarChar(200)
  amount       Decimal   @default(0.000000000000000000000000000000)
  currencyCode String    @default("ETB")
  category     String    @db.VarChar(100)
  status       String    @default("PENDING")
  description  String?   @db.Text
  receiptUrl   String?   @db.VarChar(500)
  submittedBy  String?   @db.VarChar(100)
  approvedBy   String?   @db.VarChar(100)
  approvedAt   DateTime?
  companyId    String?
  submittedAt  DateTime  @default(now())
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status])
  @@index([companyId])
  @@map("expense_claim")
}

model PurchaseOrder {
  id               String    @id @default(uuid())
  poNumber         String    @unique @db.VarChar(100)
  vendorId         String?
  vendorName       String?   @db.VarChar(200)
  status           String    @default("DRAFT")
  totalAmount      Decimal   @default(0.000000000000000000000000000000)
  currencyCode     String    @default("ETB")
  expectedDelivery DateTime?
  notes            String?   @db.Text
  /// JSON array of line items
  items            String?   @db.LongText
  companyId        String?
  createdBy        String?   @db.VarChar(100)
  approvedBy       String?   @db.VarChar(100)
  approvedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([status])
  @@index([companyId])
  @@index([vendorId])
  @@map("purchase_order")
}

model FixedAsset {
  id                 String   @id @default(uuid())
  name               String   @db.VarChar(200)
  category           String   @db.VarChar(100)
  purchaseDate       DateTime
  purchaseCost       Decimal  @default(0.000000000000000000000000000000)
  salvageValue       Decimal  @default(0.000000000000000000000000000000)
  usefulLifeYears    Int      @default(1)
  depreciationMethod String   @default("STRAIGHT_LINE")
  status             String   @default("ACTIVE")
  location           String?  @db.VarChar(200)
  serialNumber       String?  @db.VarChar(100)
  companyId          String?
  notes              String?  @db.Text
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([status])
  @@index([companyId])
  @@map("fixed_asset")
}

model Account {
  id          String          @id @default(uuid())
  code        String
  name        String
  type        AccountType
  category    AccountCategory
  description String?
  isActive    Boolean         @default(true)
  isLeaf      Boolean         @default(true)
  allowPosting Boolean        @default(true)
  parentId    String?
  companyId   String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @default(now()) @updatedAt
  company     Company?        @relation(fields: [companyId], references: [id])
  account     Account?        @relation("AccountToAccount", fields: [parentId], references: [id], map: "Account_parentId_fkey")
  subAccounts Account[]       @relation("AccountToAccount")
  journalLine JournalLine[]
  ledgerEntries LedgerEntry[]
  budgets     Budget[]

  @@unique([code, companyId])
  @@index([companyId])
  @@index([parentId], map: "account_parentId_fkey")
  @@map("account")
}

model AdminCreatedMenuItem {
  id        String   @id @default(uuid())
  label     String   @db.VarChar(200)
  path      String   @db.VarChar(500)
  to        String?  @db.VarChar(500)
  icon      String?  @db.VarChar(100)
  parentId  String?
  parentKey String?  @db.VarChar(100)
  sortOrder Int      @default(0)
  order     Int      @default(0)
  adminId   String?  @db.VarChar(100)
  isActive  Boolean  @default(true)
  roles     String?  @db.VarChar(500)
  companyId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  company   Company? @relation(fields: [companyId], references: [id], map: "adminmenuitem_companyId_fkey")

  @@index([companyId], map: "AdminCreatedMenuItem_companyId_idx")
  @@map("admincreatedmenuitem")
}

model App {
  id          String   @id @default(uuid())
  name        String   @unique(map: "App_name_key")
  slug        String   @unique(map: "App_slug_key") @db.VarChar(100)
  description String?  @db.Text
  version     String   @default("1.0.0") @db.VarChar(20)
  category    String   @default("GENERAL") @db.VarChar(50)
  isActive    Boolean  @default(true)
  isFree      Boolean  @default(true)
  price       Decimal  @default(0.000000000000000000000000000000)
  rating      Decimal  @default(0.000000000000000000000000000000)
  downloads   Int      @default(0)
  developer   String?  @db.VarChar(200)
  downloadUrl String?  @db.VarChar(500)
  iconUrl     String?  @db.VarChar(500)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
  review        Review[]
  roleAppAccess RoleAppAccess[]
  userApp       UserApp[]
  installations AppInstallation[]

  @@map("app")
}

enum AppAccessLevel {
  NONE
  READ
  WRITE
  ADMIN
}

model RoleAppAccess {
  id          String          @id @default(uuid())
  role        String          @db.VarChar(50)
  appId       String
  accessLevel AppAccessLevel  @default(READ)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  app         App             @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@unique([role, appId])
  @@index([role])
  @@index([appId])
  @@map("role_app_access")
}

model UserApp {
  id          String          @id @default(uuid())
  userId      String
  appId       String?
  name        String          @db.VarChar(100)
  accessLevel AppAccessLevel  @default(READ)
  grantedBy   String?         @db.VarChar(100)
  grantedAt   DateTime        @default(now())
  key         String?         @unique @db.VarChar(255)
  keyPrefix   String?         @db.VarChar(10)
  lastUsedAt  DateTime?
  createdAt   DateTime        @default(now()) @db.Timestamp(6)
  updatedAt   DateTime        @default(now()) @updatedAt @db.Timestamp(6)
  user        User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  app         App?             @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@unique([userId, appId])
  @@index([userId])
  @@index([appId])
  @@map("user_app")
}

model ArrearConfig {
  id           String     @id @default(uuid())
  name         String     @unique(map: "ArrearConfig_name_key")
  arrearTypeId String
  employeeId   String?
  fromDate     DateTime
  toDate       DateTime
  remarks      String?
  status       String     @default("GENERATED")
  amount       Decimal    @default(0.000000000000000000000000000000)
  approvedBy   String?
  approvedAt   DateTime?
  paymentType  String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @default(now()) @updatedAt
  arrearType   ArrearType @relation(fields: [arrearTypeId], references: [id], map: "ArrearConfig_arrearTypeId_fkey")
  employee     Employee?  @relation(fields: [employeeId], references: [id], map: "ArrearConfig_employeeId_fkey")

  @@index([arrearTypeId], map: "ArrearConfig_arrearTypeId_idx")
  @@index([employeeId], map: "arrearconfig_employeeId_fkey")
  @@map("arrearconfig")
}

model ArrearType {
  id           String         @id @default(uuid())
  name         String         @unique(map: "ArrearType_name_key")
  description  String?
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @default(now()) @updatedAt
  arrearConfig ArrearConfig[]

  @@map("arreartype")
}

model Attendance {
  id            String           @id @default(uuid())
  employeeId    String
  checkIn       DateTime         @default(now())
  checkOut      DateTime?
  method        AttendanceMethod
  status        AttendanceStatus
  latitude      Float?
  longitude     Float?
  deviceInfo    String?
  createdAt     DateTime         @default(now())
  verified      Boolean          @default(false)
  verifiedBy    String?
  overtimeHours Float?
  employee      Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade, map: "Attendance_employeeId_fkey")

  @@index([checkIn], map: "Attendance_checkIn_idx")
  @@index([employeeId], map: "Attendance_employeeId_idx")
  // Composite index for: WHERE checkIn >= ? AND employee.companyId = ?
  // The dashboard fetches 7 days of attendance in one query — this covers it.
  @@index([checkIn, employeeId], map: "Attendance_checkIn_employeeId_idx")
  @@map("attendance")
}

model AuditComment {
  id              String          @id @default(uuid())
  engagementId    String
  content         String          @db.Text
  authorName      String?         @db.VarChar(100)
  createdAt       DateTime        @default(now())
  auditEngagement AuditEngagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)

  @@index([engagementId], map: "AuditComment_engagementId_idx")
  @@map("auditcomment")
}

model AuditEngagement {
  id            String         @id @default(uuid())
  firmId        String
  title         String         @db.VarChar(300)
  type          String         @default("EXTERNAL")
  auditType     String?        @db.VarChar(100)
  riskLevel     String?        @db.VarChar(50)
  scope         String?        @db.Text
  notes         String?        @db.Text
  budget        Decimal?
  actualCost    Decimal?
  reportSummary String?        @db.Text
  status        String         @default("PLANNED")
  startDate     DateTime?
  endDate       DateTime?
  companyId     String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @default(now()) @updatedAt
  auditComment  AuditComment[]
  company       Company?       @relation(fields: [companyId], references: [id])
  auditFirm     AuditFirm      @relation(fields: [firmId], references: [id])
  auditFinding  AuditFinding[]

  @@index([companyId], map: "AuditEngagement_companyId_idx")
  @@index([firmId], map: "AuditEngagement_firmId_idx")
  @@map("auditengagement")
}

model AuditFinding {
  id              String          @id @default(uuid())
  engagementId    String
  title           String          @db.VarChar(300)
  description     String?         @db.Text
  severity        String          @default("MEDIUM")
  status          String          @default("OPEN")
  assignedTo      String?         @db.VarChar(100)
  dueDate         DateTime?
  resolvedAt      DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @default(now()) @updatedAt
  auditEngagement AuditEngagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)

  @@index([engagementId], map: "AuditFinding_engagementId_idx")
  @@map("auditfinding")
}

model AuditFirm {
  id              String            @id @default(uuid())
  name            String
  licenseNo       String?           @db.VarChar(100)
  email           String?
  phone           String?           @db.VarChar(50)
  address         String?           @db.Text
  contactPerson   String?           @db.VarChar(200)
  industry        String?           @db.VarChar(100)
  status          String            @default("ACTIVE")
  rating          Decimal           @default(0.000000000000000000000000000000)
  isActive        Boolean           @default(true)
  companyId       String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @default(now()) @updatedAt
  auditEngagement AuditEngagement[]
  company         Company?          @relation(fields: [companyId], references: [id])

  @@index([companyId], map: "AuditFirm_companyId_idx")
  @@map("auditfirm")
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String
  /// nullable — unauthenticated security events (pre-auth attacks) have no userId
  userId    String?
  companyId String?
  details   String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], map: "AuditLog_userId_fkey")

  @@index([companyId], map: "AuditLog_companyId_idx")
  @@index([userId], map: "AuditLog_userId_idx")
  // Composite indexes for the two most common dashboard queries:
  //   1. payroll dashboard: WHERE action = 'PAYROLL_APPROVED' AND createdAt BETWEEN ...
  //   2. admin audit log:   WHERE companyId = ? ORDER BY createdAt DESC
  @@index([action, createdAt], map: "AuditLog_action_createdAt_idx")
  @@index([companyId, createdAt(sort: Desc)], map: "AuditLog_companyId_createdAt_idx")
  // Log rotation index: DELETE FROM auditlog WHERE createdAt < ?
  @@index([createdAt], map: "AuditLog_createdAt_idx")
  @@map("auditlog")
}

model BankAccount {
  id              String            @id @default(uuid())
  name            String
  accountNumber   String
  bankName        String
  currencyCode    String            @default("ETB")
  openingBalance  Decimal           @default(0.000000000000000000000000000000)
  balance         Decimal           @default(0.000000000000000000000000000000)
  accountType     String            @default("BANK") @db.VarChar(20)
  accountStatus   String            @default("ACTIVE") @db.VarChar(20)
  accountId       String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @default(now()) @updatedAt
  companyId       String?
  company         Company?          @relation(fields: [companyId], references: [id])
  bankTransaction BankTransaction[]
  revenues        Revenue[]
  payments        Payment[]
  transfersFrom   FundTransfer[]    @relation("FromBankAcc")
  transfersTo     FundTransfer[]    @relation("ToBankAcc")
  invoicePayments InvoicePayment[]
  billPayments    BillPayment[]
  bankFeeds       BankFeed[]
  reconciliationPeriods ReconciliationPeriod[]

  @@index([companyId], map: "BankAccount_companyId_idx")
  @@index([accountType], map: "BankAccount_accountType_idx")
  @@index([accountStatus], map: "BankAccount_accountStatus_idx")
  @@map("bankaccount")
}

model BankFeed {
  id              String           @id @default(uuid())
  bankAccountId   String
  companyId       String?
  provider        BankFeedProvider @default(MANUAL)
  status          BankFeedStatus   @default(PENDING_AUTH)
  lastSyncAt      DateTime?
  institutionId   String?          @db.VarChar(100)
  institutionName String?          @db.VarChar(200)
  errorMessage    String?          @db.Text
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @default(now()) @updatedAt
  company         Company?         @relation(fields: [companyId], references: [id])
  bankAccount     BankAccount      @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)

  @@index([companyId], map: "BankFeed_companyId_idx")
  @@index([bankAccountId], map: "BankFeed_bankAccountId_idx")
  @@index([status], map: "BankFeed_status_idx")
  @@map("bankfeed")
}

model BankTransaction {
  id               String           @id @default(uuid())
  bankAccountId    String
  companyId        String?
  date             DateTime
  description      String
  amount           Decimal
  reference        String?          @db.VarChar(200)
  status           String           @default("PENDING")
  journalEntryId   String?
  bankName         String?          @db.VarChar(100)
  counterparty     String?          @db.VarChar(200)
  matchMethod      String?          @db.VarChar(30)
  matchScore       Int              @default(0)
  matchedBillId    String?          @db.VarChar(36)
  matchedInvoiceId String?          @db.VarChar(36)
  notes            String?          @db.Text
  qrCode           String?          @db.Text
  telecomRef       String?          @db.VarChar(100)
  type             String           @default("CREDIT") @db.VarChar(10)
  voucherCode      String?          @db.VarChar(100)
  /// Category label (denormalised for fast display — also linked via categoryId)
  category         String?          @db.VarChar(100)
  categoryId       String?          @db.VarChar(36)
  /// Marks a transaction as a duplicate of another (for feed dedup)
  isDuplicate      Boolean          @default(false)
  duplicateOfId    String?          @db.VarChar(36)
  bankAccount      BankAccount      @relation(fields: [bankAccountId], references: [id], map: "BankTransaction_bankAccountId_fkey")
  company          Company?         @relation(fields: [companyId], references: [id])
  journalEntry     JournalEntry?    @relation(fields: [journalEntryId], references: [id], map: "BankTransaction_journalEntryId_fkey")
  invoicePayments  InvoicePayment[]
  billPayments     BillPayment[]
  fxAdjustments    BankTransactionFx[]

  @@index([date], map: "BankTransaction_date_idx")
  @@index([reference], map: "BankTransaction_reference_idx")
  @@index([status], map: "BankTransaction_status_idx")
  @@index([telecomRef], map: "BankTransaction_telecomRef_idx")
  @@index([bankAccountId], map: "banktransaction_bankAccountId_fkey")
  @@index([journalEntryId], map: "BankTransaction_journalEntryId_fkey")
  @@index([companyId])
  @@index([categoryId])
  @@map("banktransaction")
}

/// FX rate snapshot — used for multi-currency account valuation and
/// realized exchange gain/loss computation during reconciliation.
model BankFxRate {
  id           String    @id @default(uuid())
  fromCurrency String    @db.VarChar(3)
  toCurrency   String    @db.VarChar(3)
  rate         Decimal   @db.Decimal(18, 6)
  rateDate     DateTime  @default(now())
  source       String?   @db.VarChar(50)
  companyId    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now()) @updatedAt
  company      Company?  @relation(fields: [companyId], references: [id])

  @@unique([fromCurrency, toCurrency, rateDate, companyId], map: "BankFxRate_unique_key")
  @@index([fromCurrency, toCurrency], map: "BankFxRate_currency_idx")
  @@index([companyId])
  @@index([rateDate])
  @@map("bankfxrate")
}

/// Per-transaction FX adjustment — captures the realized exchange gain or loss
/// when a foreign-currency bank transaction is settled or reconciled.
model BankTransactionFx {
  id               String    @id @default(uuid())
  bankTransactionId String
  companyId        String?
  fromCurrency     String    @db.VarChar(3)
  toCurrency       String    @db.VarChar(3)
  originalAmount   Decimal
  convertedAmount  Decimal
  rateAtBooking    Decimal   @db.Decimal(18, 6)
  rateAtSettlement Decimal   @db.Decimal(18, 6)
  gainLoss         Decimal
  reason           String?   @db.VarChar(50)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @default(now()) @updatedAt
  company          Company?  @relation(fields: [companyId], references: [id])
  bankTransaction  BankTransaction @relation(fields: [bankTransactionId], references: [id], onDelete: Cascade)

  @@index([bankTransactionId], map: "BankTransactionFx_txn_idx")
  @@index([companyId])
  @@map("banktransactionfx")
}

/// Auto-match rule — maps a description pattern to a transaction category.
/// Replaces the previous systemsetting KV store approach.
/// Run: npm run db:push && npm run db:generate
model BankMatchingRule {
  id           String   @id @default(uuid())
  companyId    String?
  /// Case-insensitive substring to match in transaction description
  pattern      String   @db.VarChar(200)
  /// INCOME | EXPENSE | ANY
  type         String   @default("ANY") @db.VarChar(20)
  categoryId   String?  @db.VarChar(36)
  categoryName String?  @db.VarChar(100)
  /// Sort order — lower number = higher priority (evaluated first)
  priority     Int      @default(0)
  isActive     Boolean  @default(true)
  /// Cumulative count of transactions this rule has categorized
  hits         Int      @default(0)
  createdBy    String?  @db.VarChar(100)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt
  company      Company? @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@index([isActive])
  @@map("bankmatchingrule")
}

model Bill {
  id                  String             @id @default(uuid())
  billNumber          String             @unique(map: "Bill_billNumber_key")
  date                DateTime           @default(now())
  category            String
  categoryId          String?
  companyId           String?
  status              String             @default("PENDING")
  currencyCode        String             @default("ETB") @db.VarChar(3)
  currencyRate        Decimal            @default(1.0)
  dueDate             DateTime
  amount              Decimal            @default(0.000000000000000000000000000000)
  vatAmount           Decimal            @default(0.000000000000000000000000000000)
  total               Decimal            @default(0.000000000000000000000000000000)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @default(now()) @updatedAt
  accountId           String?
  journalEntryId      String?            @db.VarChar(36)
  notes               String?            @db.Text
  /// Bill display color (hex) for branding — Ovds "Changing the Color of a Bill"
  color               String?            @db.VarChar(10)
  /// Agency placement: guarantee window in days (Workflow A)
  guaranteePeriodDays Int?
  /// Agency placement: date the candidate started work (Workflow A)
  placementDate       DateTime?
  /// Agency placement: FK to hired Employee record (Workflow A)
  linkedEmployeeId    String?            @db.VarChar(36)
  vendorId            String?
  vatRate             Decimal?
  vendorName          String?            @db.VarChar(200)
  vendorTin           String?            @db.VarChar(15)
  /// Fiscal Sales Register Machine Number issued by ERCA for the vendor's SRM device
  /// Required on all vendor invoices where whtApplicable=true (Proc. 1395/2025 Art. 94)
  vendorFsNo          String?            @db.VarChar(50)
  /// Vendor VAT registration number (for input VAT claimability)
  vendorVatRegNo      String?            @db.VarChar(50)
  /// HS tariff code for imported goods (customs + input VAT linkage)
  hsCode              String?            @db.VarChar(20)
  whtApplicable       Boolean            @default(false)
  /// WHT amount withheld (auto-calculated when whtApplicable=true — Proc. 1395/2025 Art. 94)
  whtAmount           Decimal            @default(0.000000000000000000000000000000)
  /// WHT type: GOODS | SERVICES | SERVICES_NR | RENT
  whtType             String?            @db.VarChar(20)
  isRecurring         Boolean            @default(false)
  recurringInterval   String?            @db.VarChar(20)
  recurringNextDate   DateTime?
  categoryRef         Category?          @relation(fields: [categoryId], references: [id])
  company             Company?           @relation(fields: [companyId], references: [id], map: "Bill_companyId_fkey")
  vendor              Vendor?            @relation(fields: [vendorId], references: [id], map: "Bill_vendorId_fkey")
  journalEntry        JournalEntry?      @relation(fields: [journalEntryId], references: [id])
  billItem            BillItem[]
  billPayment         BillPayment[]
  paymentBatchItem    PaymentBatchItem[]
  vendorPayments      VendorPayment[]

  @@index([companyId], map: "Bill_companyId_idx")
  @@index([companyId, status], map: "Bill_companyId_status_idx")
  @@index([companyId, dueDate], map: "Bill_companyId_dueDate_idx")
  @@index([dueDate], map: "Bill_dueDate_idx")
  @@index([status], map: "Bill_status_idx")
  @@index([vendorId], map: "bill_vendorId_fkey")
  @@index([journalEntryId])
  @@index([linkedEmployeeId], map: "Bill_linkedEmployeeId_idx")
  @@map("bill")
}

