// ── IFRS 16 Lease Accounting ──────────────────────────────────────────────────

model Lease {
  id                     String              @id @default(uuid())
  /// Lease reference number (e.g. LEASE-2025-001)
  leaseNumber            String              @unique @db.VarChar(100)
  /// FINANCE | OPERATING — IFRS 16 lease classification
  leaseType              String              @default("FINANCE") @db.VarChar(20)
  /// ACTIVE | TERMINATED | EXPIRED | MODIFIED
  status                 String              @default("ACTIVE") @db.VarChar(20)
  /// Asset description (e.g. "Office Building — Bole, Addis Ababa")
  assetDescription       String              @db.VarChar(300)
  /// Asset category (PROPERTY, VEHICLE, EQUIPMENT, OTHER)
  assetCategory          String              @default("PROPERTY") @db.VarChar(50)
  /// Lessor name
  lessorName             String              @db.VarChar(200)
  lessorTin              String?             @db.VarChar(20)
  /// Lease commencement date
  commencementDate       DateTime
  /// Lease end date
  endDate                DateTime
  /// Lease term in months
  termMonths             Int
  /// Monthly lease payment (ETB)
  monthlyPayment         Decimal             @default(0) @db.Decimal(18, 2)
  /// Annual interest rate (e.g. 0.12 for 12%)
  discountRate           Decimal             @default(0.12) @db.Decimal(8, 6)
  /// Right-of-use asset initial value (PV of lease payments)
  rouAssetInitial        Decimal             @default(0) @db.Decimal(18, 2)
  /// Current ROU asset carrying amount (after depreciation)
  rouAssetCarrying       Decimal             @default(0) @db.Decimal(18, 2)
  /// Initial lease liability (= rouAssetInitial)
  leaseLiabilityInitial  Decimal             @default(0) @db.Decimal(18, 2)
  /// Current lease liability outstanding
  leaseLiabilityCurrent  Decimal             @default(0) @db.Decimal(18, 2)
  /// Total interest expense recognised to date
  totalInterestExpense   Decimal             @default(0) @db.Decimal(18, 2)
  /// Total depreciation recognised to date
  totalDepreciation      Decimal             @default(0) @db.Decimal(18, 2)
  /// Total payments made to date
  totalPaymentsMade      Decimal             @default(0) @db.Decimal(18, 2)
  /// Optional: residual value guarantee
  residualValueGuarantee Decimal?            @db.Decimal(18, 2)
  /// Optional: purchase option price
  purchaseOptionPrice    Decimal?            @db.Decimal(18, 2)
  /// Whether purchase option is reasonably certain to be exercised
  purchaseOptionCertain  Boolean             @default(false)
  /// Renewal option details (JSON)
  renewalOptions         String?             @db.Text
  notes                  String?             @db.Text
  companyId              String?
  createdBy              String?             @db.VarChar(100)
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  company                Company?            @relation(fields: [companyId], references: [id])
  leasePayment           LeasePayment[]
  leaseJournalEntry      LeaseJournalEntry[]

  @@index([companyId])
  @@index([status])
  @@index([commencementDate])
  @@map("lease")
}

model LeasePayment {
  id               String    @id @default(uuid())
  leaseId          String
  /// Payment period (YYYY-MM)
  period           String    @db.VarChar(7)
  paymentDate      DateTime
  totalPayment     Decimal   @db.Decimal(18, 2)
  principalPortion Decimal   @db.Decimal(18, 2)
  interestPortion  Decimal   @db.Decimal(18, 2)
  openingLiability Decimal   @db.Decimal(18, 2)
  closingLiability Decimal   @db.Decimal(18, 2)
  rouDepreciation  Decimal   @db.Decimal(18, 2)
  /// SCHEDULED | PAID | OVERDUE
  status           String    @default("SCHEDULED") @db.VarChar(20)
  paidAt           DateTime?
  journalEntryId   String?   @db.VarChar(36)
  notes            String?   @db.VarChar(500)
  createdAt        DateTime  @default(now())
  lease            Lease     @relation(fields: [leaseId], references: [id], onDelete: Cascade)

  @@index([leaseId])
  @@index([period])
  @@index([status])
  @@map("lease_payment")
}

model LeaseJournalEntry {
  id             String   @id @default(uuid())
  leaseId        String
  /// INITIAL_RECOGNITION | MONTHLY_PAYMENT | DEPRECIATION | TERMINATION | MODIFICATION
  entryType      String   @db.VarChar(50)
  period         String   @db.VarChar(7)
  amount         Decimal  @db.Decimal(18, 2)
  journalEntryId String?  @db.VarChar(36)
  description    String?  @db.VarChar(500)
  createdAt      DateTime @default(now())
  lease          Lease    @relation(fields: [leaseId], references: [id], onDelete: Cascade)

  @@index([leaseId])
  @@index([period])
  @@map("lease_journal_entry")
}

