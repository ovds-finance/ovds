// ═══════════════════════════════════════════════════════════════════════════════
// SECURITY ASSESSMENT MODULE
// Internal Web Application Security Assessment Guide — OVDS control mapping.
// Four-phase methodology: Attack Surface Mapping, Configuration Audit,
// Dynamic Analysis (DAST), and Remediation Hardening.
// ═══════════════════════════════════════════════════════════════════════════════

model SecurityAssessment {
  id           String   @id @default(uuid())
  companyId    String
  name         String   @db.VarChar(200)
  description  String?  @db.Text
  /// SCHEDULED | IN_PROGRESS | COMPLETED | FAILED
  status       String   @default("SCHEDULED") @db.VarChar(20)
  /// PHASE_1_ATTACK_SURFACE | PHASE_2_CONFIG | PHASE_3_DAST | PHASE_4_REMEDIATION | ALL
  currentPhase String?  @db.VarChar(30)
  startedAt    DateTime?
  completedAt  DateTime?
  conductedBy  String?  @db.VarChar(100)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  company      Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  scans        SecurityScan[]
  findings     SecurityFinding[]

  @@index([companyId])
  @@index([status])
  @@map("security_assessment")
}

model SecurityScan {
  id           String   @id @default(uuid())
  assessmentId String
  /// PHASE_1_ATTACK_SURFACE | PHASE_2_CONFIG | PHASE_3_DAST | PHASE_4_REMEDIATION
  phase        String   @db.VarChar(30)
  /// ENDPOINT_MAPPING | ENV_AUDIT | BOLA_TEST | MASS_ASSIGNMENT_TEST | INPUT_SANITIZATION_TEST | FIREWALL_CHECK | APP_KEY_CHECK | DEBUG_MODE_CHECK
  scanType     String   @db.VarChar(50)
  target       String?  @db.VarChar(500)
  /// PENDING | RUNNING | PASSED | FAILED | WARNING | SKIPPED
  status       String   @default("PENDING") @db.VarChar(20)
  result       String?  @db.Text
  evidence     String?  @db.Text
  severity     String?  @db.VarChar(20)
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  assessment   SecurityAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  findings     SecurityFinding[]

  @@index([assessmentId])
  @@index([phase])
  @@index([scanType])
  @@map("security_scan")
}

model SecurityFinding {
  id               String   @id @default(uuid())
  assessmentId     String
  scanId           String?
  /// CRITICAL | HIGH | MEDIUM | LOW | INFO
  severity         String   @db.VarChar(20)
  /// BOLA | MASS_ASSIGNMENT | SQL_INJECTION | XSS | EXPOSED_ENV | WEAK_APP_KEY | DEBUG_MODE | INACTIVE_FIREWALL | INSECURE_HEADERS | BRUTE_FORCE | DATA_IN_TRANSIT | MISSING_CSP | MISSING_HSTS
  category         String   @db.VarChar(50)
  title            String   @db.VarChar(200)
  description      String   @db.Text
  affectedResource String?  @db.VarChar(500)
  remediation      String?  @db.Text
  /// OPEN | IN_PROGRESS | RESOLVED | ACCEPTED_RISK | FALSE_POSITIVE
  status           String   @default("OPEN") @db.VarChar(20)
  assignedTo       String?  @db.VarChar(100)
  resolvedAt       DateTime?
  notes            String?  @db.Text
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  assessment       SecurityAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  scan             SecurityScan?      @relation(fields: [scanId], references: [id], onDelete: SetNull)

  @@index([assessmentId])
  @@index([scanId])
  @@index([severity])
  @@index([status])
  @@index([category])
  @@map("security_finding")
}

