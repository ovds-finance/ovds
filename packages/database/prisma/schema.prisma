  //   WHERE companyId = ? AND payrollStatus = 'ACTIVE'
  //   WHERE companyId = ? AND baseSalary > 0
  @@index([companyId, payrollStatus], map: "Employee_companyId_payrollStatus_idx")
  @@map("employee")
}

