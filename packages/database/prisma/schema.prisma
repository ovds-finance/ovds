// ── DEPRECATED: Revenue (stub — do NOT use for financial reporting) ───────────
// ⚠️  DOUBLE-RECORDING RISK: Revenue recognition is handled exclusively by:
//       1. Invoice → JournalEntry (autoPostInvoiceCreation in AccountingService)
//       2. InvoicePayment → JournalEntry (autoPostInvoicePayment)
//     Writing to this table in addition to those journal entries will produce
//     double-counted income on the P&L.  This model is preserved only for
//     legacy FK compatibility with JournalEntry.revenues[].
//     NEW CODE must NOT write to this table. Use InvoicePayment + JournalLine instead.
model Revenue {
  id             String        @id @default(uuid())
  date           DateTime
  amount         Decimal
  currencyCode   String        @default("ETB") @db.VarChar(3)
  accountId      String? // Reference to BankAccount
  customerId     String?
  categoryId     String?
  description    String?       @db.Text
  reference      String?       @db.VarChar(100)
  companyId      String?
  journalEntryId String?       @db.VarChar(36)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  company        Company?      @relation(fields: [companyId], references: [id])
  customer       Customer?     @relation(fields: [customerId], references: [id])
  category       Category?     @relation(fields: [categoryId], references: [id])
  bankAccount    BankAccount?  @relation(fields: [accountId], references: [id])
  journalEntry   JournalEntry? @relation(fields: [journalEntryId], references: [id])

  @@index([companyId])
  @@index([customerId])
  @@index([categoryId])
  @@index([date])
  @@map("revenue")
}

// ── DEPRECATED: Payment (stub — do NOT use for financial reporting) ───────────
// ⚠️  DOUBLE-RECORDING RISK: Vendor payments are handled exclusively by:
//       1. Bill → BillPayment → JournalEntry (autoPostBillPayment in AccountingService)
//     Writing to this table in addition to those journal entries will produce
