/// Tracks the full lifecycle of a programmatic module download/installation job.
/// On-premises: job streams the ZIP, extracts to disk, transitions PENDING → DOWNLOADING → EXTRACTING → DONE | FAILED.
/// SaaS/Cloud:  job skips download; activates tenant permissions in DB,  transitions PENDING → ACTIVATING → DONE | FAILED.
model ModuleDownloadJob {
  id          String   @id @default(uuid())
  companyId   String

  /// App slug / module alias (e.g. "erca-etax", "telebirr-pay")
  moduleAlias String   @db.VarChar(100)

  /// PENDING | DOWNLOADING | EXTRACTING | ACTIVATING | DONE | FAILED | CANCELLED
  status      String   @default("PENDING") @db.VarChar(20)

  /// "ON_PREMISE" | "SAAS"
  deploymentType String @default("SAAS") @db.VarChar(20)

  /// Remote download URL used for ON_PREMISE jobs
  downloadUrl  String?  @db.VarChar(1000)

  /// Absolute server-side path the ZIP was extracted to (ON_PREMISE only)
  targetPath   String?  @db.VarChar(500)

  /// 0–100 download progress percentage (ON_PREMISE only)
  progress     Int      @default(0)

  /// Human-readable status message or error detail
  message      String?  @db.Text

  /// SHA-256 checksum of the downloaded file (ON_PREMISE only)
  sha256       String?  @db.VarChar(64)

  /// User who triggered the job
  triggeredBy  String?  @db.VarChar(100)

  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([companyId, moduleAlias])
  @@index([status])
  @@map("module_download_job")
}

// ── EIMS (Electronic Invoice Management System) — MoR/INSA compliance ────────

/// Registered EIMS source system per company (MoR portal source registration)
model EimsSourceSystem {
  id              String   @id @default(uuid())
  companyId       String
  /// MoR-assigned system number (e.g. "0A774FBBBE")
  systemNumber    String   @db.VarChar(50)
  /// ERP | POS | MANUAL
  systemType      String   @default("ERP") @db.VarChar(20)
  /// Enterprise name from MoR portal
  enterpriseId      String?  @db.VarChar(100)
  enterpriseName    String?  @db.VarChar(200)
  /// Establishment name from MoR portal
  establishmentId String?  @db.VarChar(100)
  establishmentName String? @db.VarChar(200)
  /// Source registration progress step per Self-onboarding Guide
  registrationStep  String?  @default("ENTERPRISE_SELECTED") @db.VarChar(30)
  /// PENDING | APPROVED | REJECTED | SUSPENDED
  status          String   @default("PENDING") @db.VarChar(20)
  /// EIMS portal API credentials (encrypted)
  clientId        String?  @db.VarChar(200)
  clientSecret    String?  @db.VarChar(500)
  apiKey          String?  @db.VarChar(200)
  /// Callback URL for bulk registration/cancellation async responses
  callbackUrl     String?  @db.VarChar(500)
  /// Last successful EIMS authentication timestamp
  lastAuthAt      DateTime?
  /// Current invoice counter for SourceSystem.InvoiceCounter
  invoiceCounter  Int      @default(0)
  /// Last registered IRN (for PreviousIrn chain)
  lastIrn         String?  @db.VarChar(64)
  registeredAt    DateTime @default(now())
  approvedAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  certificates    EimsCertificate[]
  registrations   EimsRegistration[]

  @@unique([companyId, systemNumber])
  @@index([companyId])
  @@index([status])
  @@map("eims_source_system")
}

/// INSA-issued digital certificate for EIMS request signing
model EimsCertificate {
  id              String   @id @default(uuid())
  companyId       String
  sourceSystemId  String?
  /// PENDING_CSR | CSR_SUBMITTED | ISSUED | EXPIRING | EXPIRED | REVOKED
  status          String   @default("PENDING_CSR") @db.VarChar(20)
  /// PEM-encoded private key (AES-256-GCM encrypted)
  privateKeyEnc   String?  @db.LongText
  /// PEM-encoded certificate from INSA
  certificatePem  String?  @db.LongText
  /// Base64-encoded certificate for EIMS API (cached)
  certificateB64  String?  @db.LongText
  /// CSR PEM submitted to INSA (ica@insa.gov.et)
  csrPem          String?  @db.LongText
  /// Certificate subject CN (TIN)
  subjectTin      String?  @db.VarChar(20)
  /// Certificate serial number (System Number)
  serialNumber    String?  @db.VarChar(50)
  issuedAt        DateTime?
  expiresAt       DateTime?
  submittedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  sourceSystem    EimsSourceSystem? @relation(fields: [sourceSystemId], references: [id])

  @@index([companyId])
  @@index([sourceSystemId])
  @@index([status])
  @@index([expiresAt])
  @@map("eims_certificate")
}

/// EIMS invoice registration record (IRN, signed QR, MoR acknowledgement)
model EimsRegistration {
  id                String   @id @default(uuid())
  companyId         String
  sourceSystemId    String?
  invoiceId         String?  @db.VarChar(36)
  /// MoR Invoice Reference Number (64-char hash)
  irn               String?  @db.VarChar(64)
  documentNumber    String?  @db.VarChar(50)
  /// NOT_REGISTERED | PENDING | REGISTERED | FAILED | CANCELLED
  status            String   @default("PENDING") @db.VarChar(20)
  reason            String?  @db.VarChar(500)
  /// Base64 signed QR from EIMS
  signedQr          String?  @db.LongText
  /// MoR-signed invoice digest
  signedInvoice     String?  @db.LongText
  invoiceSignature  String?  @db.LongText
  /// Result of verifying the MoR's RSA-SHA512 signature over `signedInvoice`
  /// against the trusted MoR public certificate (EIMS_MOR_CERTIFICATE).
  /// null = not attempted (no certificate provisioned), true = verified,
  /// false = signature did not verify — treat the acknowledgement as suspect.
  signatureVerified Boolean?
  signatureVerifiedAt DateTime?
  ackDate           DateTime?
  /// Previous IRN in chain
  previousIrn       String?  @db.VarChar(64)
  /// Full request payload sent (audit)
  requestPayload    String?  @db.LongText
  /// Full response from EIMS (audit)
  responsePayload   String?  @db.LongText
  errorMessage      String?  @db.VarChar(1000)
  attemptCount      Int      @default(0)
  /// live | sandbox | stub
  submissionMode    String   @default("sandbox") @db.VarChar(10)
  registeredAt      DateTime?
  cancelledAt       DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  sourceSystem      EimsSourceSystem? @relation(fields: [sourceSystemId], references: [id])

  @@index([companyId])
  @@index([invoiceId])
  @@index([irn])
  @@index([status])
  @@index([sourceSystemId])
  @@unique([companyId, invoiceId])
  @@map("eims_registration")
}

/// EIMS receipt registration (sales + withholding — EIMS Section 6)
