  notes               String?       @db.Text
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  company             Company?      @relation(fields: [companyId], references: [id])
  customer            Customer?     @relation(fields: [customerId], references: [id])
  stage               PipelineStage @relation(fields: [stageId], references: [id])

  @@index([companyId])
  @@index([stageId])
  @@map("pipeline")
}

model PipelineStage {
  id        String     @id @default(uuid())
  name      String
  order     Int        @default(0)
  pipelines Pipeline[]

  @@map("pipeline_stage")
}

// ── Import / Export Trade Compliance ─────────────────────────────────────────

/// Represents a full import or export shipment lifecycle
model TradeShipment {
  id                 String              @id @default(uuid())
  /// IMPORT | EXPORT
  direction          String              @db.VarChar(10)
  referenceNo        String              @unique @db.VarChar(100)
  /// DRAFT | LICENSED | TIN_REGISTERED | BANKING | PROFORMA | FOREX_APPROVED
  /// | PERMITS_OBTAINED | IN_TRANSIT | DECLARED | CUSTOMS_CLEARED | RELEASED | COMPLETED | CANCELLED
  status             String              @default("DRAFT") @db.VarChar(30)
  /// Harmonized System code (HS code)
  hsCode             String?             @db.VarChar(20)
  hsDescription      String?             @db.VarChar(300)
  /// Goods description
  goodsDescription   String?             @db.Text
  /// Country of origin / destination
  originCountry      String?             @db.VarChar(100)
  destinationCountry String?             @db.VarChar(100)
  /// Port of loading / discharge
  portOfLoading      String?             @db.VarChar(100)
  portOfDischarge    String?             @db.VarChar(100)
  /// Incoterms (FOB, CIF, EXW, etc.)
  incoterms          String?             @db.VarChar(10)
  /// Total invoice value (ETB equivalent)
  invoiceValue       Decimal             @default(0) @db.Decimal(18, 2)
  currencyCode       String              @default("USD") @db.VarChar(3)
  /// Customs duty amount
  customsDuty        Decimal             @default(0) @db.Decimal(18, 2)
  /// VAT on import
  importVat          Decimal             @default(0) @db.Decimal(18, 2)
  /// Excise duty
  exciseDuty         Decimal             @default(0) @db.Decimal(18, 2)
  /// Withholding tax
  withholdingTax     Decimal             @default(0) @db.Decimal(18, 2)
  /// Total tax burden
  totalTaxes         Decimal             @default(0) @db.Decimal(18, 2)
  /// RED | GREEN | YELLOW (customs risk lane)
  inspectionLane     String?             @db.VarChar(10)
  /// ESW Portal declaration number
  eswDeclarationNo   String?             @db.VarChar(100)
  /// Bill of lading / airway bill number
  billOfLadingNo     String?             @db.VarChar(100)
  /// Estimated arrival date
  eta                DateTime?
  /// Actual arrival date
  ata                DateTime?
  /// Customs clearance date
  clearedAt          DateTime?
  /// Goods release date
  releasedAt         DateTime?
  companyId          String?
  createdBy          String?             @db.VarChar(100)
  notes              String?             @db.Text
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  documents          TradeDocument[]
  steps              TradeShipmentStep[]
  forexApprovals     ForexApproval[]

  @@index([companyId])
  @@index([status])
  @@index([direction])
  @@index([hsCode])
  @@map("trade_shipment")
}

/// Individual pipeline step for a shipment
model TradeShipmentStep {
  id          String        @id @default(uuid())
  shipmentId  String
  /// Step key: LICENSING, TIN_VAT, BANKING, PROFORMA, FOREX, PERMITS, SHIPMENT, DECLARATION, CUSTOMS, RELEASE
  stepKey     String        @db.VarChar(50)
  stepLabel   String        @db.VarChar(200)
  /// PENDING | IN_PROGRESS | COMPLETED | FAILED | SKIPPED
  status      String        @default("PENDING") @db.VarChar(20)
  completedAt DateTime?
  completedBy String?       @db.VarChar(100)
  notes       String?       @db.Text
  metadata    String?       @db.LongText
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  shipment    TradeShipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId])
  @@index([stepKey])
  @@map("trade_shipment_step")
}

/// Documents attached to a shipment (commercial invoice, packing list, etc.)
model TradeDocument {
  id         String        @id @default(uuid())
  shipmentId String
  /// COMMERCIAL_INVOICE | PACKING_LIST | BILL_OF_LADING | AIRWAY_BILL | CERTIFICATE_OF_ORIGIN
  /// | IMPORT_PERMIT | EXPORT_PERMIT | PHYTOSANITARY | CUSTOMS_DECLARATION | FOREX_APPROVAL | OTHER
  docType    String        @db.VarChar(50)
  fileName   String        @db.VarChar(255)
  mimeType   String?       @db.VarChar(100)
  fileSize   Int?
  fileData   String?       @db.LongText
  status     String        @default("PENDING") @db.VarChar(20)
  verifiedAt DateTime?
  verifiedBy String?       @db.VarChar(100)
  notes      String?       @db.VarChar(500)
  createdAt  DateTime      @default(now())
  shipment   TradeShipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId])
  @@index([docType])
  @@map("trade_document")
}

/// Forex approval record (NBE / commercial bank)
model ForexApproval {
  id              String        @id @default(uuid())
  shipmentId      String
  bankName        String        @db.VarChar(200)
  applicationDate DateTime?
  approvalDate    DateTime?
  approvalRef     String?       @db.VarChar(100)
  foreignCurrency String        @default("USD") @db.VarChar(3)
  foreignAmount   Decimal       @default(0) @db.Decimal(18, 2)
  etbEquivalent   Decimal       @default(0) @db.Decimal(18, 2)
  exchangeRate    Decimal       @default(0) @db.Decimal(10, 6)
  /// PENDING | APPROVED | REJECTED | EXPIRED
  status          String        @default("PENDING") @db.VarChar(20)
  notes           String?       @db.Text
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  shipment        TradeShipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId])
  @@index([status])
  @@map("forex_approval")
}

/// Trade license / business registration record
model TradeLicense {
  id               String    @id @default(uuid())
  companyId        String?
  licenseType      String    @db.VarChar(100)
  licenseNumber    String    @unique @db.VarChar(100)
  issuingAuthority String?   @db.VarChar(200)
  issuedDate       DateTime?
  expiryDate       DateTime?
  /// ACTIVE | EXPIRED | SUSPENDED | REVOKED
  status           String    @default("ACTIVE") @db.VarChar(20)
  notes            String?   @db.Text
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([companyId])
  @@index([status])
  @@map("trade_license")
}

/// Proforma invoice for import/export
model ProformaInvoice {
  id              String    @id @default(uuid())
  proformaNumber  String    @unique @db.VarChar(100)
  shipmentId      String?
  supplierName    String    @db.VarChar(300)
  supplierCountry String?   @db.VarChar(100)
  buyerName       String    @db.VarChar(300)
  issueDate       DateTime
  validUntil      DateTime?
  totalValue      Decimal   @default(0) @db.Decimal(18, 2)
  currencyCode    String    @default("USD") @db.VarChar(3)
  incoterms       String?   @db.VarChar(10)
  paymentTerms    String?   @db.VarChar(100)
  /// DRAFT | SUBMITTED | APPROVED | REJECTED | EXPIRED
  status          String    @default("DRAFT") @db.VarChar(20)
  lineItemsJson   String?   @db.LongText
  companyId       String?
  notes           String?   @db.Text
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([companyId])
  @@index([status])
  @@map("proforma_invoice")
}

enum TradeDirection {
  IMPORT
  EXPORT
}

enum InspectionLane {
  RED
  GREEN
  YELLOW
}

// ── Project Tasks, Milestones, Timesheets ─────────────────────────────────────

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum BillingStyle {
  HOURLY
  FIXED
  TASK
}

model ProjectTask {
  id             String             @id @default(uuid())
  projectId      String
  milestoneId    String?
  title          String             @db.VarChar(300)
  description    String?            @db.Text
  status         TaskStatus         @default(TODO)
  priority       TaskPriority       @default(MEDIUM)
  assignedTo     String?            @db.VarChar(200)
  dueDate        DateTime?
  completedAt    DateTime?
  estimatedHours Decimal?           @db.Decimal(8, 2)
  actualHours    Decimal?           @db.Decimal(8, 2)
  /// INVOICE_PER_HOUR | FIXED_PRICE | FIXED_PER_TASK
  billingStyle   BillingStyle       @default(HOURLY)
  fixedRate      Decimal?           @db.Decimal(12, 2)
  profitMargin   Int?
  companyId      String?
  createdBy      String?            @db.VarChar(100)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  project        Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestone      ProjectMilestone?  @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  timesheets     ProjectTimesheet[]
  comments       ProjectComment[]
  attachments    ProjectAttachment[]
  timers         ProjectTimer[]
  financialLinks ProjectFinancialLink[]
  activities     ProjectActivity[]

  @@index([projectId])
  @@index([milestoneId])
  @@index([status])
  @@index([assignedTo])
  @@index([billingStyle])
  @@map("project_task")
}

model ProjectMilestone {
  id          String    @id @default(uuid())
  projectId   String
  name        String    @db.VarChar(300)
  description String?   @db.Text
  dueDate     DateTime?
  completedAt DateTime?
  /// PENDING | COMPLETED | MISSED
  status      String    @default("PENDING") @db.VarChar(20)
  progress    Int?      @default(0)
  budget      Decimal?  @db.Decimal(18, 2)
  spent       Decimal?  @db.Decimal(18, 2)
  companyId   String?
  createdBy   String?   @db.VarChar(100)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks       ProjectTask[]
  comments    ProjectComment[]
  attachments ProjectAttachment[]
  activities  ProjectActivity[]

  @@index([projectId])
  @@index([status])
  @@map("project_milestone")
}

model ProjectTimesheet {
  id           String       @id @default(uuid())
  projectId    String
  taskId       String?
  employeeName String?      @db.VarChar(200)
  userId       String?      @db.VarChar(100)
  date         DateTime
  hours        Decimal      @db.Decimal(6, 2)
  description  String?      @db.Text
  billable     Boolean      @default(true)
  hourlyRate   Decimal?     @db.Decimal(12, 2)
  companyId    String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task         ProjectTask? @relation(fields: [taskId], references: [id])

  @@index([projectId])
  @@index([taskId])
  @@index([date])
  @@map("project_timesheet")
}

// ── Enhanced Project Activity Workflow ──────────────────────────────────────

model ProjectActivity {
  id           String   @id @default(uuid())
  projectId    String
  taskId       String?
  milestoneId  String?
  activityType String   @db.VarChar(50)
  title        String?  @db.VarChar(300)
  description  String?  @db.Text
  delta        String?  @db.Text
  createdBy    String?  @db.VarChar(100)
  createdAt    DateTime @default(now())
  companyId    String?

  project     Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task        ProjectTask?      @relation(fields: [taskId], references: [id], onDelete: SetNull)
  milestone   ProjectMilestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([taskId])
  @@index([milestoneId])
  @@index([companyId])
  @@map("project_activity")
}

model ProjectComment {
  id         String   @id @default(uuid())
  taskId     String
  parentId   String?
  body       String   @db.Text
  authorName String?  @db.VarChar(200)
  authorId   String?  @db.VarChar(100)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  companyId  String?

  task     ProjectTask       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  milestone   ProjectMilestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  milestoneId String?
  parent   ProjectComment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies  ProjectComment[] @relation("CommentReplies")

  @@index([taskId])
  @@index([parentId])
  @@index([companyId])
  @@map("project_comment")
}

model ProjectAttachment {
  id         String   @id @default(uuid())
  taskId     String
  filename   String   @db.VarChar(300)
  url        String   @db.VarChar(500)
  mimeType   String?  @db.VarChar(100)
  size       BigInt?
  uploadedBy String?  @db.VarChar(100)
  createdAt  DateTime @default(now())
  companyId  String?

  task ProjectTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  milestone   ProjectMilestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  milestoneId String?

  @@index([taskId])
  @@index([companyId])
  @@map("project_attachment")
}

model ProjectTimer {
  id           String   @id @default(uuid())
  projectId    String
  taskId       String
  employeeName String?  @db.VarChar(200)
  userId       String?  @db.VarChar(100)
  startedAt    DateTime @default(now())
  stoppedAt    DateTime?
  hours        Decimal? @db.Decimal(6, 2)
  notes        String?  @db.Text
  companyId    String?

  project Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task    ProjectTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([taskId])
  @@index([userId])
  @@index([companyId])
  @@map("project_timer")
}

model ProjectFinancialLink {
  id             String   @id @default(uuid())
  projectId      String
  taskId         String?
  linkType       String   @db.VarChar(50)
  linkId         String   @db.VarChar(100)
  linkNumber     String?  @db.VarChar(200)
  amount         Decimal  @db.Decimal(18, 2)
  currencyCode   String   @default("ETB") @db.VarChar(3)
  direction      String   @default("IN") @db.VarChar(10)
  linkDate       DateTime?
  notes          String?  @db.Text
  companyId      String?
  createdAt      DateTime @default(now())

  project Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task    ProjectTask? @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([taskId])
  @@index([linkType])
  @@index([companyId])
  @@map("project_financial_link")
}

// ── Monetization ─────────────────────────────────────────────────────────────
// Supports three simultaneous models: Subscription, Lifetime Purchase, Free Trial.
// The backend is the SOLE authority for entitlement decisions — the frontend
// only reads the result; it never computes access itself.

/// A product/plan that can be sold (e.g. "Business Plan", "Enterprise Add-on")
model MonetizationProduct {
  id            String   @id @default(uuid())
  /// Human-readable name shown in the UI
  name          String   @db.VarChar(200)
  /// Slug used as the featureKey prefix (e.g. "plan:business")
  slug          String   @unique @db.VarChar(100)
  /// SUBSCRIPTION | LIFETIME | ADDON
  type          String   @default("SUBSCRIPTION") @db.VarChar(20)
  /// JSON array of feature keys this product grants
  /// e.g. ["feature:gl","feature:payroll","feature:ocr"]
  featureKeys   String   @db.LongText
  /// Price in ETB (monthly for subscriptions)
  priceMonthly  Decimal  @default(0) @db.Decimal(18, 2)
  /// Price in ETB (annual for subscriptions)
  priceAnnual   Decimal  @default(0) @db.Decimal(18, 2)
  /// One-time price for LIFETIME type
  priceLifetime Decimal  @default(0) @db.Decimal(18, 2)
  /// Trial duration in days (0 = no trial)
  trialDays     Int      @default(14)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  subscriptions MonetizationSubscription[]
  purchases     MonetizationPurchase[]
  trials        MonetizationTrial[]

  @@map("monetization_product")
}

/// Active or historical subscription for a company
model MonetizationSubscription {
  id                 String    @id @default(uuid())
  companyId          String
  productId          String
  /// MONTHLY | ANNUAL
  billingCycle       String    @default("MONTHLY") @db.VarChar(10)
  /// ACTIVE | PAST_DUE | CANCELLED | EXPIRED | PAUSED
  status             String    @default("ACTIVE") @db.VarChar(20)
  /// When the current billing period started
  currentPeriodStart DateTime
  /// When the current billing period ends (access revoked after this)
  currentPeriodEnd   DateTime
  /// External payment provider reference (Stripe, Chapa, etc.)
  providerRef        String?   @db.VarChar(200)
  /// Provider-specific subscription ID
  providerSubId      String?   @db.VarChar(200)
  cancelledAt        DateTime?
  cancelReason       String?   @db.VarChar(500)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  company Company             @relation(fields: [companyId], references: [id])
  product MonetizationProduct @relation(fields: [productId], references: [id])

  @@index([companyId])
  @@index([status])
  @@index([currentPeriodEnd])
  @@map("monetization_subscription")
}

/// One-time lifetime purchase (non-expiring)
model MonetizationPurchase {
  id          String    @id @default(uuid())
  companyId   String
  productId   String
  /// COMPLETED | REFUNDED | DISPUTED
  status      String    @default("COMPLETED") @db.VarChar(20)
  amountPaid  Decimal   @db.Decimal(18, 2)
  providerRef String?   @db.VarChar(200)
  receiptUrl  String?   @db.VarChar(500)
  refundedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  company Company             @relation(fields: [companyId], references: [id])
  product MonetizationProduct @relation(fields: [productId], references: [id])

  @@index([companyId])
  @@index([status])
  @@map("monetization_purchase")
}

/// Free trial grant for a company
model MonetizationTrial {
  id          String    @id @default(uuid())
  companyId   String
  productId   String
  startsAt    DateTime  @default(now())
  endsAt      DateTime
  /// ACTIVE | EXPIRED | CONVERTED (converted = upgraded to paid)
  status      String    @default("ACTIVE") @db.VarChar(20)
  convertedAt DateTime?
  /// §4.2 Trial restriction config JSON: { mode, maxDocuments, maxSkus, maxUsers, maxBranches, lockedFeatures[] }
  restrictionConfig String? @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  company Company             @relation(fields: [companyId], references: [id])
  product MonetizationProduct @relation(fields: [productId], references: [id])

  @@unique([companyId, productId])
  @@index([companyId])
  @@index([status])
  @@index([endsAt])
  @@map("monetization_trial")
}

/// Effective entitlement cache — recomputed on every subscription/purchase/trial change.
/// The guard reads this table for O(1) access checks.
model MonetizationEntitlement {
  id         String    @id @default(uuid())
  companyId  String
  /// The feature key being granted (e.g. "feature:gl", "plan:business")
  featureKey String    @db.VarChar(200)
  /// SUBSCRIPTION | LIFETIME | TRIAL
  source     String    @db.VarChar(20)
  /// NULL for LIFETIME grants; set for time-bounded grants
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, featureKey])
  @@index([companyId])
  @@index([featureKey])
  @@index([expiresAt])
  @@map("monetization_entitlement")
}

// ── Subscription & Update Management ─────────────────────────────────────────

model SubscriptionUpdate {
  id              String    @id @default(uuid())
  companyId       String
  currentVersion  String    @db.VarChar(50)
  latestVersion   String    @db.VarChar(50)
  deploymentType  String    @default("CLOUD") @db.VarChar(20)
  status          String    @default("PENDING") @db.VarChar(50)
  changelog       String?   @db.Text
  downloadUrl     String?   @db.VarChar(500)
  releaseNotesUrl String?   @db.VarChar(500)
  notifiedAt      DateTime?
  updatedAt       DateTime  @updatedAt
  company         Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([status])
  @@map("subscription_update")
}

model ModuleVersion {
  id           String   @id @default(uuid())
  moduleName   String   @db.VarChar(100)
  version      String   @db.VarChar(50)
  isCore       Boolean  @default(false)
  changelog    String?  @db.Text
  downloadUrl  String?  @db.VarChar(500)
  releasedAt   DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([moduleName, version])
  @@index([moduleName])
  @@map("module_version")
}

// ═══════════════════════════════════════════════════════════════════════════════
// NEW MODELS — added for full IFRS + Ethiopian tax completeness
// ═══════════════════════════════════════════════════════════════════════════════

// ── Budget ────────────────────────────────────────────────────────────────────
model Budget {
  id           String   @id @default(uuid())
  companyId    String?
  accountId    String?
  /// Account name (denormalized for display when accountId is null)
  name         String?  @db.VarChar(200)
  /// Account category (EXPENSE, REVENUE, etc.)
  category     String?  @db.VarChar(50)
  year         Int
  /// Budget period YYYY-MM (for monthly budgets)
  period       String?  @db.VarChar(7)
  /// Monthly budget amount
  amount       Decimal  @default(0) @db.Decimal(18, 2)
  /// Annual budget total
  annualAmount Decimal? @db.Decimal(18, 2)
  /// Actual spend auto-populated from posted JournalLines by the budget-actuals cron job.
  /// Used by BudgetVariance page for live budget-vs-actual without a separate table.
  actualAmount Decimal? @db.Decimal(18, 2)
  /// Year-to-date actual spend (sum of actualAmount across all months to date)
  ytdActual    Decimal? @db.Decimal(18, 2)
  notes        String?  @db.Text
  createdBy    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  account      Account? @relation(fields: [accountId], references: [id])

  @@index([companyId])
  @@index([accountId])
  @@index([year])
  @@index([period])
  @@map("budget")
}

// ── Cost Center ───────────────────────────────────────────────────────────────
model CostCenter {
  id           String         @id @default(uuid())
  companyId    String?
  code         String         @db.VarChar(50)
  name         String         @db.VarChar(200)
  type         CostCenterType @default(COST)
  department   String?        @db.VarChar(200)
  managerId    String?
  budget       Decimal?       @db.Decimal(18, 2)
  isActive     Boolean        @default(true)
  notes        String?        @db.Text
  createdBy    String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  journalLines JournalLine[]  @relation("JournalLineCostCenter")

  @@unique([companyId, code])
  @@index([companyId])
  @@map("cost_center")
}

enum CostCenterType {
  COST
  PROFIT
  INVESTMENT
}

// ── Property Tax ──────────────────────────────────────────────────────────────
/// Property Tax — Proclamation No. 1161/2019
model PropertyRecord {
  id                 String               @id @default(uuid())
  companyId          String?
  propertyCode       String               @db.VarChar(50)
  description        String               @db.VarChar(500)
  address            String               @db.VarChar(500)
  city               String               @db.VarChar(100)
  subcity            String?              @db.VarChar(100)
  woreda             String?              @db.VarChar(100)
  kebele             String?              @db.VarChar(100)
  propertyType       PropertyTaxType
  useType            PropertyUseType
  landAreaSqm        Decimal              @default(0) @db.Decimal(18, 2)
  buildingAreaSqm    Decimal?             @db.Decimal(18, 2)
  yearBuilt          Int?
  registrationNumber String?              @db.VarChar(100)
  titleDeedNumber    String?              @db.VarChar(100)
  assessedValue      Decimal              @default(0) @db.Decimal(18, 2)
  marketValue        Decimal?             @db.Decimal(18, 2)
  annualTaxPayable   Decimal              @default(0) @db.Decimal(18, 2)
  valuationMethod    ValuationMethod      @default(MARKET_VALUE)
  lastValuationDate  DateTime?
  nextValuationDate  DateTime?
  isExempt           Boolean              @default(false)
  exemptReason       String?              @db.VarChar(500)
  notes              String?              @db.Text
  createdBy          String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  assessments        PropertyAssessment[]

  @@index([companyId])
  @@index([propertyType])
  @@map("property_record")
}

model PropertyAssessment {
  id               String            @id @default(uuid())
  propertyId       String
  period           String            @db.VarChar(4) // YYYY
  assessedValue    Decimal           @default(0) @db.Decimal(18, 2)
  taxRate          Decimal           @default(0.01) @db.Decimal(8, 6)
  annualTaxDue     Decimal           @default(0) @db.Decimal(18, 2)
  penaltyAmount    Decimal           @default(0) @db.Decimal(18, 2)
  totalPayable     Decimal           @default(0) @db.Decimal(18, 2)
  status           PropertyTaxStatus @default(ASSESSED)
  assessedBy       String?
  assessedAt       DateTime?
  dueDate          DateTime
  paidAt           DateTime?
  paymentReference String?           @db.VarChar(200)
  municipality     String            @db.VarChar(100)
  notes            String?           @db.Text
  createdAt        DateTime          @default(now())
  property         PropertyRecord    @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@index([period])
  @@index([status])
  @@map("property_assessment")
}

enum PropertyTaxType {
  URBAN_LAND
  BUILDING
  AGRICULTURAL_LAND
  RENTAL_INCOME
}

enum PropertyUseType {
  RESIDENTIAL
  COMMERCIAL
  INDUSTRIAL
  MIXED_USE
  AGRICULTURAL
}

enum ValuationMethod {
  MARKET_VALUE
  REPLACEMENT_COST
  INCOME_CAPITALIZATION
  AREA_BASED
}

enum PropertyTaxStatus {
  DRAFT
  ASSESSED
  NOTIFIED
  PAID
  OVERDUE
  DISPUTED
  EXEMPT
}

// ── Excise Tax ────────────────────────────────────────────────────────────────
/// Excise Tax — Proclamation No. 1186/2020
model ExciseTaxRecord {
  id                   String          @id @default(uuid())
