/// Standalone Debit Note model — used by /ovds/debit-notes CRUD UI.
/// Agency placement refunds (Workflow A guarantee failure) are created here
/// in addition to the negative-bill approach in MissingFeaturesService.
model DebitNote {
  id               String    @id @default(uuid())
  debitNoteNumber  String    @unique(map: "DebitNote_debitNoteNumber_key") @db.VarChar(100)
  /// FK to the original Bill this debit note is raised against
  billId           String?   @db.VarChar(36)
  billNumber       String?   @db.VarChar(100)
  vendorId         String?   @db.VarChar(36)
  vendorName       String?   @db.VarChar(200)
  debitDate        DateTime  @default(now())
  reason           String?   @db.VarChar(500)
  subtotal         Decimal   @default(0.000000000000000000000000000000)
  taxAmount        Decimal   @default(0.000000000000000000000000000000)
  total            Decimal   @default(0.000000000000000000000000000000)
  notes            String?   @db.Text
  /// DRAFT | ISSUED | APPLIED | VOIDED
  status           String    @default("DRAFT")
  companyId        String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @default(now()) @updatedAt
  company          Company?  @relation(fields: [companyId], references: [id])

  @@index([companyId], map: "DebitNote_companyId_idx")
  @@index([billId],    map: "DebitNote_billId_idx")
  @@index([vendorId],  map: "DebitNote_vendorId_idx")
  @@index([status],    map: "DebitNote_status_idx")
  @@map("debitnote")
}

