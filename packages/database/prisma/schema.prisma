// ═══════════════════════════════════════════════════════════════════════════════
// CYBERSECURITY AUDIT — INSA OF/AEAD/001 compliance checklist for ERP/POS/Invoice
// ═══════════════════════════════════════════════════════════════════════════════

model CyberAudit {
  id              String   @id @default(uuid())
  companyId       String
  title           String   @db.VarChar(200)
  description     String?  @db.Text
  /// SCHEDULED | IN_PROGRESS | COMPLETED | FAILED
  status          String   @default("SCHEDULED") @db.VarChar(20)
  conductedBy     String?  @db.VarChar(100)
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  metrics         CyberAuditMetric[]
  findings        CyberAuditFinding[]

  @@index([companyId])
  @@index([status])
  @@map("cyber_audit")
}

model CyberAuditMetric {
  id              String   @id @default(uuid())
  auditId         String
  areaNumber      String   @db.VarChar(10)
  areaName        String   @db.VarChar(100)
  metricNumber    String   @db.VarChar(10)
  metricName      String   @db.VarChar(200)
  requirement     String   @db.Text
  explanation     String?  @db.Text
  /// COMPLIANT | NON_COMPLIANT | NOT_APPLICABLE | PARTIAL
  status          String   @default("PENDING") @db.VarChar(20)
  evidence        String?  @db.Text
  remarks         String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  audit           CyberAudit @relation(fields: [auditId], references: [id], onDelete: Cascade)

  @@index([auditId])
  @@index([areaNumber])
  @@map("cyber_audit_metric")
}

model CyberAuditFinding {
  id              String   @id @default(uuid())
  auditId         String
  metricId        String?
  /// CRITICAL | HIGH | MEDIUM | LOW | INFO
  severity        String   @db.VarChar(20)
  title           String   @db.VarChar(200)
  description     String   @db.Text
  remediation     String?  @db.Text
  /// OPEN | IN_PROGRESS | RESOLVED | ACCEPTED_RISK
  status          String   @default("OPEN") @db.VarChar(20)
  assignedTo      String?  @db.VarChar(100)
  resolvedAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  audit           CyberAudit @relation(fields: [auditId], references: [id], onDelete: Cascade)

  @@index([auditId])
  @@index([severity])
  @@index([status])
  @@map("cyber_audit_finding")
}

// ═══════════════════════════════════════════════════════════════════════════════
// MASTER COMPLIANCE CHECKLIST — EIRMS pre-rollout compliance verification
// ═══════════════════════════════════════════════════════════════════════════════

model MasterComplianceChecklist {
  id              String   @id @default(uuid())
  companyId       String
  title           String   @db.VarChar(200)
  /// DRAFT | IN_PROGRESS | COMPLETED
  status          String   @default("DRAFT") @db.VarChar(20)
  bspName         String?  @db.VarChar(200)
  bspTin          String?  @db.VarChar(50)
  testingLocation String?  @db.VarChar(200)
  systemType      String?  @db.VarChar(50)
  systemName      String?  @db.VarChar(200)
  hostingType     String?  @db.VarChar(100)
  versionBuild    String?  @db.VarChar(100)
  testedEnv       String?  @db.VarChar(100)
  testDate        DateTime?
  releaseDate     DateTime?
  testerName      String?  @db.VarChar(200)
  testerSignature String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  items           MasterComplianceItem[]

  @@index([companyId])
  @@index([status])
  @@map("master_compliance_checklist")
}

model MasterComplianceItem {
  id              String   @id @default(uuid())
  checklistId     String
  sectionKey      String   @db.VarChar(50)
  itemKey         String   @db.VarChar(50)
  itemText        String   @db.Text
  /// PENDING | PASS | FAIL | NOT_APPLICABLE
  status          String   @default("PENDING") @db.VarChar(20)
  resultData      String?  @db.Text
  remarks         String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  checklist       MasterComplianceChecklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)

  @@index([checklistId])
  @@index([sectionKey])
  @@index([status])
  @@map("master_compliance_item")
}

// ═══════════════════════════════════════════════════════════════════════════════
// ACCREDITATION CHECKLIST — Sales Registration Systems (Directive No. 1142/2026)
// ═══════════════════════════════════════════════════════════════════════════════

model AccreditationChecklist {
  id                    String   @id @default(uuid())
  companyId             String
  title                 String   @db.VarChar(200)
  /// DRAFT | IN_PROGRESS | COMPLETED
  status                String   @default("DRAFT") @db.VarChar(20)
  /// Date of admission
  dateOfAdmission       DateTime?
  /// Date of report
  dateOfReport          DateTime?

  // Section 1: Software Data
  softwareType          String?  @db.VarChar(100)
  softwareName          String?  @db.VarChar(200)
  softwareVersion       String?  @db.VarChar(100)

  // Section 2: Provider / Manufacturer (Applicant)
  providerContactName   String?  @db.VarChar(200)
  providerCompanyName   String?  @db.VarChar(200)
  providerPosition      String?  @db.VarChar(100)
  providerAddress       String?  @db.Text
  providerMobile        String?  @db.VarChar(20)
  providerTelephone     String?  @db.VarChar(20)
  providerFax           String?  @db.VarChar(20)
  providerEmail         String?  @db.VarChar(200)

  // Section 3: Software Owner / Developer
  ownerLegalName        String?  @db.VarChar(200)
  ownerAddress          String?  @db.Text
  ownerCity             String?  @db.VarChar(100)
  ownerCountry          String?  @db.VarChar(100)
  ownerTelephone        String?  @db.VarChar(20)
  ownerContactName      String?  @db.VarChar(200)
  ownerWebEmail         String?  @db.VarChar(200)

  // Section 7: Overall Assessment
  strengths             String?  @db.Text
  nonConformities       String?  @db.Text
  observations          String?  @db.Text
  finalDecision         String?  @db.VarChar(50) /// RECOMMENDED | NOT_RECOMMENDED | WITH_CONDITIONS
  conditionDetails      String?  @db.Text

  // Signatures (JSON array of signature objects)
  signatures            String?  @db.Text

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  company               Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  items                 AccreditationItem[]

  @@index([companyId])
  @@index([status])
  @@map("accreditation_checklist")
}

model AccreditationItem {
  id              String   @id @default(uuid())
  checklistId     String
  sectionKey      String   @db.VarChar(50)
  itemKey         String   @db.VarChar(50)
  itemText        String   @db.Text
  /// PENDING | PASS | FAIL | NOT_APPLICABLE
  status          String   @default("PENDING") @db.VarChar(20)
  comment         String?  @db.Text
  evidence        String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  checklist       AccreditationChecklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)

  @@index([checklistId])
  @@index([sectionKey])
  @@index([status])
  @@map("accreditation_item")
}

// ── V&V (Validation & Verification / TASS) ────────────────────────────────────

/// V&V compliance declaration submitted to MoR ERCA.
/// Proclamation No. 1341/2024 — Regulation No. 570/2025.
model VandvSubmission {
  id                 String   @id @default(uuid())
  companyId          String
  period             String   @db.VarChar(7)   // YYYY-MM
  confirmationNumber String   @unique @db.VarChar(50)
  status             String   @default("SUBMITTED") @db.VarChar(20)
  payload            String?  @db.LongText
  submittedBy        String?  @db.VarChar(100)
  submittedAt        DateTime @default(now())

  @@index([companyId, period])
  @@map("vandv_submission")
}

/// In-progress V&V draft saved while the user fills the compliance form.
model VandvDraft {
  id          String   @id @default(uuid())
  companyId   String
  period      String   @db.VarChar(7)
  values      String?  @db.LongText   // JSON blob
  status      String   @default("DRAFT") @db.VarChar(20)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

   @@index([companyId, period])
   @@map("vandv_draft")
}

// ──────────────────────────────────────────────────────────────────────────────
// DUAL-RUNTIME DEPLOYMENT & OFFLINE LICENSING (Hybrid On-Cloud / On-Premise)
// ──────────────────────────────────────────────────────────────────────────────

/// Deployment topology of the running instance.
/// Injected via DEPLOYMENT_MODE env var by the NestJS Dual-Runtime Bootstrapper.
enum DeploymentMode {
  CLOUD_SAAS
  ON_PREMISE_SINGLE
  ON_PREMISE_MULTI
}

/// Air-gapped license activations stored per company.
model LicenseActivation {
  id          String    @id @default(uuid())
  companyId   String
  licenseKey  String    @db.VarChar(500)
  signature   String    @db.LongText
  expiresAt   DateTime?
  isValid     Boolean   @default(true)
  registeredModules String @db.LongText
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, licenseKey])
  @@index([companyId])
  @@index([expiresAt])
  @@map("license_activation")
}


// ─────────────────────────────────────────────────────────────────────────────┐
// MODULAR VAT DECLARATION ENGINE                                               │
// ─────────────────────────────────────────────────────────────────────────────┘
// VatModuleManifest — global catalogue of country VAT modules installed on
// this OVDS instance.  One row per country module package.
// Populated by the VatDeclarationOrchestrator at bootstrap.
model VatModuleManifest {
  id                  String   @id @default(uuid())
  /// ISO-3166-1 alpha-2, e.g. "ET", "AE", "GB" — unique per instance
  countryCode         String   @unique @db.VarChar(2)
  countryName         String   @db.VarChar(100)
  modulePackageName   String   @db.VarChar(150)
  moduleVersion       String   @db.VarChar(20)
  displayName         String   @db.VarChar(200)
  authorityName       String   @db.VarChar(200)
  authorityAbbrev     String   @db.VarChar(20)
  currency            String   @db.VarChar(3)
  ruleSetVersion      String   @db.VarChar(20)
  /// JSON array of FilingFrequency values
  filingFrequencies   String   @db.VarChar(200)
  /// JSON: VatAuthoritySpec
  authoritySpec       String   @db.LongText
  /// JSON: VatReportTemplate[]
  reportTemplates     String   @db.LongText
  /// JSON: VatFilingFormSpec[]
  filingForms         String   @db.LongText
  isActive            Boolean  @default(true)
  installedAt         DateTime @default(now())
  updatedAt           DateTime @updatedAt

  tenantModules       TenantVatModule[]

  @@index([countryCode])
  @@index([isActive])
  @@map("vat_module_manifest")
}

// TenantVatModule — per-tenant activation record for each VAT country module.
// Many tenants can activate the same country module independently.
model TenantVatModule {
  id           String   @id @default(uuid())
  tenantId     String   @db.VarChar(36)
  /// FK to VatModuleManifest.countryCode
  countryCode  String   @db.VarChar(2)
  isActive     Boolean  @default(true)
  activatedBy  String?  @db.VarChar(100)
  activatedAt  DateTime @default(now())
  deactivatedAt DateTime?
  /// JSON: tenant-specific settings overrides (e.g. filing frequency, TRN)
  settingsJson String?  @db.LongText
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  manifest     VatModuleManifest @relation(fields: [countryCode], references: [countryCode])

  @@unique([tenantId, countryCode])
  @@index([tenantId])
  @@index([countryCode])
  @@index([isActive])
  @@map("tenant_vat_module")
}

// VatFilingRecord — persisted filing records per tenant/period/country.
// Immutable once status=SUBMITTED; amendments create a new record.
model VatFilingRecord {
  id              String   @id @default(uuid())
  tenantId        String   @db.VarChar(36)
  countryCode     String   @db.VarChar(2)
  periodKey       String   @db.VarChar(20)
  /// DRAFT | PENDING_REVIEW | SUBMITTED | ACCEPTED | REJECTED | AMENDED
  status          String   @default("DRAFT") @db.VarChar(30)
  currency        String   @db.VarChar(3)
  outputVat       Decimal  @default(0)
  inputVat        Decimal  @default(0)
  netVatPayable   Decimal  @default(0)
  /// JSON: VatReturnDraft (serialised return lines + formData)
  returnDraftJson String   @db.LongText
  /// JSON: VatComplianceResult from pre-submission validation
  complianceJson  String?  @db.LongText
  submittedAt     DateTime?
  submittedBy     String?  @db.VarChar(100)
  /// Authority acknowledgement number / reference
  ackNumber       String?  @db.VarChar(200)
  ackReceivedAt   DateTime?
  /// JSON: raw authority response payload
  ackPayloadJson  String?  @db.LongText
  dueDate         DateTime?
  amendmentOf     String?  @db.VarChar(36)
  notes           String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([tenantId, countryCode, periodKey, status])
  @@index([tenantId])
  @@index([tenantId, countryCode])
  @@index([tenantId, countryCode, periodKey])
  @@index([status])
  @@index([dueDate])
  @@map("vat_filing_record")
}

// VatFilingEvent — immutable audit trail for every status change on a filing.
model VatFilingEvent {
  id            String   @id @default(uuid())
  filingId      String   @db.VarChar(36)
  tenantId      String   @db.VarChar(36)
  /// CREATED | VALIDATED | SUBMITTED | ACCEPTED | REJECTED | AMENDED | REOPENED
  eventType     String   @db.VarChar(30)
  fromStatus    String?  @db.VarChar(30)
  toStatus      String   @db.VarChar(30)
  actorId       String?  @db.VarChar(100)
  /// JSON: any additional event payload
  payloadJson   String?  @db.LongText
  occurredAt    DateTime @default(now())

  @@index([filingId])
  @@index([tenantId])
  @@index([occurredAt])
  @@map("vat_filing_event")
}

// VatReportArtifact — stores rendered report files (PDF/XLSX/XML) links.
model VatReportArtifact {
  id          String   @id @default(uuid())
  tenantId    String   @db.VarChar(36)
  filingId    String?  @db.VarChar(36)
  countryCode String   @db.VarChar(2)
  periodKey   String   @db.VarChar(20)
  templateId  String   @db.VarChar(100)
  /// PDF | XLSX | XML | JSON | CSV
  format      String   @db.VarChar(10)
  /// Storage URL or relative path
  storageUrl  String   @db.VarChar(500)
  fileSizeBytes Int?
  mimeType    String?  @db.VarChar(100)
  generatedAt DateTime @default(now())
  generatedBy String?  @db.VarChar(100)
  expiresAt   DateTime?

  @@index([tenantId, countryCode, periodKey])
  @@index([filingId])
  @@index([expiresAt])
  @@map("vat_report_artifact")
}
