model IncomeTaxFiling {
  id                  String    @id @default(uuid())
  year                Int
  fiscalYear          Int
  netProfit           Decimal   @default(0.000000000000000000000000000000)
  taxRate             Decimal   @default(30.000000000000000000000000000000)
  taxPayable          Decimal   @default(0.000000000000000000000000000000)
  taxableIncome       Decimal   @default(0.000000000000000000000000000000)
  /// Gross income (turnover) — used for MAT (2.5% × turnover) calculation
  grossIncome         Decimal   @default(0.000000000000000000000000000000)
  paid                Decimal   @default(0.000000000000000000000000000000)
  /// WHT credits applied against BIT balance (Proc. 1395/2025 Art. 94)
  whtCredits          Decimal   @default(0.000000000000000000000000000000)
  /// Quarterly provisional tax payments already remitted (25% × estimated BIT)
  provisionalPaid     Decimal   @default(0.000000000000000000000000000000)
  /// IAS 12 permanent add-backs (non-deductible items: fines, entertainment > threshold)
  permanentAddBacks   Decimal   @default(0.000000000000000000000000000000)
  /// IAS 12 permanent deductions (tax-exempt income: dividends received, grants)
  permanentDeductions Decimal   @default(0.000000000000000000000000000000)
  /// IAS 12 net timing differences (accelerated depreciation, provisions, etc.)
  timingDifferences   Decimal   @default(0.000000000000000000000000000000)
  balanceDue          Decimal   @default(0.000000000000000000000000000000)
  status              String    @default("DRAFT")
  filedAt             DateTime?
  dueDate             DateTime?
  notes               String?   @db.Text
  companyId           String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @default(now()) @updatedAt
  company             Company?  @relation(fields: [companyId], references: [id])

  @@unique([companyId, fiscalYear])
  @@index([companyId], map: "IncomeTaxFiling_companyId_idx")
  @@map("incometaxfiling")
}

/// Turnover Tax (TOT) filing — Category B taxpayers (annual revenue < ETB 2M)
/// Proclamation No. 1395/2025: 2% on goods, 10% on services, due 30th of following month
model TotFiling {
  id             String    @id @default(uuid())
  period         String    @db.VarChar(7)
  goodsAmount    Decimal   @default(0) @db.Decimal(18, 2)
  servicesAmount Decimal   @default(0) @db.Decimal(18, 2)
  totGoods       Decimal   @default(0) @db.Decimal(18, 2)
  totServices    Decimal   @default(0) @db.Decimal(18, 2)
  netPayable     Decimal   @default(0) @db.Decimal(18, 2)
  paid           Decimal   @default(0) @db.Decimal(18, 2)
  status         String    @default("DRAFT") @db.VarChar(30)
  filedAt        DateTime?
  dueDate        DateTime?
  eTaxReference  String?   @db.VarChar(100)
  notes          String?   @db.Text
  companyId      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now()) @updatedAt
  company        Company?  @relation(fields: [companyId], references: [id])

  @@unique([companyId, period])
  @@index([companyId])
  @@map("totfiling")
}

