model JournalEntry {
  id                      String                    @id @default(uuid())
  date                    DateTime                  @default(now())
  period                  String?                   @db.VarChar(7)
  reference               String?
  description             String
  status                  String                    @default("POSTED")
  companyId               String?
  postedBy                String?
  /// Dual-book designation: LOCAL (Ethiopian tax/management book) | IFRS (statutory IFRS book) | CONSOLIDATED (group elimination book).
  /// NULL means the entry applies to both books (the common case for non-adjusting transactions).
  /// Parallel IFRS adjustment entries are linked to their LOCAL counterpart via mirrorEntryId.
  bookType                String?                   @db.VarChar(20)
  /// Links an IFRS adjustment entry back to the original LOCAL/management entry it adjusts.
  /// Enables auditors to reconcile the two-book difference on any given transaction.
  mirrorEntryId           String?                   @db.VarChar(36)
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @default(now()) @updatedAt
  company                 Company?                  @relation(fields: [companyId], references: [id])
  bankTransaction         BankTransaction[]
  interCompanyTransaction InterCompanyTransaction[]
  journalLine             JournalLine[]
  ledgerEntries          LedgerEntry[]
  invoice                 Invoice[]
  bill                    Bill[]
  invoicePayment          InvoicePayment[]
  billPayment             BillPayment[]
  payrollRecord           PayrollRecord[]
  revenues                Revenue[]
  payments                Payment[]
  vendorPayments          VendorPayment[]
  fundTransfers           FundTransfer[]
  fiscalYearClosings      FiscalYear[] @relation("FiscalYearClosing")
  fiscalYearOpenings      FiscalYear[] @relation("FiscalYearOpening")

  @@index([companyId])
  @@index([companyId, date], map: "JournalEntry_companyId_date_idx")
  @@index([companyId, status], map: "JournalEntry_companyId_status_idx")
  @@index([companyId, period], map: "JournalEntry_companyId_period_idx")
  @@index([companyId, bookType], map: "JournalEntry_companyId_bookType_idx")
  @@map("journalentry")
}

