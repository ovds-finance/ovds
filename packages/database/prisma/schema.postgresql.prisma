generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum JournalEntryStatus {
  DRAFT
  POSTED
  REVERSED
  VOIDED
}

enum ModuleCode {
  TAX_COMPLIANCE
  INVOICING
  REPORTING
  AUDIT_TRAIL
  MULTI_CURRENCY
  BANK_RECONCILIATION
  FIXED_ASSETS
  PAYROLL
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  TRIAL
  EXPIRED
}

model Tenant {
  id                String       @id @default(uuid())
  name              String
  subdomain         String       @unique
  status            TenantStatus @default(ACTIVE)
  databaseProvider  String       @default("postgresql")
  databaseUrl       String?
  licenseKey        String?
  licenseExpiresAt  DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  accounts          Account[]
  journalEntries    JournalEntry[]
  journalLines      JournalLine[]
  activeModules     TenantModule[]
  settings          GlobalSetting[]
  bankAccounts      BankAccount[]
  users             User[]

  @@index([subdomain])
  @@index([status])
}

model User {
  id           String   @id @default(uuid())
  email        String
  passwordHash String
  name         String
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  roles        String[] @default(["USER"])
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([tenantId, email])
  @@index([tenantId])
}

model Account {
  id           String       @id @default(uuid())
  code         String
  name         String
  type         AccountType
  parentId     String?
  parent       Account?     @relation("AccountHierarchy", fields: [parentId], references: [id])
  children     Account[]    @relation("AccountHierarchy")
  tenantId     String
  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  currency     String       @default("ETB")
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  journalLines JournalLine[]
  bankAccounts BankAccount[]

  @@unique([tenantId, code])
  @@index([tenantId, type])
  @@index([tenantId, parentId])
}

model JournalEntry {
  id          String              @id @default(uuid())
  entryNumber String
  date        DateTime            @db.Date
  description String
  reference   String?
  status      JournalEntryStatus  @default(DRAFT)
  tenantId    String
  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lines       JournalLine[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  postedAt    DateTime?
  postedBy    String?
  reversedAt  DateTime?
  reversedBy  String?

  @@unique([tenantId, entryNumber])
  @@index([tenantId, date])
  @@index([tenantId, status])
  @@index([tenantId, postedAt])
}

model JournalLine {
  id            String       @id @default(uuid())
  journalEntryId String
  journalEntry  JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  accountId     String
  account       Account      @relation(fields: [accountId], references: [id], onDelete: Restrict)
  tenantId      String
  tenant        Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  debit         Decimal      @default(0) @db.Decimal(19, 4)
  credit        Decimal      @default(0) @db.Decimal(19, 4)
  description   String?
  sortOrder     Int          @default(0)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([tenantId, accountId])
  @@index([journalEntryId])
}

model TenantModule {
  id        String      @id @default(uuid())
  tenantId  String
  tenant    Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  moduleCode ModuleCode
  enabled   Boolean     @default(true)
  config    Json?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([tenantId, moduleCode])
}

model GlobalSetting {
  id        String   @id @default(uuid())
  key       String
  value     Json
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([key, tenantId])
  @@index([tenantId])
}

model TenantRegistry {
  id            String   @id @default(uuid())
  subdomain     String   @unique
  databaseUrl   String
  databaseProvider String
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([subdomain])
  @@index([isActive])
}

model AuditLog {
  id          String   @id @default(uuid())
  tenantId    String
  userId      String?
  action      String
  entityType  String
  entityId    String?
  oldValues   Json?
  newValues   Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([entityType, entityId])
}

model CurrencyRate {
  id        String   @id @default(uuid())
  fromCurrency String
  toCurrency   String
  rate        Decimal @db.Decimal(19, 8)
  date        DateTime @db.Date
  source      String  @default("NBE")
  createdAt   DateTime @default(now())

  @@unique([fromCurrency, toCurrency, date])
  @@index([date])
}

model BankAccount {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  accountId   String
  account     Account  @relation(fields: [accountId], references: [id], onDelete: Restrict)
  bankName    String
  accountNumber String
  branch      String?
  swiftCode   String?
  currency    String   @default("ETB")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId])
  @@index([accountId])
}