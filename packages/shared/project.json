{
  "name": "shared",
  "root": "packages/shared",
  "sourceRoot": "packages/shared/src",
  "projectType": "library",
  "tags": [
    "scope:shared",
    "type:lib"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run build",
        "cwd": "packages/shared"
      },
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "production",
        "^production"
      ],
      "outputs": [
        "{projectRoot}/dist"
      ],
      "cache": true
    },
    "build:clean": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npm run build:clean",
        "cwd": "packages/shared"
      },
      "cache": false
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run typecheck",
        "cwd": "packages/shared"
      },
      "inputs": [
        "default",
        "^production"
      ],
      "cache": true
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run test",
        "cwd": "packages/shared"
      },
      "inputs": [
        "default",
        "^production"
      ],
      "cache": true
    },
    "test:watch": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npm run test:watch",
        "cwd": "packages/shared"
      },
      "cache": false
    }
  }
}

