{
  "name": "dto",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "root": "packages/shared/dto",
  "sourceRoot": "packages/shared/dto/src",
  "projectType": "library",
  "tags": ["scope:shared", "type:lib", "type:dto"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": { "command": "npm run build", "cwd": "packages/shared/dto" },
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"],
      "outputs": ["{projectRoot}/dist"],
      "cache": true
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": { "command": "npm run typecheck", "cwd": "packages/shared/dto" },
      "inputs": ["default", "^production"],
      "cache": true
    }
  }
}
