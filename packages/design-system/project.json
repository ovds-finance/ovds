{
  "name": "design-system",
  "root": "packages/design-system",
  "sourceRoot": "packages/design-system/src",
  "projectType": "library",
  "tags": [
    "scope:shared",
    "type:lib",
    "type:tokens"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run build",
        "cwd": "packages/design-system"
      },
      "inputs": [
        "production"
      ],
      "outputs": [
        "{projectRoot}/dist"
      ],
      "cache": true
    },
    "build:clean": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npm run build:clean",
        "cwd": "packages/design-system"
      },
      "cache": false
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run typecheck",
        "cwd": "packages/design-system"
      },
      "inputs": [
        "default",
        "^production"
      ],
      "cache": true
    }
  }
}

