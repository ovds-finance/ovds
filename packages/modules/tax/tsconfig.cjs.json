{
  "extends": [
    "../../../tsconfig.base.json",
    "../../modules/tsconfig.build-paths.json"
  ],
  "compilerOptions": {
    "composite": false,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noEmit": false,
    "module": "Node16",
    "moduleResolution": "node16",
    "target": "ES2022",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": "./src",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strictPropertyInitialization": false,
    "skipLibCheck": true,
    "noEmitOnError": false,
    "ignoreDeprecations": "5.0"
  },
  "include": [
    "src/index.cjs.ts",
    "src/domain/**/*",
    "src/dto/**/*",
    "src/countries/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "src/**/*.spec.ts",
    "src/**/*.test.ts"
  ]
}
