{
  "name": "modules-auth",
  "root": "packages/modules/auth",
  "sourceRoot": "packages/modules/auth/src",
  "projectType": "library",
  "tags": [
    "type:lib",
    "type:module",
    "domain:auth"
  ],
  "implicitDependencies": [
    "core",
    "shared"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run build",
        "cwd": "packages/modules/auth"
      },
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "production",
        "^production"
      ],
      "outputs": [
        "{projectRoot}/dist"
      ],
      "cache": true
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run typecheck",
        "cwd": "packages/modules/auth"
      },
      "inputs": [
        "default",
        "^production"
      ],
      "cache": true
    }
  }
}

