{
  "name": "@ovds/maintaining-technology",
  "version": "1.0.0",
  "private": true,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "source": "./src/index.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "node ../../../scripts/bin-run.mjs typescript/bin/tsc",
    "build:clean": "node ../../../scripts/bin-run.mjs typescript/bin/tsc --build --clean && node ../../../scripts/bin-run.mjs typescript/bin/tsc",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ovds/core": "*",
    "@ovds/database": "*",
    "@ovds/shared": "*",
    "@tanstack/react-query": "^5.102.8",
    "lucide-react": "^0.473.0",
    "react-hot-toast": "^2.6.0"
  },
  "devDependencies": {
    "vitest": "^3.0.0"
  }
