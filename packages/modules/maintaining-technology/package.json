{
  "name": "@ovds/maintaining-technology",
  "version": "1.0.0",
  "private": true,
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "source": "./src/index.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "node ../../../scripts/bin-run.mjs typescript/bin/tsc",
    "build:clean": "node ../../../scripts/bin-run.mjs typescript/bin/tsc --build --clean && node ../../../scripts/bin-run.mjs typescript/bin/tsc",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ovds/core": "workspace:*",
    "@ovds/database": "workspace:*",
    "@ovds/shared": "workspace:*",
    "@tanstack/react-query": "5.102.4",
    "lucide-react": "0.473.0",
    "react-hot-toast": "2.6.0"
  },
  "devDependencies": {
    "vitest": "^4.1.11"
  }
}
