{
  "name": "design-tokens",
  "root": "packages/design-tokens",
  "sourceRoot": "packages/design-tokens/src",
  "projectType": "library",
  "tags": [
    "scope:shared",
    "type:lib",
    "type:tokens"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node ../../scripts/bin-run.mjs typescript/bin/tsc",
        "cwd": "packages/design-tokens"
      },
      "inputs": [
        "production"
      ],
      "outputs": [
        "{projectRoot}/dist"
      ],
      "cache": true
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node ../../scripts/bin-run.mjs typescript/bin/tsc --noEmit",
        "cwd": "packages/design-tokens"
      },
      "cache": true
    }
  }
}
