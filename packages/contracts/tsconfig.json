{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "rootDir": "./src",
    "outDir": "./dist",
    "moduleResolution": "bundler",
    "incremental": true,
    "tsBuildInfoFile": "./dist/.tsbuildinfo",
    "paths": {
      "@ovds/contracts/prisma-zod": ["./src/prisma-zod/index.ts"],
      "@ovds/dto": ["packages/shared/dto/dist/index.d.ts"],
      "@ovds/shared": ["packages/shared/dist/index.d.ts"],
      "@ovds/core": ["packages/core/dist/index.d.ts"],
      "@ovds/database": ["packages/database/dist/index.d.ts"]
    }
  },
  "include": [
    "src/index.ts",
    "src/router/**/*",
    "src/schemas/**/*",
    "src/pipes/**/*",
    "src/filters/**/*",
    "src/interceptors/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "dist-cjs"
  ]
}
