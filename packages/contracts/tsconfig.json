{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "rootDir": "./src",
    "outDir": "./dist",
    "baseUrl": "./",
    "moduleResolution": "bundler",
    "incremental": true,
    "tsBuildInfoFile": "./dist/.tsbuildinfo"
  },
  "include": [
    "src/index.ts",
    "src/router/**/*",
    "src/schemas/**/*",
    "src/prisma-zod/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "dist-cjs"
  ]
}
