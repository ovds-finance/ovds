{
  "name": "contracts",
  "root": "packages/contracts",
  "projectType": "library",
  "sourceRoot": "packages/contracts/src",
  "tags": [
    "scope:shared",
    "type:lib"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node ../../scripts/bin-run.mjs --max-old-space-size=8192 typescript/bin/tsc && node ../../scripts/bin-run.mjs --max-old-space-size=8192 tsx scripts/build-cjs.ts",
        "cwd": "packages/contracts"
      },
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "production",
        "^production"
      ],
      "outputs": [
        "{projectRoot}/dist",
        "{projectRoot}/dist-cjs"
      ],
      "cache": true
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node ../../scripts/bin-run.mjs --max-old-space-size=4096 typescript/bin/tsc --noEmit",
        "cwd": "packages/contracts"
      },
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "default",
        "^production"
      ],
      "cache": true
    }
  }
}
