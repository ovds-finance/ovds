{
  "name": "banking",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/banking/src",
  "projectType": "library",
  "tags": ["type:lib", "scope:ovds"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "main": "packages/banking/src/index.ts",
        "tsConfig": "packages/banking/tsconfig.json",
        "outputPath": "dist/packages/banking"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p packages/banking/tsconfig.json"
      }
    }
  }
}
