{
  "name": "core",
  "root": "packages/core",
  "sourceRoot": "packages/core/src",
  "projectType": "library",
  "tags": [
    "scope:shared",
    "type:lib",
    "type:core"
  ],
  "implicitDependencies": [],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npm run build",
        "cwd": "packages/core"
      },
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "production",
        "^production"
      ],
      "outputs": [
        "{projectRoot}/dist"
      ],
      "cache": true
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npm run typecheck",
        "cwd": "packages/core"
      },
      "inputs": [
        "default",
        "^production"
      ],
      "cache": true
    }
  }
}
