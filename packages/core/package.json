{
  "name": "@ovds/core",
  "version": "1.0.0",
  "private": true,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "source": "./src/index.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./vat": {
      "source": "./src/vat/index.ts",
      "import": "./dist/vat/index.js",
      "require": "./dist/vat/index.js",
      "default": "./dist/vat/index.js",
      "types": "./dist/vat/index.d.ts"
    },
    "./vat/report": {
      "source": "./src/vat/report/index.ts",
      "import": "./dist/vat/report/index.js",
      "require": "./dist/vat/report/index.js",
      "default": "./dist/vat/report/index.js",
      "types": "./dist/vat/report/index.d.ts"
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "node ../../scripts/bin-run.mjs typescript/bin/tsc",
    "build:clean": "node ../../scripts/bin-run.mjs typescript/bin/tsc --build --clean && node ../../scripts/bin-run.mjs typescript/bin/tsc",
    "typecheck": "tsc --noEmit"
  }
}
