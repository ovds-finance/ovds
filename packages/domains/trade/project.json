{
  "name": "domains-trade",
  "root": "packages/domains/trade",
  "sourceRoot": "packages/domains/trade/src",
  "projectType": "library",
  "tags": [
    "scope:backend",
    "type:lib",
    "type:domain",
    "domain:projects",
    "deprecated:shim"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run build",
        "cwd": "packages/domains/trade"
      },
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "production",
        "^production"
      ],
      "outputs": [
        "{projectRoot}/dist"
      ],
      "cache": true
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run typecheck",
        "cwd": "packages/domains/trade"
      },
      "inputs": [
        "default",
        "^production"
      ],
      "cache": true
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run test",
        "cwd": "packages/domains/trade"
      },
      "inputs": [
        "default",
        "^production"
      ],
      "cache": true
    }
  }
}

