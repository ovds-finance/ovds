{
  "name": "domains-projects",
  "root": "packages/domains/projects",
  "sourceRoot": "packages/domains/projects/src",
  "projectType": "library",
  "tags": [
    "scope:backend",
    "type:lib",
    "type:domain",
    "domain:projects"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run build",
        "cwd": "packages/domains/projects"
      },
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"],
      "outputs": ["{projectRoot}/dist"],
      "cache": true
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run typecheck",
        "cwd": "packages/domains/projects"
      },
      "inputs": ["default", "^production"],
      "cache": true
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run test",
        "cwd": "packages/domains/projects"
      },
      "inputs": ["default", "^production"],
      "cache": true
    }
  }
}

