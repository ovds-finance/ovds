{
  "name": "@ovds/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "OVDS shared UI components — React + Tailwind + Lucide",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "source": "./src/index.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./context": {
      "source": "./src/context/index.ts",
      "import": "./dist/context/index.js",
      "require": "./dist/context/index.js",
      "default": "./dist/context/index.js",
      "types": "./dist/context/index.d.ts"
    },
    "./styles/globals.css": "./src/styles/globals.css",
    "./tailwind.config": "./tailwind.config.js",
    "./tailwind.config.js": "./tailwind.config.js"
  },
  "sideEffects": [
    "./src/styles/globals.css"
  ],
  "scripts": {
    "build": "node ../../scripts/bin-run.mjs typescript/bin/tsc",
    "build:clean": "node ../../scripts/bin-run.mjs typescript/bin/tsc --build --clean && node ../../scripts/bin-run.mjs typescript/bin/tsc",
    "typecheck": "node ../../scripts/bin-run.mjs typescript/bin/tsc --noEmit"
  },
  "peerDependencies": {
    "i18next": "23.16.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.66.0",
    "react-i18next": "13.5.0",
    "react-router-dom": "7.18.2"
  },
  "dependencies": {
    "@ovds/design-system": "workspace:*",
    "@ovds/shared": "workspace:*",
    "@radix-ui/react-accordion": "1.2.20",
    "@radix-ui/react-checkbox": "1.3.11",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-label": "2.1.15",
    "@radix-ui/react-popover": "1.1.23",
    "@radix-ui/react-scroll-area": "1.2.18",
    "@radix-ui/react-select": "2.3.7",
    "@radix-ui/react-separator": "1.1.15",
    "@radix-ui/react-slot": "1.3.3",
    "@radix-ui/react-switch": "1.3.7",
    "@radix-ui/react-tabs": "1.1.21",
    "@radix-ui/react-toast": "1.2.23",
    "@radix-ui/react-tooltip": "1.2.16",
    "@reduxjs/toolkit": "2.12.0",
    "@tanstack/react-query": "5.102.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "d3-array": "3.2.4",
    "d3-color": "3.1.0",
    "d3-ease": "3.0.1",
    "d3-format": "3.1.0",
    "d3-interpolate": "3.0.1",
    "d3-path": "3.1.0",
    "d3-scale": "4.0.2",
    "d3-shape": "3.2.0",
    "d3-time": "3.1.0",
    "d3-time-format": "4.1.0",
    "d3-timer": "3.0.1",
    "d3-voronoi": "1.1.4",
    "decimal.js-light": "2.5.1",
    "es-toolkit": "1.51.0",
    "eventemitter3": "5.0.4",
    "immer": "11.1.18",
    "internmap": "2.0.3",
    "lucide-react": "0.473.0",
    "react-hot-toast": "2.6.0",
    "react-redux": "9.3.0",
    "recharts": "3.10.1",
    "reselect": "5.2.0",
    "tailwind-merge": "3.6.0",
    "tiny-invariant": "1.3.3",
    "use-sync-external-store": "1.6.0"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@types/recharts": "2.0.1",
    "i18next": "23.16.8",
    "react": "19.2.8",
    "react-hook-form": "7.66.0",
    "react-i18next": "13.5.0",
    "tailwindcss": "3.4.19",
    "tailwindcss-animate": "1.0.7",
    "typescript": "5.9.3",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4"
  }
}
