{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "declaration": true,
    "declarationMap": true,
    "removeComments": true,
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "sourceMap": true,
    "rootDir": "./src",
    "outDir": "./dist",
    "incremental": true,
    "tsBuildInfoFile": "./dist/.tsbuildinfo",
    "strictBindCallApply": false,
    "noFallthroughCasesInSwitch": false,
    "ignoreDeprecations": "5.0",
    "paths": {
      "@ovds/shared": ["packages/shared/dist/index.d.ts"],
      "@ovds/design-system": ["packages/design-system/dist/index.d.ts"],
      "@ovds/dto": ["packages/shared/dto/src/index.ts"]
    }
  },
  "references": [
    { "path": "../design-system" },
    { "path": "../shared" },
    { "path": "../shared/dto" }
  ],
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
