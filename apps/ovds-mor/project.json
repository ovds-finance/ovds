{
  "name": "ovds-mor",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/ovds-mor/src",
  "projectType": "application",
  "tags": ["type:app", "scope:mor", "deploy:frontend"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "command": "npx vite build",
        "cwd": "apps/ovds-mor"
      }
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx vite",
        "cwd": "apps/ovds-mor"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p apps/ovds-mor/tsconfig.json"
      }
    }
  }
}
