{
  "name": "portal",
  "root": "apps/portal",
  "sourceRoot": "apps/portal/src",
  "projectType": "application",
  "tags": [
    "scope:frontend",
    "type:app"
  ],
  "targets": {
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node ../../scripts/bin-run.mjs vite/bin/vite",
        "cwd": "apps/portal"
      },
      "cache": false
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run build",
        "cwd": "apps/portal"
      },
      "cache": true
    },
    "preview": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node ../../scripts/bin-run.mjs vite/bin/vite preview",
        "cwd": "apps/portal"
      },
      "cache": false
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node ../../scripts/bin-run.mjs typescript/bin/tsc --noEmit",
        "cwd": "apps/portal"
      },
      "cache": true
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node ../../scripts/bin-run.mjs eslint/bin/eslint . --fix --no-warn-ignored",
        "cwd": "apps/portal"
      },
      "cache": true
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node ../../node_modules/vitest/vitest.mjs run --passWithNoTests",
        "cwd": "apps/portal"
      },
      "cache": true
    }
  }
}

