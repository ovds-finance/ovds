{
  "name": "@ovds/backend",
  "version": "0.1.0",
  "private": true,
  "description": "OVDS backend NestJS application",
  "scripts": {
    "build": "node ../../scripts/bin-run.mjs --max-old-space-size=8192 typescript/bin/tsc -p tsconfig.build.json",
    "typecheck": "node ../../scripts/bin-run.mjs --max-old-space-size=4096 typescript/bin/tsc --noEmit",
    "lint": "node ../../scripts/bin-run.mjs eslint/bin/eslint . --fix --report-unused-disable-directives",
    "dev": "nest start --watch --builder swc",
    "test": "node ../../scripts/bin-run.mjs vitest/vitest.mjs --run --config vitest.config.ts --poolOptions.threads.singleThread=true",
    "test:watch": "node ../../scripts/bin-run.mjs vitest/vitest.mjs --config vitest.config.ts",
    "test:coverage": "node ../../scripts/bin-run.mjs vitest/vitest.mjs --run --coverage --config vitest.config.ts",
    "db:push": "npx prisma db push",
    "db:push:prod": "npx prisma db push",
    "migrate:local": "npx prisma migrate dev",
    "migrate:dev": "npx prisma migrate dev",
    "migrate:prod": "npx prisma migrate deploy",
    "studio": "npx prisma studio",
    "seed": "npx prisma db seed",
    "seed:prod": "npx prisma db seed",
    "seed:demo": "npx prisma db seed"
  },
  "dependencies": {
    "@keyv/redis": "^5.1.6",
    "@nestjs/bullmq": "^11.0.2",
    "@nestjs/cache-manager": "^3.0.1",
    "@nestjs/common": "^11.2.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.1",
    "@nestjs/event-emitter": "^3.0.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.2.1",
    "@nestjs/platform-socket.io": "^11.2.1",
    "@nestjs/schedule": "^6.1.1",
    "@nestjs/swagger": "^11.2.6",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/websockets": "^11.2.1",
    "@orpc/nest": "^1.15.0",
    "@ovds/contracts": "*",
    "@ovds/database": "*",
    "@ovds/dto": "*",
    "@ovds/shared": "*",
    "@prisma/adapter-mariadb": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@types/passport": "^1.0.17",
    "axios": "^1.19.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.1.2",
    "cache-manager": "^6.4.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "helmet": "^8.3.0",
    "ioredis": "^5.6.1",
    "keyv": "^5.6.0",
    "nodemailer": "^8.0.5",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "reflect-metadata": "^0.1.14",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.3",
    "swagger-ui-express": "^5.0.1",
    "@ovds/domains/double-entry": "*",
    "@ovds/domains/infrastructure": "*",
    "@ovds/domains/vat": "*"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@faker-js/faker": "^10.4.0",
    "@nestjs/cli": "^11.0.17",
    "@nestjs/schematics": "^11.0.10",
    "@nestjs/testing": "^11.2.1",
    "@playwright/test": "^1.62.1",
    "@swc/cli": "^0.7.10",
    "@swc/core": "^1.15.32",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "@types/nodemailer": "^8.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/supertest": "^7.2.1",
    "concurrently": "^9.2.1",
    "eslint": "^9.21.0",
    "eslint-config-prettier": "^10.0.2",
    "eslint-plugin-prettier": "^5.2.3",
    "eslint-plugin-security": "^1.0.0",
    "globals": "^16.0.0",
    "prettier": "^3.5.2",
    "supertest": "^6.3.4",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.25.0"
  }
}
