{
  "name": "@ovds/backend",
  "version": "0.1.0",
  "private": true,
  "description": "OVDS backend NestJS application",
  "scripts": {
    "build": "node ../../scripts/bin-run.mjs --max-old-space-size=8192 typescript/bin/tsc -p tsconfig.build.json",
    "typecheck": "node ../../scripts/bin-run.mjs --max-old-space-size=4096 typescript/bin/tsc --noEmit",
    "lint": "node ../../scripts/bin-run.mjs eslint/bin/eslint . --fix --report-unused-disable-directives",
    "dev": "nest start --watch --builder swc",
    "test": "node ../../scripts/bin-run.mjs vitest/vitest.mjs --run --config vitest.config.ts",
    "test:watch": "node ../../scripts/bin-run.mjs vitest/vitest.mjs --config vitest.config.ts",
    "test:coverage": "node ../../scripts/bin-run.mjs vitest/vitest.mjs --run --coverage --config vitest.config.ts",
    "db:push": "npx prisma db push",
    "db:push:prod": "npx prisma db push",
    "migrate:local": "npx prisma migrate dev",
    "migrate:dev": "npx prisma migrate dev",
    "migrate:prod": "npx prisma migrate deploy",
    "studio": "npx prisma studio",
    "seed": "npx prisma db seed",
    "seed:prod": "npx prisma db seed",
    "seed:demo": "npx prisma db seed"
  },
  "dependencies": {
    "@keyv/redis": "5.1.6",
    "@nestjs/axios": "3.1.3",
    "@nestjs/bullmq": "12.0.0",
    "@nestjs/cache-manager": "3.1.3",
    "@nestjs/common": "12.0.2",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "12.0.2",
    "@nestjs/event-emitter": "3.1.0",
    "@nestjs/jwt": "12.0.2",
    "@nestjs/passport": "12.0.0",
    "@nestjs/platform-express": "12.0.2",
    "@nestjs/platform-socket.io": "12.0.2",
    "@nestjs/schedule": "6.1.3",
    "@nestjs/swagger": "12.0.1",
    "@nestjs/throttler": "6.5.0",
    "@nestjs/websockets": "12.0.2",
    "@orpc/nest": "1.15.0",
    "@ovds/contracts": "workspace:*",
    "@ovds/core": "workspace:*",
    "@ovds/database": "workspace:*",
    "@ovds/domains-accounting": "workspace:*",
    "@ovds/domains-double-entry": "workspace:*",
    "@ovds/domains-infrastructure": "workspace:*",
    "@ovds/domains-invoice": "workspace:*",
    "@ovds/domains-vat": "workspace:*",
    "@ovds/dto": "workspace:*",
    "@ovds/modules-tax": "workspace:*",
    "@ovds/shared": "workspace:*",
    "@prisma/adapter-mariadb": "7.10.0",
    "@prisma/client": "7.10.0",
    "@types/passport": "1.0.17",
    "axios": "1.20.0",
    "bcryptjs": "3.0.3",
    "bullmq": "6.2.2",
    "cache-manager": "6.4.3",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.4",
    "cookie-parser": "1.4.7",
    "dotenv": "16.4.7",
    "helmet": "8.3.0",
    "ioredis": "5.11.1",
    "keyv": "5.6.0",
    "nodemailer": "8.0.11",
    "passport": "0.7.0",
