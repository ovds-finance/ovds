{
  "jsc": {
    "target": "es2022",
    "parser": {
      "syntax": "typescript",
      "tsx": false,
      "decorators": true,
      "dynamicImport": true
    },
    "transform": {
      "legacyDecorator": true,
      "decoratorMetadata": true
    },
    "keepClassNames": true,
    "baseUrl": ".",
    "paths": {
      "@common/*": ["src/common/*"],
      "@common/dto/*": ["src/common/dto/*"],
      "@common/interfaces/*": ["src/common/interfaces/*"]
    }
  },
  "module": {
    "type": "commonjs",
    "strictMode": false,
    "lazy": false,
    "noInterop": false
  },
  "sourceMaps": true,
  "minify": false
}
