{
  // Type-check companion for the SWC production build.
  // SWC handles emit (nest build --builder swc); tsc is typecheck-only here.
  // Run via: tsc --noEmit -p tsconfig.build.json
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "incremental": true,
    "tsBuildInfoFile": "./.tsbuildinfo-build"
  },
  "exclude": [
    "node_modules",
    "dist",
    "test",
    "**/*.spec.ts",
    "**/*.test.ts",
    "**/*.e2e-spec.ts",
    "**/*.integration-spec.ts"
  ]
}
