{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2021",
    "lib": ["ES2021"],
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noImplicitThis": true,
    "alwaysStrict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": false,
    "inlineSourceMap": true,
    "inlineSources": true,
    "strictPropertyInitialization": false,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@ovds/*": ["../../packages/*/src"],
      "@ovds/auth": ["../../packages/shared-domains/infra/src/index.ts"],
      "@ovds/auth/*": ["../../packages/shared-domains/infra/src/*"],
      "@ovds/shared/types/roles": ["../../packages/shared/src/types/roles.ts"],
      "@ovds/shared/types": ["../../packages/shared/src/types/index.ts"],
      "@ovds/shared/types/*": ["../../packages/shared/src/types/*"],
      "@ovds/contracts/router": ["../../packages/contracts/src/router/index.ts"],
      "@ovds/contracts/schemas": ["../../packages/contracts/src/schemas/index.ts"],
      "@ovds/core/vat": ["../../packages/core/src/vat/index.ts"],
      "@ovds/core/vat/report": ["../../packages/core/src/vat/report/index.ts"],
      "@orpc/server": ["../../node_modules/@orpc/server/dist/index.d.ts"],
      "@orpc/contract": ["../../node_modules/@orpc/contract/dist/index.d.ts"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}