{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "declaration": true,
    "declarationMap": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "target": "ESNext",
    "lib": ["ESNext", "DOM"],
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "tsBuildInfoFile": "./.tsbuildinfo-dev",
    "paths": {
      "@common/*":        ["src/common/*"],
      "@common/dto/*":    ["src/common/dto/*"],
      "@common/interfaces/*": ["src/common/interfaces/*"],
      "@packages/*":      ["../../packages/*"],
      "@ovds/core":       ["../../packages/core/src/index.ts"],
      "@ovds/core/vat":   ["../../packages/core/src/vat/index.ts"],
      "@ovds/core/vat/report": ["../../packages/core/src/vat/report/index.ts"],
      "@ovds/shared":     ["../../packages/shared/src/index.ts"],
      "@ovds/shared/*":   ["../../packages/shared/src/*"],
      "@ovds/database":   ["../../packages/database/src/index.ts"],
      "@ovds/contracts":  ["../../packages/contracts/src/index.ts"],
      "@ovds/contracts/schemas": ["../../packages/contracts/src/schemas/index.ts"],
      "@ovds/dto":        ["../../packages/shared/dto/src/index.ts"],
      "@ovds/modules/tax": ["../../packages/modules/tax/src/index.ts"],
      "@ovds/modules/tax/countries/ae/ae-vat-module": ["../../packages/modules/tax/src/countries/ae/ae-vat-module.ts"],
      "@ovds/modules/tax/countries/et/et-vat-module": ["../../packages/modules/tax/src/countries/et/et-vat-module.ts"],
      "@ovds/features/tax": ["../../packages/features/tax/src/index.ts"],
      "@ovds/features/accounting": ["../../packages/features/accounting/src/index.ts"],
      "@ovds/domains-infrastructure": ["../../packages/domains/infrastructure/src/index.ts"],
      "@ovds/domains-double-entry": ["../../packages/domains/double-entry/src/index.ts"],
      "@ovds/domains-accounting": ["../../packages/domains/accounting/src/index.ts"],
      "@ovds/domains-invoice": ["../../packages/domains/invoice/src/index.ts"],
      "@ovds/domains-vat": ["../../packages/domains/vat/src/index.ts"]
    },
    "typeRoots": ["../../node_modules/@types"],
    "skipLibCheck": true,
    "strictBindCallApply": false,
    "noFallthroughCasesInSwitch": false,
    "ignoreDeprecations": "5.0"
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "test", "vitest.config.*", "**/*.spec.ts", "**/*.test.ts", "**/*.e2e-spec.ts", "**/*.integration-spec.ts"]
}
