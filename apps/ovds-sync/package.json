{
  "name": "@ovds/ovds-sync",
  "version": "0.1.0",
  "private": true,
  "description": "OVDS offline-sync microservice — processes queued offline transactions for hybrid taxpayers",
  "scripts": {
    "build": "node ../../scripts/bin-run.mjs --max-old-space-size=8192 typescript/bin/tsc -p tsconfig.build.json",
    "typecheck": "node ../../scripts/bin-run.mjs --max-old-space-size=4096 typescript/bin/tsc --noEmit",
    "dev": "node ../../scripts/bin-run.mjs @nestjs/cli/bin/nest start --watch --builder swc",
    "start": "node ../../scripts/bin-run.mjs @nestjs/cli/bin/nest start --builder swc",
    "start:dev": "node ../../scripts/bin-run.mjs @nestjs/cli/bin/nest start --watch --builder swc",
    "start:debug": "node ../../scripts/bin-run.mjs @nestjs/cli/bin/nest start --watch --builder swc --debug --inspect",
    "start:prod": "node dist/main.js"
  },
  "dependencies": {
    "@nestjs/common": "12.0.2",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "12.0.2",
    "@nestjs/event-emitter": "3.1.0",
    "@nestjs/microservices": "12.0.2",
    "@nestjs/platform-express": "12.0.2",
    "@nestjs/schedule": "^6.1.3",
    "@ovds/database": "workspace:*",
    "@ovds/ledger": "workspace:*",
    "@ovds/shared": "workspace:*",
    "@ovds/shared-domains-infra": "workspace:*",
    "@prisma/adapter-mariadb": "7.10.0",
    "@prisma/client": "7.10.0",
    "decimal.js": "10.6.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "^7.8.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1"
  },
  "devDependencies": {
    "@types/node": "^20.10.6",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "typescript": "5.9.3",
    "tsx": "^4.23.12",
    "ts-node": "^10.9.2",
    "eslint": "^9.0.0"
  }
}
