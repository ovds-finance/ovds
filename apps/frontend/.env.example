# ── API URL (optional — defaults to /api proxied by Vite to localhost:3000) ───
# VITE_API_URL=/api

# ── Full backend URL for OAuth browser redirects (window.location.href) ───────
# In dev: Vite proxy only handles fetch/axios, NOT browser navigations.
# Set this to the full backend URL including /api so Google/Microsoft/LinkedIn OAuth redirects work.
# VITE_API_BASE_URL=http://localhost:3000/api

# ── Auth0 SSO (optional — set VITE_AUTH0_ENABLED=false for local dev) ─────────
VITE_AUTH0_ENABLED=false
VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_AUDIENCE=
VITE_AUTH0_CONNECTION=

# ── Request signing (banking transfers — must match backend REQUEST_SIGNING_SECRET) ───
# Managed via System Settings Module → Integrations
# VITE_REQUEST_SIGNING_SECRET=

# Note: Application settings (email, tax, currency, security, AI keys) are now
# managed via the System Settings Module in the OVDS control panel.
