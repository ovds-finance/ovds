{
  "name": "ovds-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node ../../scripts/bin-run.mjs vite/bin/vite build",
    "typecheck": "node ../../scripts/bin-run.mjs --max-old-space-size=8192 typescript/bin/tsc --noEmit",
    "lint": "node ../../scripts/bin-run.mjs eslint/bin/eslint . --fix --report-unused-disable-directives",
    "preview": "node ../../scripts/bin-run.mjs vite/bin/vite preview",
    "test": "node ../../scripts/bin-run.mjs vitest/vitest.mjs --run --config vitest.config.ts",
    "test:watch": "node ../../scripts/bin-run.mjs vitest/vitest.mjs --config vitest.config.ts",
    "test:coverage": "node ../../scripts/bin-run.mjs vitest/vitest.mjs --run --coverage --config vitest.config.ts"
  },
