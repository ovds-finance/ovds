      "@ovds/features/reporting":   ["../../packages/features/reporting/src/index.ts"],
      "@ovds/features/hr":          ["../../packages/features/hr/src/index.ts"],
      "@ovds/features/crm":         ["../../packages/features/crm/src/index.ts"],
      "@ovds/features/dashboard":   ["../../packages/features/dashboard/src/index.ts"],
      "@ovds/features/settings":    ["../../packages/features/settings/src/index.ts"],
      "@ovds/features/auth":        ["../../packages/features/auth/src/index.ts"],
      "@ovds/features/payroll":     ["../../packages/features/payroll/src/index.ts"],
      "@ovds/features/projects":    ["../../packages/features/projects/src/index.ts"],
      "@ovds/features/helpdesk":    ["../../packages/features/helpdesk/src/index.ts"],
      "@ovds/features/loyalty":     ["../../packages/features/loyalty/src/index.ts"],
      "@ovds/features/iot":         ["../../packages/features/iot/src/index.ts"],
      "@ovds/features/device-control": ["../../packages/features/device-control/src/index.ts"],
      "@ovds/features/compliance":  ["../../packages/features/compliance/src/index.ts"],
