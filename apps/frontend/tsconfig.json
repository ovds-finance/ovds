      "@ovds/domains/manufacturing": ["../../packages/domains/manufacturing/src/index.ts"],
      "@ovds/domains/loyalty":      ["../../packages/domains/loyalty/src/index.ts"],
      "@ovds/domains/release":      ["../../packages/domains/release/src/index.ts"],
      "@ovds/domains/onboarding":   ["../../packages/domains/onboarding/src/index.ts"],
