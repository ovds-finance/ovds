    // ── Strictness ────────────────────────────────────────────────────────
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "ignoreDeprecations": "5.0"
  },
  "include": ["src"],
  "references": [{ "path": "./tsconfig.node.json" }]
