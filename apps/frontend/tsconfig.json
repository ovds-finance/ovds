{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "allowSyntheticDefaultImports": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,

    // ── Vite bundler mode ─────────────────────────────────────────────────
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "incremental": true,
    "tsBuildInfoFile": "./dist/.tsbuildinfo-app",
    "jsx": "react-jsx",

    // ── Local path alias ──────────────────────────────────────────────────
    // Workspace aliases (@ovds/*) are inherited from tsconfig.base.json.
    // baseUrl is set to "." (apps/frontend/) so @ resolves to src/.
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@ovds/contracts":            ["../../packages/contracts/src/index.ts"],
      "@ovds/contracts/router":     ["../../packages/contracts/src/router/index.ts"],
      "@ovds/contracts/schemas":    ["../../packages/contracts/src/schemas/index.ts"],
      "@ovds/contracts/prisma-zod": ["../../packages/contracts/src/prisma-zod/index.ts"],
      "@ovds/shared":               ["../../packages/shared/src/index.ts"],
      "@ovds/shared/*":             ["../../packages/shared/src/*"],
      "@ovds/dto":                  ["../../packages/shared/dto/src/index.ts"],
      "@ovds/database":             ["../../packages/database/src/index.ts"],
      "@ovds/ui":                   ["../../packages/ui/src/index.ts"],
      "@ovds/design-system":        ["../../packages/design-system/src/index.ts"],
      "@ovds/core":                 ["../../packages/core/src/index.ts"],
      "@ovds/hr":                   ["../../packages/modules/hr/src/index.ts"],
      "@ovds/ovds":                 ["../../packages/modules/ovds/src/index.ts"],
      "@ovds/domains/infrastructure": ["../../packages/domains/infrastructure/src/index.ts"],
      "@ovds/domains/accounting":   ["../../packages/domains/accounting/src/index.ts"],
      "@ovds/domains/tax":          ["../../packages/domains/tax/src/index.ts"],
      "@ovds/domains/inventory":    ["../../packages/domains/inventory/src/index.ts"],
      "@ovds/domains/sales":        ["../../packages/domains/sales/src/index.ts"],
      "@ovds/domains/purchases":    ["../../packages/domains/purchases/src/index.ts"],
      "@ovds/domains/treasury":     ["../../packages/domains/treasury/src/index.ts"],
      "@ovds/domains/reporting":    ["../../packages/domains/reporting/src/index.ts"],
      "@ovds/domains/crm":          ["../../packages/domains/crm/src/index.ts"],
      "@ovds/domains/compliance":   ["../../packages/domains/compliance/src/index.ts"],
      "@ovds/domains/iot":          ["../../packages/domains/iot/src/index.ts"],
      "@ovds/domains/workflow":     ["../../packages/domains/workflow/src/index.ts"],
      "@ovds/domains/monetization": ["../../packages/domains/monetization/src/index.ts"],
      "@ovds/domains/device-control": ["../../packages/domains/device-control/src/index.ts"],
      "@ovds/domains/offline-sync": ["../../packages/domains/offline-sync/src/index.ts"],
