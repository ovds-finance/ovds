      "@ovds/features/double-entry":["../../packages/features/double-entry/src/index.ts"],
      "@ovds/features/invoice":     ["../../packages/features/invoice/src/index.ts"],
      "@ovds/features/sub-ledger":  ["../../packages/features/sub-ledger/src/index.ts"],
      "@ovds/features/currency":    ["../../packages/features/currency/src/index.ts"],
      "@ovds/features/cost-centers":["../../packages/features/cost-centers/src/index.ts"],
      "@ovds/features/general-ledger-compliance": ["../../packages/features/general-ledger-compliance/src/index.ts"],
      "@ovds/features/ifrs":        ["../../packages/features/ifrs/src/index.ts"],
      "@ovds/features/expense-claims": ["../../packages/features/expense-claims/src/index.ts"],
      "@ovds/features/fiscal":      ["../../packages/features/fiscal/src/index.ts"],
      "@ovds/features/custom-fields":["../../packages/features/custom-fields/src/index.ts"],
      "@ovds/features/workflow":    ["../../packages/features/workflow/src/index.ts"],
      "@ovds/features/monetization":["../../packages/features/monetization/src/index.ts"],
      "@ovds/features/security-evaluator": ["../../packages/features/security-evaluator/src/index.ts"],
