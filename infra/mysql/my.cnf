# infra/mysql/my.cnf
# MySQL 8.4 performance tuning for OVDS at 12M+ users.
# Mount this at /etc/mysql/conf.d/my.cnf inside the MySQL container.
#
# Sizing assumes a dedicated 8-core / 16GB RAM DB server.
# Adjust innodb_buffer_pool_size to ~70% of available RAM.

[mysqld]

# ── InnoDB Buffer Pool ───────────────────────────────────────────────────────
# Most important setting: caches frequently accessed data pages in RAM.
# Rule: 70% of available RAM on a dedicated DB server.
innodb_buffer_pool_size         = 10G
innodb_buffer_pool_instances    = 8      # 1 per GB, up to 8; reduces contention

# ── InnoDB I/O ────────────────────────────────────────────────────────────────
innodb_flush_log_at_trx_commit  = 2      # Flush once per second (vs every commit)
                                         # Risk: up to 1s of committed txn data on crash
                                         # Trade-off: ~3x write throughput gain
innodb_io_capacity              = 2000   # IOPS available to InnoDB background I/O
innodb_io_capacity_max          = 4000
innodb_read_io_threads          = 8
innodb_write_io_threads         = 8
innodb_flush_method             = O_DIRECT  # Bypass OS page cache (avoid double-buffering)

# ── Redo / Binary Logs ────────────────────────────────────────────────────────
innodb_log_file_size            = 1G     # Larger redo log → fewer checkpoints → better write perf
sync_binlog                     = 0      # Do not fsync binlog on every commit (dangerous, use with replica)

# ── Connection handling ───────────────────────────────────────────────────────
max_connections                 = 500    # Total connections from all backend instances + tools
thread_cache_size               = 100    # Reuse threads; avoids spawn overhead under bursty load
wait_timeout                    = 60     # Drop idle connections after 60s (matches app pool idleTimeout)
interactive_timeout             = 60

# ── Query cache (MySQL 8.x removed it — use Redis instead) ────────────────────
# query_cache_type = 0   # Off by default in MySQL 8.x

# ── Temp tables (complex GROUP BY / ORDER BY operations) ─────────────────────
tmp_table_size                  = 256M
max_heap_table_size             = 256M

# ── Slow query log (for ongoing performance analysis) ─────────────────────────
slow_query_log                  = 1
slow_query_log_file             = /var/log/mysql/slow.log
long_query_time                 = 1      # Log queries taking > 1s
log_queries_not_using_indexes   = 1      # Flag full-table scans

# ── Character set ─────────────────────────────────────────────────────────────
character-set-server            = utf8mb4
collation-server                = utf8mb4_unicode_ci
