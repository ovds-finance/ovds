{
  "name": "ovds-monorepo",
  "private": true,
  "_ci": "smoke-test: dep-optimization pipeline trigger",
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/shared/*",
    "packages/modules/*",
    "packages/domains/*",
    "packages/features/*"
  ],
  "scripts": {
    "db:generate:zod": "npm run generate:zod -w @ovds/database",
    "build:contracts": "npx nx build contracts",
    "build:libs": "npx nx run-many --target=build --projects=design-system,shared,database,ui,core,hr,ovds,maintaining-technology --parallel=8",
    "build:libs:seq": "npx nx run-many --target=build --projects=design-system,shared,database,ui,core,hr,ovds,maintaining-technology --parallel=1",
    "dev:all": "node scripts/ensure-ports.mjs && node scripts/dev-all.mjs",
    "health": "pwsh -File scripts/quick-health-check.ps1",
    "quick-start": "pwsh -File scripts/quick-start.ps1",
    "dev:frontend": "node_modules\\.bin\\nx.cmd dev frontend",
    "dev:backend": "npm run dev --prefix apps/backend",
    "start:prod": "node apps/backend/dist/main.js",
    "build": "npx nx run-many --target=build --all --parallel=8",
    "build:plesk": "chmod -R +x node_modules/.bin/ 2>/dev/null; npm run build:libs && npm run build -w @ovds/backend && npm run build -w ovds-frontend",
    "build:backend": "npx nx build backend",
    "build:frontend": "npx nx build frontend",
    "build:all": "npx nx run-many --target=build --all --parallel=8",
    "build:apps": "npx nx run-many --target=build --projects=backend,frontend --parallel=2",
    "typecheck": "npx nx run-many --target=typecheck --all --parallel=8",
    "typecheck:libs": "npx nx run-many --target=typecheck --projects=design-system,shared,ui,core,hr,ovds,maintaining-technology --parallel=8",
    "typecheck:apps": "npx nx run-many --target=typecheck --projects=backend,frontend --parallel=2",
    "lint": "npx nx run-many --target=lint --projects=backend,frontend --parallel=2",
    "lint:all": "npx nx run-many --target=lint --all --parallel=8",
    "lint:fix": "npx nx run-many --target=lint --all --parallel=8 --fix",
    "audit": "npm audit --audit-level=moderate",
    "audit:fix": "npm audit fix",
    "audit:check": "npx audit-ci --high",
    "security:sast": "npm run lint --prefix apps/backend && npm run lint --prefix apps/frontend",
    "security:scan-deps": "npm ls --depth=0",
    "test": "npx nx run-many --target=test --projects=backend,frontend,shared --parallel=2",
    "test:backend": "npx nx test backend",
    "test:frontend": "npx nx test frontend",
    "test:shared": "npx nx test shared",
    "test:coverage": "npx nx run-many --target=test:coverage --projects=backend,frontend --parallel=2",
    "test:integration": "npx nx test:integration backend",
    "test:e2e": "npx nx test:e2e backend",
    "test:all": "npx nx run-many --target=test --all",
    "test:ci": "npx nx run-many --target=test --projects=backend,frontend,shared --parallel=2",
    "affected:build": "npx nx affected --target=build",
    "affected:test": "npx nx affected --target=test",
    "affected:lint": "npx nx affected --target=lint",
    "affected:typecheck": "npx nx affected --target=typecheck",
    "check:arch": "node scripts/check-arch.mjs",
    "graph": "npx nx graph",
    "reset": "npx nx reset",
    "db:generate": "npm run generate -w @ovds/database",
    "db:generate:plesk": "npm run generate:plesk -w @ovds/database",
    "db:push": "npm run db:push -w @ovds/database",
    "db:push:prod": "npm run db:push:prod -w @ovds/database",
    "db:migrate": "npm run migrate:local -w @ovds/database",
    "db:migrate:dev": "npm run migrate:dev -w @ovds/database",
    "db:migrate:prod": "npm run migrate:prod -w @ovds/database",
    "db:studio": "npm run studio -w @ovds/database",
    "seed": "npm run seed -w @ovds/database",
    "seed:prod": "npm run seed:prod -w @ovds/database",
    "seed:demo": "npm run seed:demo -w @ovds/database",
    "seed:zap-users": "node scripts/seed-zap-test-users-db.mjs",
    "seed:docs": "node scripts/seed-docs.mjs",
    "seed:docs:dry": "node scripts/seed-docs.mjs --dry-run",
    "seed:docs:json": "node scripts/seed-docs.mjs --json",
    "docs:setup": "npm run db:migrate:dev && node scripts/seed-docs.mjs",
    "docs:extract": "node scripts/extract-module-docs.mjs",
    "docs:extract:dry": "node scripts/extract-module-docs.mjs --dry-run",
    "docs:extract:json": "node scripts/extract-module-docs.mjs --json",
    "docs:full": "npm run docs:setup && node scripts/extract-module-docs.mjs",
    "docs:update": "node scripts/seed-docs.mjs && node scripts/extract-module-docs.mjs",
    "docs:ci": "node scripts/docs-ci.mjs",
    "docs:ci:dry": "node scripts/docs-ci.mjs --dry-run",
    "docs:ci:json": "node scripts/docs-ci.mjs --json",
    "docs:ci:flush": "node scripts/docs-ci.mjs --flush-cache",
    "docs:seed": "node scripts/seed-docs.mjs",
    "docs:schema": "node scripts/generate-schema-docs.mjs",
    "docs:schema:check": "node scripts/generate-schema-docs.mjs --check",
    "docs:health": "node scripts/check-docs-health.mjs",
    "docs:links:fix": "node scripts/fix-docs-links.mjs --apply",
    "deploy": "node scripts/deploy.mjs",
    "predeploy": "node scripts/patch-prisma.mjs",
    "security:check": "node scripts/check-app-readiness.mjs",
    "security:check:config": "bash scripts/check-security-config.sh",
    "security:zap:validate": "node scripts/validate-zap-config.mjs",
    "security:zap:baseline": "powershell -File scripts/zap-baseline.ps1 -TargetUrl http://localhost:3000",
    "security:zap:full": "powershell -File scripts/zap-full-scan.ps1 -TargetUrl http://localhost:3000",
    "security:zap:auth": "powershell -File scripts/zap-authenticated-scan.ps1 -TargetFrontend http://localhost:3000 -TargetBackend http://localhost:3001",
    "security:zap:api": "powershell -File scripts/zap-api-scan.ps1 -ApiDefinition http://localhost:3001/api/openapi.json",
    "security:zap:all": "bash scripts/security-test-runner.sh all",
    "security:zap:seed": "npm run seed:zap-users",
    "security:zap:config": "node scripts/validate-zap-config.mjs",
    "security:zap:manual": "pwsh -File scripts/zap-test-manual-all.ps1",
    "security:zap:manual:auth": "pwsh -File scripts/zap-test-authentication.ps1",
    "security:zap:manual:authz": "pwsh -File scripts/zap-test-authorization.ps1",
    "security:zap:manual:session": "pwsh -File scripts/zap-test-session.ps1",
    "security:zap:manual:input": "pwsh -File scripts/zap-test-input-validation.ps1",
    "security:zap:manual:misc": "pwsh -File scripts/zap-test-misc.ps1",
    "security:zap:manual:ratelimit": "pwsh -File scripts/zap-test-rate-limit.ps1",
    "security:zap:explore": "pwsh -File scripts/zap-explore-helper.ps1",
    "security:zap:retest": "pwsh -File scripts/zap-retest.ps1",
    "security:zap:snapshot": "node scripts/security-status-snapshot.mjs",
    "security:zap:export-findings": "node scripts/zap-export-findings.mjs",
    "security:zap:report-diff": "node scripts/zap-report-diff.mjs",
    "security:zap:openapi-check": "pwsh -File scripts/zap-verify-openapi.ps1",
    "security:policy-check": "pwsh -File scripts/security-policy-check.ps1",
    "security:report": "node scripts/generate-security-report.mjs",
    "security:summary": "bash scripts/security-summary.sh",
    "security:alert": "bash scripts/security-alert.sh",
    "security:scan:secrets": "bash scripts/scan-secrets.sh",
    "security:scan:deps": "bash scripts/check-dependencies.sh",
    "security:dashboard": "bash scripts/generate-dashboard-data.sh",
    "security:test:e2e": "npx nx test:e2e backend --testPathPattern=security",
    "security:test:unit": "npx nx test backend --testPathPattern=security",
    "security:test:all": "npm run security:test:e2e && npm run security:test:unit",
    "optimize": "node scripts/bundle-analyze.mjs --output .reports/bundle && node scripts/size-check.mjs --output .reports/bundle && node scripts/dep-check.mjs --output .reports/deps && node scripts/optimize-report.mjs --output .reports",
    "optimize:bundle": "node scripts/bundle-analyze.mjs --output .reports/bundle",
    "optimize:bundle:strict": "node scripts/bundle-analyze.mjs --output .reports/bundle --fail-on-warn",
    "optimize:size-check": "node scripts/size-check.mjs --output .reports/bundle",
    "optimize:size-check:strict": "node scripts/size-check.mjs --output .reports/bundle --fail-on-warn",
    "optimize:size-baseline": "node scripts/size-check.mjs --update-baseline",
    "optimize:deps": "node scripts/dep-check.mjs --output .reports/deps",
    "optimize:deps:strict": "node scripts/dep-check.mjs --output .reports/deps --fail-on-warn",
    "optimize:deps:fix-ranges": "node scripts/dep-check.mjs --output .reports/deps --fix-ranges",
    "optimize:report": "node scripts/optimize-report.mjs --output .reports",
    "optimize:report:strict": "node scripts/optimize-report.mjs --output .reports --fail-on-warn",
    "optimize:local": "pwsh -File scripts/optimize.ps1",
    "optimize:local:strict": "pwsh -File scripts/optimize.ps1 -FailOnWarn",
    "optimize:local:no-build": "pwsh -File scripts/optimize.ps1 -SkipBuild -SkipKnip",
    "optimize:ci": "node scripts/bundle-analyze.mjs --output .reports/bundle --fail-on-warn && node scripts/size-check.mjs --output .reports/bundle --fail-on-warn && node scripts/dep-check.mjs --output .reports/deps --skip-knip && node scripts/optimize-report.mjs --output .reports"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.2.3",
    "@nx/nest": "23.1.1",
    "@nx/react": "23.1.1",
    "@orpc/client": "1.15.0",
    "@orpc/contract": "1.15.0",
    "@orpc/react-query": "1.15.0",
    "@orpc/server": "1.15.0",
    "@orpc/zod": "1.15.0",
    "@rollup/rollup-win32-x64-msvc": "4.63.1",
    "@types/node": "26.3.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "concurrently": "9.2.4",
    "knip": "5.88.1",
    "nx": "23.1.1",
    "prisma": "7.10.0",
    "react-is": "19.2.8",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.9.3",
    "zod-prisma-types": "3.3.11"
  },
  "overrides": {
    "stringDecoder": "npm:string_decoder@1.3.0",
    "yaml": "^2.8.3",
    "esbuild": "^0.25.0",
    "vitest": "^3.0.0",
    "@vitest/coverage-v8": "^3.0.0",
    "vite": "^6.0.0",
    "i18next-http-backend": "^4.0.0",
    "typescript": "^5.9.3",
    "react-router": "^7.18.0",
    "react-router-dom": "^7.18.0",
    "jest": "30.4.2",
    "jest-runtime": "30.4.2",
    "jest-mock": "30.4.1",
    "ws": "^8.21.0",
    "class-validator": "^0.14.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4"
  },
  "dependencies": {
    "@nestjs/bullmq": "11.0.5",
    "@nestjs/common": "11.2.3",
    "@nestjs/core": "11.2.3",
    "@nestjs/event-emitter": "3.1.0",
    "@nestjs/platform-socket.io": "11.2.3",
    "@nestjs/websockets": "11.2.3",
    "@prisma/adapter-mariadb": "7.10.0",
    "@prisma/client": "7.10.0",
    "bullmq": "6.2.2",
    "core-js": "3.50.0",
    "decimal.js": "10.6.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  }
}
