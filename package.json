{
  "name": "ovds-core",
  "version": "2.0.0",
  "private": true,
  "description": "Enterprise Online VAT Declaration System (OVDS) - Sovereign Multi-Module Stack",
  "license": "UNLICENSED",
  "scripts": {
    "nx": "nx",
    "dev:all": "nx run-many --target=serve --all --parallel=8",
    "serve": "nx run-many --target=serve --all --parallel=4",
    "build": "nx run-many --target=build --all --prod --parallel=2",
    "test": "nx run-many --target=test --all --parallel=3",
    "lint": "nx run-many --target=lint --all",
    "e2e": "nx run-many --target=e2e --all",
    "db:push": "prisma db push --schema=packages/shared/database/prisma/schema.prisma",
    "db:seed": "ts-node packages/shared/database/src/lib/seed/tax-matrix.seed.ts",
    "bundle:audit": "ts-node tools/scripts/check-bundle-budgets.ts"
  },
