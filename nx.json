{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "npmScope": "ovds",
  "affected": {
    "defaultBase": "main"
  },
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "production": ["default", "!{projectRoot}/**/*.spec.ts"],
    "sharedGlobals": []
  },
  "tasksRunnerOptions": {
    "default": {
      "runner": "nx/tasks-runners/default",
      "options": {
        "cacheableOperations": ["build", "lint", "test", "e2e", "typecheck"]
      }
    }
  },
  "targetDefaults": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "budgets": [
          {
            "type": "initial",
            "maximumWarning": "500kb",
            "maximumError": "1mb"
          },
          {
            "type": "anyComponentStyle",
            "maximumWarning": "4kb",
            "maximumError": "10kb"
          }
        ]
      }
    },
    "typecheck": {
      "dependsOn": ["^build"]
    }
  },
  "pluginsConfig": {
    "@nx/eslint-plugin": {
      "compilerOptions": {
        "boundaryRules": [
          {
            "sourceTag": "scope:portal",
            "onlyDependOnpackagesWithTags": ["scope:ui", "scope:shared-utils", "scope:auth"]
          },
          {
            "sourceTag": "scope:authority",
            "onlyDependOnpackagesWithTags": ["scope:ui", "scope:shared-utils", "scope:auth"]
          },
          {
            "sourceTag": "scope:bank",
            "onlyDependOnpackagesWithTags": ["scope:ui", "scope:shared-utils", "scope:auth"]
          },
          {
            "sourceTag": "scope:backend",
            "onlyDependOnpackagesWithTags": ["scope:accounting", "scope:declaration", "scope:integration", "scope:audit-trail", "scope:shared-database", "scope:shared-auth", "scope:shared-metrics"]
          },
          {
            "sourceTag": "scope:shared-database",
            "onlyDependOnpackagesWithTags": ["scope:immutable-schemas"]
          }
        ]
      }
    }
  }
}