# =============================================================================
# Postman variable ↔ OVDS .env mapping (reference, not secrets)
# -----------------------------------------------------------------------------
# Copy this to `.env.postman` and fill in real values, OR sync them from your
# OVDS `.env` (section: EIMS (Electronic Invoice Management System)).
# These map 1:1 to the variables in EimsCoreApiMockEnvironment.postman_environment.json.
# =============================================================================

# --- MoR Core API base URL --------------------------------------------------
mock_url=http://core.mor.gov.et           # OVDS: EIMS_API_URL

# --- Authenticated source credentials (issued by MoR after approval) ---------
clientId=YOUR_CLIENT_ID                  # OVDS: EIMS_CLIENT_ID
clientSecret=YOUR_CLIENT_SECRET          # OVDS: EIMS_CLIENT_SECRET
apiKey=YOUR_API_KEY                      # OVDS: EIMS_API_KEY  (optional, if required)

# --- Bearer token (do NOT define in the environment) ----------------------
# Auto-managed at COLLECTION scope by the login / RefreshToken test scripts
# (pm.collectionVariables.set("token", jwt)). An empty environment variable
# here would shadow the collection-set token and break bearer auth, so it is
# intentionally omitted from EimsCoreApiMockEnvironment.postman_environment.json.

# --- Seller / company details ----------------------------------------------
sellerTin=YOUR_15_DIGIT_TIN              # OVDS: COMPANY_TIN / seller Tin
sellerLegalName=Your Company Legal Name
sellerEmail=contact@yourcompany.et
sellerPhone=+2519XXXXXXXX
sellerRegion=AA
sellerVatNumber=YOUR_VAT_NUMBER
sellerWoreda=YOUR_WOREDA
systemNumber=YOUR_SYSTEM_NUMBER
systemType=DEFAULT
