{
  // Root tsconfig for tsc --build project references.
  // Defines the full build graph so TypeScript can resolve symbol versions
  // in the correct order and detect stale outputs across packages.
  //
  // Build order enforced by references:
  //   design-system  (no deps)
  //       ↓
  //   shared         (depends on design-system)
  //       ↓
  //   dto            (depends on shared)
  //       ↓
  //   ui             (depends on shared + design-system)
  //       ↓
  //   database       (no shared deps, built alongside)
  //       ↓
  //   backend        (depends on shared + database + dto)
  //   frontend       (depends on ui + shared + design-system + dto)
  //
  // Symbol versioning: each package exports SHARED_VERSION / DESIGN_SYSTEM_VERSION
  // via version.ts. The backend calls assertSharedSingleton() at bootstrap to
  // detect if two different builds of @ovds/shared are loaded simultaneously
  // (e.g. dist/ artifact vs live src/ via tsconfig paths).
  //
  // Search-path priorities (highest → lowest):
  //   1. tsconfig path aliases (src/ source for dev; dist d.ts for backend typecheck)
  //   2. node_modules/@ovds/* (dist/ artifacts — used in production containers)
  //   3. Fallback: bare specifier resolution via moduleResolution
  //
  // Usage:
  //   tsc --build                  # incremental build of all packages
  //   tsc --build --force          # full rebuild
  //   tsc --build --clean          # remove all dist/ outputs
  "files": [],
  "references": [
    { "path": "./packages/design-system" },
    { "path": "./packages/core" },
    { "path": "./packages/shared" },
