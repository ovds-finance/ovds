# ── Workspace scope — prevent @ovds packages from being fetched from npm ──────
@ovds:registry=https://registry.npmjs.org/
link-workspace-packages=true

# ── Hoist NestJS peer deps so they are resolvable from dist/ at runtime ───────
public-hoist-pattern[]=*nestjs*
public-hoist-pattern[]=*express*
public-hoist-pattern[]=*fastify*
public-hoist-pattern[]=reflect-metadata
public-hoist-pattern[]=rxjs

# ── Network ───────────────────────────────────────────────────────────────────
# Retry on flaky registries; use offline cache when available.
fetch-retries=3
fetch-retry-mintimeout=5000
fetch-retry-maxtimeout=60000

# ── Note ──────────────────────────────────────────────────────────────────────
# pnpm-specific settings (public-hoist-pattern, link-workspace-packages) have
# been moved to package.json under the "pnpm" key to avoid npm warnings about
# unknown config keys.
