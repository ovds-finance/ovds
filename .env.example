# OVDS Backend Environment Variables
# Copy this file to .env and fill in the values
# DO NOT commit .env to version control

# Database Configuration
PRISMA_DATABASE_URL="mysql://USER:PASSWORD@HOST:PORT/DATABASE"
DB_CONNECTION_LIMIT=5

# Prisma CLI TLS escape hatch — LEAVE UNSET.
# Set to 1 ONLY on a host that terminates HTTPS with a self-signed intercepting
# certificate (e.g. some Plesk servers), where `prisma generate` otherwise fails
# to reach registry/engine endpoints. It disables TLS certificate verification
# for the Prisma child process, removing MITM protection.
# Never set this in CI or on a developer machine.
# PRISMA_ALLOW_INSECURE_TLS=1

# Application Configuration
NODE_ENV=development
PORT=3001
API_PREFIX=api
OVDS_SYSTEM_NAME=OVDS Compliance Framework Engine
OVDS_VERSION=4.2.0-Alpha-Localized
OVDS_BRAND_NAME=OVDS ENTERPRISE
OVDS_STATUS_MESSAGE=System Connection Solidified
OVDS_SYNC_STATUS=Fully Synced to MoR EIMS
ACCESS_DENIED_MESSAGE=Insufficient structural clearance to access this MoR integrated compliance route.

# Frontend Configuration
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000
CORS_DEV_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:3001
VITE_API_URL=/api

# JWT Configuration
# ⚠️  PRODUCTION REQUIREMENT: Generate strong random secrets before deploying.
#     NEVER use the placeholder strings below in any environment.
#     Generate:  openssl rand -hex 32
#     Both secrets must be ≥32 cryptographically random characters.
#     Using weak or default secrets allows token forgery and full account takeover.
JWT_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET_MIN_32_CHARS
JWT_EXPIRY=1d
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_STRONG_RANDOM_SECRET_MIN_32_CHARS
JWT_REFRESH_EXPIRY=7d
# Legacy aliases (kept for backward compatibility)
REFRESH_TOKEN_SECRET=REPLACE_WITH_DIFFERENT_STRONG_RANDOM_SECRET_MIN_32_CHARS
REFRESH_TOKEN_EXPIRY=7d

# Redis Configuration (for BullMQ and caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# Email Configuration
SMTP_HOST=localhost
SMTP_PORT=25
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@ovds.com.et

# File Storage
UPLOAD_MAX_SIZE=10485760
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,application/pdf

# Security Configuration
# ── Error details ────────────────────────────────────────────────────────────
# ⚠️  Set to false in production — true exposes stack traces and internal paths.
SHOW_ERROR_DETAILS=false
IP_BLOCKING_ENABLED=true
# ── Rate limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_TTL=60000
RATE_LIMIT_LIMIT=100
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
# ── IP abuse detection (StatusCodeAbuseGuard) ─────────────────────────────────
# Window in ms within which 404/403 hits are counted per IP.
ABUSE_WINDOW_MS=60000
# Max 404 responses per IP per window before blocking.
ABUSE_404_THRESHOLD=20
# Max 403 responses per IP per window before blocking.
ABUSE_403_THRESHOLD=15
# How long (ms) a blocked IP stays blocked.  Default: 10 minutes.
ABUSE_BLOCK_DURATION_MS=600000
# ── Honeypot ────────────────────────────────────────────────────────────────
# How long (ms) an IP that hit a honeypot endpoint stays blocked.  Default: 24 h.
HONEYPOT_BLOCK_DURATION_MS=86400000
# ── CORS / transport ────────────────────────────────────────────────────────
CORS_MAX_AGE=86400
# HSTS max-age in seconds.  63072000 = 2 years (HSTS preload list minimum).
HSTS_MAX_AGE=63072000
# ── CSP extra origins ────────────────────────────────────────────────────────
# Space-separated extra connect-src origins added to the Content-Security-Policy.
# Use when Firebase, Sentry, or other third-party APIs need fetch/XHR access.
# Example: https://o0.ingest.sentry.io https://fcmregistrations.googleapis.com
CSP_EXTRA_CONNECT_SRC=
# ── CSRF cookie lifetime ─────────────────────────────────────────────────────
# Must be ≤ ACCESS_TOKEN_MAX_AGE (86400000 ms = 24 h).
CSRF_COOKIE_MAX_AGE=86400000

# Third-Party Integrations
CHAPA_API_KEY=
CHAPA_SECRET=
MOBILE_MONEY_API_KEY=
EIMS_API_URL=
EIMS_API_FALLBACK_URL=
EIMS_CLIENT_ID=
EIMS_CLIENT_SECRET=
EIMS_API_KEY=
EIMS_TIN=
EIMS_SYSTEM_NUMBER=
EIMS_SYSTEM_IDENTIFIER=OVDS_ENTERPRISE_SAAS
EIMS_TIMEOUT_MS=30000
EIMS_PROCESSING_MESSAGE=Invoice mapped, audited, and processed by MoR Electronic Invoice Information Management System.
EIMS_DEFAULT_COUNTRY=ETHIOPIA
EIMS_DEFAULT_PAYMENT_MODE=CASH
EIMS_DEFAULT_PAYMENT_TERM=IMMEDIATE
EIMS_DEFAULT_SYSTEM_TYPE=ERP
EIMS_DEFAULT_CURRENCY=ETB
# Trusted MoR/ERCA public certificate (PEM or base64) used to verify the
# RSA-SHA512 signature the MoR returns over `signedInvoice`. Without this, the
# acknowledgement is recorded as unverified rather than silently trusted.
EIMS_MOR_CERTIFICATE=
# When true, an unverifiable MoR receipt (bad or missing signature) is rejected
# instead of being persisted as REGISTERED.
# ⚠️  PRODUCTION REQUIREMENT: Set to true once EIMS_MOR_CERTIFICATE is configured.
#     false = unverified MoR receipts are silently accepted (financial integrity risk).
#     true  = receipts with invalid/missing MoR signatures are rejected.
EIMS_REQUIRE_SIGNATURE_VERIFICATION=true
FAYDA_API_KEY=
TIN_API_KEY=
EKYB_API_KEY=
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Offline Queue
OFFLINE_MAX_QUEUE_SIZE=1000
OFFLINE_MAX_RETRIES=3

# Frontend Configuration
VITE_API_URL=/api
VITE_API_TIMEOUT_MS=10000
VITE_USE_HTTPONLY_TOKEN=false

# Frontend — HTTP retry & resilience
VITE_RETRY_JITTER_MS=500
VITE_RETRY_BASE_DELAY_MS=250
VITE_RETRY_AFTER_FALLBACK_S=5
VITE_MAX_RETRY_COUNT=2
VITE_RATE_LIMIT_TOAST_THROTTLE_MS=15000
VITE_JITTER_CAP_MS=1000
VITE_NETWORK_RETRY_BASE_MS=500
VITE_NETWORK_RETRY_JITTER_MS=250

# Frontend — UI behaviour
VITE_TOAST_DURATION_MS=5000
VITE_QUERY_GC_TIME_MS=600000
VITE_CHUNK_RETRY_KEY=chunk_retry
VITE_CHUNK_RELOAD_TIMEOUT_MS=3000

# Frontend — MoR / ERCA external links
VITE_QR_CODE_SERVICE_URL=https://api.qrserver.com/v1/create-qr-code/
VITE_TELECOM_RECEIPT_BASE_URL=https://transactioninfo.ethiotelecom.et/
VITE_DEFAULT_MAIL_FROM=noreply@ovds.com.et

# Frontend — Request HMAC signing (dev only; leave blank in production)
# Must match backend REQUEST_SIGNING_SECRET when set.
VITE_REQUEST_SIGNING_SECRET=

# Frontend — Auth0 SSO (disabled by default)
VITE_AUTH0_ENABLED=false
VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_AUDIENCE=
VITE_AUTH0_CONNECTION=

# Cloud Sync (if applicable)
SYNC_CLOUD_URL=http://localhost:3001

# License Configuration
LICENSE_KEY=
LICENSE_SECRET=

# Monitoring and Logging
LOG_LEVEL=info
SENTRY_DSN=
DATADOG_API_KEY=

# Backup Configuration
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30

# Feature Flags
REDIS_ENABLED=false
RUN_HEALTH_CHECKS_ON_BOOT=false
# ⚠️  PRODUCTION REQUIREMENT: Set ENABLE_SWAGGER=false in production.
#     true = Swagger UI at /api/openapi is publicly accessible (API reconnaissance risk).
ENABLE_SWAGGER=false
EIMS_SANDBOX=true

# ─── Notification Infrastructure ────────────────────────────────────────────

# Twilio — WhatsApp (template-based) + SMS
# Get from https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_SMS_FROM=

# Firebase Cloud Messaging (web push)
# Create a service account at https://console.firebase.google.com → Project Settings → Service Accounts
# Paste the entire JSON as a single-line string (escape inner quotes)
FIREBASE_SERVICE_ACCOUNT_JSON=

# Retention — read notifications older than this many days are deleted nightly
NOTIFICATION_RETENTION_DAYS=90

# Frontend — Firebase Web Push
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# VAPID key from Firebase Console → Project Settings → Cloud Messaging → Web Push certificates
VITE_FIREBASE_VAPID_KEY=
