{
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["../apps/frontend/src/*"],
      "@ovds/dto": ["../packages/shared/dto/src/index.ts"],
      "@ovds/shared": ["../packages/shared/src/index.ts"],
      "@ovds/shared/*": ["../packages/shared/src/*"],
      "@ovds/database": ["../packages/database/src/index.ts"],
      "@ovds/ledger": ["../packages/ledger/src/index.ts"],
      "@ovds/banking": ["../packages/banking/src/index.ts"]
    }
  },
  "include": [
    "../apps/frontend/src/components/LedgerForm.tsx",
    "../packages/shared/dto/src/ovds/ledger.dto.ts",
    "../packages/shared/dto/src/ovds/index.ts",
    "../packages/shared/dto/src/index.ts"
  ]
}
